# hypcheck workspace configuration. Sourced by the shell scripts, parsed by scripts/hcconf.py.
# Plain KEY=VALUE lines only (no spaces around '='; only a leading ~ in paths is expanded).
# Name of the analysed library (used in docs and the memory slice name).
HC_NAME=mathlib-logic-basic
# Lake project root of the analysed library (read-only for this work). Set it to your checkout of
# Mathlib commit bbff2954fe5, built; then run scripts/hclean --refresh.
HC_LIBDIR=/path/to/mathlib4
# Root module(s) to import in tools, hand files and checks, comma-separated (e.g. Cslib or Mathlib).
# mathlib-logic-basic (2026-11-14, as mathlib-data): slim imports HCImportsM = all Mathlib.Data + Mathlib.Logic + Mathlib.Basic
# (+ Analysis.Real.Cardinality, Topology.Sets.Closeds), built in tools/hcrepair from runs/hcimports/; HC_ROOT=Mathlib for the final pass.
HC_ROOT=HCImportsM
# Module prefixes in scope, comma-separated (e.g. Mathlib.Order,Mathlib.Data.Nat). Rows outside are dropped.
HC_MODULES=Mathlib.Logic,Mathlib.Basic
# systemd slice shared by all agent/check Lean calls; the main session caps it.
HC_SLICE=hc-mathlib-logic-basic.slice
# Kit commit this workspace was created from (in the tool's development repository, which is not public).
HC_KIT=a5c4a7e
