import Lean

/-!
Hand pass `IOrdLemmas` (hand13): 107 hypotheses of the `partial_fixpoint` monotonicity lemmas in
`Init.Internal.Order.Lemmas` (`Lean.Order.{Functor,Seq,SeqLeft,SeqRight,Option,List,Array}.monotone_*`),
`Init.Internal.Order.MonadTail` and `Init.Internal.Order.While`.

107 necessary, 0 removable, 0 independent.

Reusable models (all in namespace `IOrdLemmasHand`; every model is a counting writer monad, values
`⟨n, v⟩`, `bind` adds counts):
* `W k` (lawful `Monad`, `pure` counts `0`); the tag `k` selects the order:
  * `W 0` (NW): `x = y ∨ (x.n = 0 ∧ y.n = 1 ∧ x.v = y.v)`, not `MonoBind`: two binds of a monotone
    `f x = ⟨x.n, c⟩` give counts `0` and `2`, which are unrelated (`NW.not_rel`, `NW.tick_mono`, `NW.lohi`);
  * `W 1` (SW): as `W 0`, but `0 ⊑ 1` only on a subsingleton value type; breaks `MonoBind` already with a
    single bind into a non-subsingleton type (`some <$> _`, `Array.set`; `SW.not_rel`, `SW.tick_mono`);
  * `W 2` (G): `x.v = y.v ∧ x.n ≤ y.n`, lawful and `MonoBind`; `f x = ⟨1 - x.n, c⟩` is not monotone
    (`G.not_rel`, `G.lohi`).
* `B`: the order of `G` and its `bind` (`MonoBind`), but `<$>`, `<*>`, `<*`, `*>` replace the count `c`
  by `1 - c` (not `LawfulMonad`; `B.not_rel`, `B.lohi`).
* `OC`: `Option (Nat × α)` with flat order (`none` least), a `MonadTail`, whose `pure` counts `1`
  (violates `pure_bind`).
* `Option` with the library's flat order / `MonadTail` instance and `flat_not_rel`.

Each `MonoBind` row is refuted with `W 0` (several calls of `f`) or `W 1` (one call), each `hmono` row
with `W 2`, each `LawfulMonad` row with `B` (or `OC` for `Loop.forIn_eq_of_monadTail`, via the
lawfulness-free unfolding `repeatM.Internal.eq_of_monadTail`), each dependent bound (`i ≤ as.size`, ...)
with an empty collection, each dependent `Nonempty β` with `β = Empty` and `m = Option`.
The `W`-model declarations for the list/array lemmas are generated by
`runs/hand13/scratch_IOrdLemmas/gen.py`.
-/

set_option linter.unusedVariables false

open Lean Meta Elab Term in
/-- `drop% T i`: `T` with its (non-dependent) Prop binder `i` dropped, read off the library. -/
elab "drop% " T:ident i:num : term => do
  let n ← realizeGlobalConstNoOverloadWithInfo T
  let ci ← getConstInfo n
  let us ← ci.levelParams.mapM fun _ => mkFreshLevelMVar
  forallTelescope (ci.type.instantiateLevelParams ci.levelParams us) fun xs body => do
    let x := xs[i.getNat]!
    unless ← isProp (← inferType x) do throwError "binder {i.getNat} of {n} is not a Prop"
    for j in [i.getNat+1:xs.size] do
      if (← inferType xs[j]!).containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    if body.containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    mkForallFVars (xs.eraseIdx! i.getNat) body

open Lean Meta Elab Term in
/-- `indep% T i`: `∀ indep, Hᵢ` for the dependent Prop binder `i` of `T` (all independent binders). -/
elab "indep% " T:ident i:num : term => do
  let n ← realizeGlobalConstNoOverloadWithInfo T
  let ci ← getConstInfo n
  let us ← ci.levelParams.mapM fun _ => mkFreshLevelMVar
  forallTelescope (ci.type.instantiateLevelParams ci.levelParams us) fun xs body => do
    let x := xs[i.getNat]!
    unless ← isProp (← inferType x) do throwError "binder {i.getNat} of {n} is not a Prop"
    let mut dep := #[x]
    for j in [i.getNat+1:xs.size] do
      let t ← inferType xs[j]!
      if dep.any (fun d => t.containsFVar d.fvarId!) then dep := dep.push xs[j]!
    unless dep.size > 1 || body.containsFVar x.fvarId! do
      throwError "binder {i.getNat} of {n} is not dependent"
    mkForallFVars (xs.filter (fun y => !dep.contains y)) (← inferType x)

