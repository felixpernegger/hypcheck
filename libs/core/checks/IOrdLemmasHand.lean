open Lean.Order

namespace IOrdLemmasHand

/-- Counting writer monad (lawful); `k` only tags which order instance is used. -/
structure W (k : Nat) (α : Type u) where
  n : Nat
  v : α

theorem W.ext' {x y : W k α} (h1 : x.n = y.n) (h2 : x.v = y.v) : x = y := by
  cases x; cases y; cases h1; cases h2; rfl

instance : Monad (W k) where
  pure a := ⟨0, a⟩
  bind x f := ⟨x.n + (f x.v).n, (f x.v).v⟩

instance : LawfulMonad (W k) := LawfulMonad.mk' (W k)
  (id_map := fun _ => rfl)
  (pure_bind := fun x f => by show W.mk (0 + (f x).n) (f x).v = f x; rw [Nat.zero_add])
  (bind_assoc := fun x f g => W.ext' (Nat.add_assoc _ _ _) rfl)

/-! `W 0` (NW): order `x = y ∨ (x.n = 0 ∧ y.n = 1 ∧ x.v = y.v)`; not `MonoBind` (bind adds counts). -/
instance : PartialOrder (W 0 α) where
  rel x y := x = y ∨ (x.n = 0 ∧ y.n = 1 ∧ x.v = y.v)
  rel_refl := .inl rfl
  rel_trans := by
    rintro x y z (rfl | ⟨h1, h2, h3⟩) (rfl | ⟨h4, h5, h6⟩)
    · exact .inl rfl
    · exact .inr ⟨h4, h5, h6⟩
    · exact .inr ⟨h1, h2, h3⟩
    · omega
  rel_antisymm := by
    rintro x y (rfl | ⟨h1, h2, h3⟩) (h | ⟨h4, h5, h6⟩)
    · rfl
    · rfl
    · exact h.symm
    · omega

theorem NW.not_rel {x y : W 0 α} (h1 : x.n ≠ y.n) (h2 : y.n ≠ 1) : ¬ x ⊑ y := by
  rintro (h | ⟨_, h, _⟩)
  · exact h1 (congrArg W.n h)
  · exact h2 h

theorem NW.tick_mono (c : β) : ∀ x y : W 0 PUnit, x ⊑ y → (⟨x.n, c⟩ : W 0 β) ⊑ ⟨y.n, c⟩ := by
  rintro x y (rfl | ⟨h1, h2, _⟩)
  · exact .inl rfl
  · exact .inr ⟨h1, h2, rfl⟩

theorem NW.lohi : (⟨0, ⟨⟩⟩ : W 0 PUnit) ⊑ ⟨1, ⟨⟩⟩ := .inr ⟨rfl, rfl, rfl⟩

/-! `W 1` (SW): like `W 0`, but `0 ⊑ 1` only on a subsingleton value type; breaks `MonoBind` already for
a single bind into a larger value type. -/
instance : PartialOrder (W 1 α) where
  rel x y := x = y ∨ (x.n = 0 ∧ y.n = 1 ∧ x.v = y.v ∧ ∀ a b : α, a = b)
  rel_refl := .inl rfl
  rel_trans := by
    rintro x y z (rfl | ⟨h1, h2, h3, h7⟩) (rfl | ⟨h4, h5, h6, h8⟩)
    · exact .inl rfl
    · exact .inr ⟨h4, h5, h6, h8⟩
    · exact .inr ⟨h1, h2, h3, h7⟩
    · omega
  rel_antisymm := by
    rintro x y (rfl | ⟨h1, h2, h3, _⟩) (h | ⟨h4, h5, h6, _⟩)
    · rfl
    · rfl
    · exact h.symm
    · omega

theorem SW.not_rel {x y : W 1 α} (h1 : x.n ≠ y.n) (a b : α) (h2 : a ≠ b) : ¬ x ⊑ y := by
  rintro (h | ⟨_, _, _, h⟩)
  · exact h1 (congrArg W.n h)
  · exact h2 (h a b)

theorem SW.tick_mono (c : PUnit) : ∀ x y : W 1 PUnit, x ⊑ y → (⟨x.n, c⟩ : W 1 PUnit) ⊑ ⟨y.n, c⟩ := by
  rintro x y (rfl | ⟨h1, h2, _⟩)
  · exact .inl rfl
  · exact .inr ⟨h1, h2, rfl, fun _ _ => rfl⟩

theorem SW.lohi : (⟨0, ⟨⟩⟩ : W 1 PUnit) ⊑ ⟨1, ⟨⟩⟩ := .inr ⟨rfl, rfl, rfl, fun _ _ => rfl⟩

/-! `W 2` (G): order `x.v = y.v ∧ x.n ≤ y.n`; lawful and `MonoBind`. -/
instance : PartialOrder (W 2 α) where
  rel x y := x.v = y.v ∧ x.n ≤ y.n
  rel_refl := ⟨rfl, Nat.le_refl _⟩
  rel_trans := fun ⟨h1, h2⟩ ⟨h3, h4⟩ => ⟨h1.trans h3, Nat.le_trans h2 h4⟩
  rel_antisymm := fun ⟨h1, h2⟩ ⟨_, h4⟩ => W.ext' (Nat.le_antisymm h2 h4) h1

instance : MonoBind (W 2) where
  bind_mono_left := by
    rintro _ _ _ _ _ ⟨h1, h2⟩
    exact ⟨by show (_ : W 2 _).v = _; simp only [bind, h1], by show _ + _ ≤ _ + _; rw [h1]; omega⟩
  bind_mono_right := by
    intro _ _ a f₁ f₂ h
    exact ⟨(h a.v).1, Nat.add_le_add_left (h a.v).2 _⟩

theorem G.not_rel {x y : W 2 α} (h : y.n < x.n) : ¬ x ⊑ y := fun ⟨_, h'⟩ => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le h h')

/-- Non-monotone: flips counts `0 ↔ 1`. -/
theorem G.lohi : (⟨0, ⟨⟩⟩ : W 2 PUnit) ⊑ ⟨1, ⟨⟩⟩ := ⟨rfl, by decide⟩

end IOrdLemmasHand

namespace IOrdLemmasHand
open Lean.Order

/-! `B`: counting writer with the order of `G` and the lawful `bind`, so `MonoBind`, but `<$>`, `<*>`,
`<*`, `*>` replace the count `c` by `1 - c` (not `LawfulMonad`). -/
structure B (α : Type u) where
  n : Nat
  v : α

instance : Monad B where
  pure a := ⟨0, a⟩
  bind x f := ⟨x.n + (f x.v).n, (f x.v).v⟩
  map g x := ⟨1 - x.n, g x.v⟩
  seq f x := ⟨1 - (f.n + (x ()).n), f.v (x ()).v⟩
  seqLeft x y := ⟨1 - (x.n + (y ()).n), x.v⟩
  seqRight x y := ⟨1 - (x.n + (y ()).n), (y ()).v⟩

theorem B.ext' {x y : B α} (h1 : x.n = y.n) (h2 : x.v = y.v) : x = y := by
  cases x; cases y; cases h1; cases h2; rfl

instance : PartialOrder (B α) where
  rel x y := x.v = y.v ∧ x.n ≤ y.n
  rel_refl := ⟨rfl, Nat.le_refl _⟩
  rel_trans := fun ⟨h1, h2⟩ ⟨h3, h4⟩ => ⟨h1.trans h3, Nat.le_trans h2 h4⟩
  rel_antisymm := fun ⟨h1, h2⟩ ⟨_, h4⟩ => B.ext' (Nat.le_antisymm h2 h4) h1

instance : MonoBind B where
  bind_mono_left := by
    rintro _ _ _ _ _ ⟨h1, h2⟩
    exact ⟨by show (_ : B _).v = _; simp only [bind, h1], by show _ + _ ≤ _ + _; rw [h1]; omega⟩
  bind_mono_right := by
    intro _ _ a f₁ f₂ h
    exact ⟨(h a.v).1, Nat.add_le_add_left (h a.v).2 _⟩

theorem B.not_rel {x y : B α} (h : y.n < x.n) : ¬ x ⊑ y := fun ⟨_, h'⟩ => Nat.lt_irrefl _ (Nat.lt_of_lt_of_le h h')

theorem B.lohi : (⟨0, ⟨⟩⟩ : B PUnit) ⊑ ⟨1, ⟨⟩⟩ := ⟨rfl, by decide⟩

/-! `OC`: `Option (Nat × α)` counting monad whose `pure` counts `1` (so `pure_bind` fails), with the flat
order (`none` least) of `Option`; it is a `MonadTail`. -/
def OC (α : Type u) := Option (Nat × α)

instance : Monad OC where
  pure a := some (1, a)
  bind x f := match x with
    | none => none
    | some (n, a) => match f a with
      | none => none
      | some (k, b) => some (n + k, b)

instance : MonadTail OC where
  instCCPO β := inferInstanceAs (CCPO (FlatOrder (none : Option (Nat × β))))
  bind_mono_right := by
    intro α β a f₁ f₂ _ h
    match a with
    | none => exact FlatOrder.rel.refl
    | some (n, v) =>
      show FlatOrder.rel (match f₁ v with | none => none | some (k, b) => some (n + k, b))
        (match f₂ v with | none => none | some (k, b) => some (n + k, b))
      have hv : FlatOrder.rel (f₁ v) (f₂ v) := h v
      revert hv
      generalize f₁ v = r₁
      generalize f₂ v = r₂
      intro hv
      cases hv
      · exact FlatOrder.rel.bot
      · exact FlatOrder.rel.refl

theorem flat_not_rel {b x y : α} (h1 : x ≠ b) (h2 : x ≠ y) : ¬ FlatOrder.rel (b := b) x y := by
  intro h; cases h <;> contradiction

/-! ## `Functor`/`Seq`/`SeqLeft`/`SeqRight` -/

-- `Lean.Order.Functor.monotone_map` idx 3 (inst : MonoBind m): SW model; `(fun _ => true) <$> x` maps
-- counts 0 below 1 on `W 1 Unit` to unrelated values in `W 1 Bool` (Bool is not a subsingleton).
theorem Functor_monotone_map.h3 : ¬ drop0% Lean.Order.Functor.monotone_map 3 := fun h => by
  have := h (m := W 1) (f := fun (x : W 1 Unit) => x) (g := fun _ => true) monotone_id _ _ SW.lohi
  exact SW.not_rel (by decide) true false (by decide) this

-- `Lean.Order.Functor.monotone_map` idx 8 (inst : LawfulMonad m): B model, map flips counts.
theorem Functor_monotone_map.h8 : ¬ drop0% Lean.Order.Functor.monotone_map 8 := fun h => by
  have := h (m := B) (f := fun (x : B PUnit) => x) (g := id) monotone_id _ _ B.lohi
  exact B.not_rel (by decide) this

-- `Lean.Order.Functor.monotone_map` idx 11 (hmono): G model, non-monotone f.
theorem Functor_monotone_map.h11 : ¬ drop0% Lean.Order.Functor.monotone_map 11 := fun h => by
  have := h (m := W 2) (f := fun (x : W 2 Unit) => (⟨1 - x.n, ()⟩ : W 2 Unit)) (g := id) _ _ G.lohi
  exact G.not_rel (by decide) this

-- `Lean.Order.Seq.monotone_seq` idx 3 (inst : MonoBind m): NW model, counts 0+0 vs 1+1.
theorem Seq_monotone_seq.h3 : ¬ drop0% Lean.Order.Seq.monotone_seq 3 := fun h => by
  have := h (m := W 0) (g := fun (x : W 0 Unit) => (⟨x.n, fun _ => ()⟩ : W 0 (Unit → Unit)))
    (f := fun (x : W 0 Unit) => (⟨x.n, ()⟩ : W 0 Unit)) (NW.tick_mono _) (NW.tick_mono _) _ _ NW.lohi
  exact NW.not_rel (by decide) (by decide) this

-- `Lean.Order.Seq.monotone_seq` idx 8 (inst : LawfulMonad m): B model, seq flips counts.
theorem Seq_monotone_seq.h8 : ¬ drop0% Lean.Order.Seq.monotone_seq 8 := fun h => by
  have := h (m := B) (g := fun (_ : B PUnit) => (⟨0, fun _ => ⟨⟩⟩ : B (PUnit → PUnit)))
    (f := fun (x : B PUnit) => x) (monotone_const _) monotone_id _ _ B.lohi
