namespace SymMiscHand

/-- Collection whose `getElem?` always fails although every index is valid. -/
structure BNone where mk ::
instance instBNone : GetElem? BNone Nat Bool (fun _ _ => True) where
  getElem _ _ _ := true
  getElem? _ _ := none

/-- Collection whose `getElem?` always succeeds although no index is valid. -/
structure BSome where mk ::
instance instBSome : GetElem? BSome Nat Bool (fun _ _ => False) where
  getElem _ _ h := h.elim
  getElem? _ _ := some true

/-- Collection with lawful `getElem?` but a `getElem!` that disagrees with it. -/
structure BBang where mk ::
instance instBBang : GetElem? BBang Nat Bool (fun _ _ => True) where
  getElem _ _ _ := true
  getElem? _ _ := some true
  getElem! _ _ := false

theorem BNone.not_lawful : ¬ LawfulGetElem BNone Nat Bool (fun _ _ => True) :=
  fun hl => absurd (@LawfulGetElem.getElem?_def _ _ _ _ _ hl ⟨⟩ 0 instDecidableTrue) (by decide)

theorem BSome.not_lawful : ¬ LawfulGetElem BSome Nat Bool (fun _ _ => False) :=
  fun hl => absurd (@LawfulGetElem.getElem?_def _ _ _ _ _ hl ⟨⟩ 0 instDecidableFalse) (by decide)

theorem BBang.getElem?_def (c : BBang) (i : Nat) [Decidable True] :
    c[i]? = if h : True then some (c[i]'h) else none := by
  simp only [dite_true]; rfl

theorem BBang.not_lawful : ¬ LawfulGetElem BBang Nat Bool (fun _ _ => True) :=
  fun hl => absurd (@LawfulGetElem.getElem!_def _ _ _ _ _ hl ⟨false⟩ ⟨⟩ 0) (by decide)

/-- `Bool` with `a == b := a && b`: `true == true`, but not `ReflBEq`. -/
def AB := Bool
instance instBEqAB : BEq AB := ⟨fun a b => a && b⟩

theorem AB.not_refl : ¬ ReflBEq AB :=
  fun h => absurd (@ReflBEq.rfl AB _ h false) (by decide)

/-- `Bool` with the all-true `BEq`. -/
def TB := Bool
instance instBEqTB : BEq TB := ⟨fun _ _ => true⟩
instance instReflBEqTB : ReflBEq TB := ⟨rfl⟩


