def sA : Slice := "a".toSlice
def sB : Slice := "b".toSlice
def sE : Slice := "".toSlice
def sBA : Slice := "ba".toSlice

theorem sA_ne_sB : sA.copy ≠ sB.copy := by decide

/-- Every position of the empty slice is its end position. -/
theorem sE_pos (p : sE.Pos) : p = sE.endPos :=
  Std.le_antisymm (Slice.Pos.le_endPos p)
    (by rw [show sE.endPos = sE.startPos by decide]; exact Slice.Pos.startPos_le p)
theorem sE_eq (p q : sE.Pos) : p = q := (sE_pos p).trans (sE_pos q).symm
theorem sE_le (p q : sE.Pos) : p ≤ q := by rw [sE_eq p q]; exact Std.le_refl _
theorem sE_lt (p q : sE.Pos) : ¬ p < q := by rw [sE_eq p q]; exact Std.lt_irrefl

/-- Every position of the empty string is its end position. -/
theorem E_pos (p : "".Pos) : p = "".endPos :=
  Std.le_antisymm (String.Pos.le_endPos p)
    (by rw [show "".endPos = "".startPos by decide]; exact String.Pos.startPos_le p)
theorem E_eq (p q : "".Pos) : p = q := (E_pos p).trans (E_pos q).symm
theorem E_le (p q : "".Pos) : p ≤ q := by rw [E_eq p q]; exact Std.le_refl _
theorem E_lt (p q : "".Pos) : ¬ p < q := by rw [E_eq p q]; exact Std.lt_irrefl

