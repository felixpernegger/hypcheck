/-! ## Helpers for the verdicts

The `rhs_*` lemmas refute the right-hand side `∃ a', a = succ a' ∧ a' ∈ …` of a `mem_succ_succ_iff`
instance (the left-hand side is decided). `cm_unfold` unfolds a range `forIn'` over `CM` to its first
loop iteration (`extrinsicFix₃_eq_apply`, well-founded since the range iterator is `Finite`).
-/

theorem NJ.rhs_rcc : ¬ ∃ a' : NJ, NJ.pt 4 = succ a' ∧ a' ∈ (NJ.pt 2...=NJ.pt 3) := by
  rintro ⟨a', h1, h2, h3⟩
  revert a'; intro (a' : Nat) h1 h2 h3
  change 2 ≤ a' ∧ (a' = 3 → 2 = 3) at h2
  change a' ≤ 3 ∧ (3 = 3 → a' = 3) at h3
  omega

theorem NJ.rhs_rco : ¬ ∃ a' : NJ, NJ.pt 1 = succ a' ∧ a' ∈ (NJ.pt 0...NJ.pt 3) := by
  rintro ⟨a', h1, h2, h3⟩
  revert a'; intro (a' : Nat) h1 h2 h3
  change a' < 3 ∧ (3 : Nat) ≠ 3 at h3
  omega

theorem NJ.rhs_roc : ¬ ∃ a' : NJ, NJ.pt 4 = succ a' ∧ a' ∈ (NJ.pt 1<...=NJ.pt 3) := by
  rintro ⟨a', h1, h2, h3⟩
  revert a'; intro (a' : Nat) h1 h2 h3
  change 1 < a' ∧ a' ≠ 3 at h2
  change a' ≤ 3 ∧ (3 = 3 → a' = 3) at h3
  omega

theorem NLEg.rhs_roc : ¬ ∃ a' : NLEg, NLEg.pt 2 = succ a' ∧ a' ∈ (NLEg.pt 0<...=NLEg.pt 3) := by
  rintro ⟨a', h1, h2, h3⟩
  revert a'; intro (a' : Nat) h1 h2 h3
  change (2 : Nat) = a' + 1 at h1
  change a' ≤ 3 ∧ ¬(a' = 1 ∧ 3 = 3) at h3
  omega

theorem NLTg.rhs_rco : ¬ ∃ a' : NLTg, NLTg.pt 2 = succ a' ∧ a' ∈ (NLTg.pt 1...NLTg.pt 3) := by
  rintro ⟨a', h1, h2, h3⟩
  revert a'; intro (a' : Nat) h1 h2 h3
  change (2 : Nat) = a' + 1 at h1
  change a' < 3 ∧ ¬(a' = 1 ∧ 3 = 3) at h3
  omega

macro "cm_unfold" : tactic => `(tactic| (
  simp only [ForIn'.forIn', Iter.instForIn', IteratorLoop.finiteForIn', IteratorLoop.forIn,
    Rxc.Iterator.instIteratorLoop, Rxc.Iterator.instIteratorLoop.loop,
    Rxo.Iterator.instIteratorLoop, Rxo.Iterator.instIteratorLoop.loop,
    Rcc.Internal.iter, Rco.Internal.iter, Roc.Internal.iter, Iter.toIterM, UpwardEnumerable.succ?,
    Nat.reduceAdd]
  rw [WellFounded.extrinsicFix₃_eq_apply (InvImage.wf _ IteratorLoop.wellFounded_of_finite)]))


