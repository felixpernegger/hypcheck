def NZ := Nat
def NZ.pt (n : Nat) : NZ := n
instance : DecidableEq NZ := inferInstanceAs (DecidableEq Nat)
instance : UpwardEnumerable NZ := { succ? := fun (n : Nat) => some (n + 1), succMany? := fun k (n : Nat) => some (n + k) }
instance : LE NZ := inferInstanceAs (LE Nat)
instance : DecidableLE NZ := inferInstanceAs (DecidableLE Nat)
instance : LT NZ := inferInstanceAs (LT Nat)
instance : DecidableLT NZ := inferInstanceAs (DecidableLT Nat)
