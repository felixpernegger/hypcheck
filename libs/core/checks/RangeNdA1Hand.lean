namespace RangeNdA1Hand

/-! ## Models

Each model is its own type, so instance search fills the data instances (`UpwardEnumerable`, `LE`,
`LT`, `DecidableLE/LT`, `Rxc/Rxo.HasSize`) and the lawfulness instances the model satisfies. The one
law a model violates gets a `¬` lemma. ✓ = instance, ✗ = `¬` lemma, - = not needed.

| model  | carrier | `LUE` | `LE` | `LT` | `Inf` | `Lin` | `RxcF` | `RxoF` | `Rxc.LHS` | `Rxo.LHS` |
|--------|---------|-------|------|------|-------|-------|--------|--------|-----------|-----------|
| `NLEg` | Nat     | ✓     | ✗    | ✓    | ✓     | ✓     | ✓      | ✓      | -         | -         |
| `NLEs` | Nat     | ✓     | ✗    | ✓    | ✓     | ✓     | ✓      | ✓      | ✓         | ✓         |
| `NLTg` | Nat     | ✓     | ✓    | ✗    | ✓     | ✓     | ✓      | ✓      | -         | ✓         |
| `NLTx` | Nat     | ✓     | ✓    | ✗    | -     | -     | -      | ✓      | -         | -         |
| `NJ`   | Nat     | ✓     | ✓    | ✓    | ✓     | ✗     | ✓      | ✓      | -         | -         |
| `NSw`  | Nat     | ✗     | ✓    | ✓    | ✓     | ✓     | ✓      | ✓      | -         | -         |
| `Q`    | 4 points| ✗     | ✓    | ✓    | -     | -     | ✓      | ✓      | ✓         | ✓         |
| `U0`   | 1 point | ✓     | ✓    | ✓    | ✗     | ✓     | ✓      | ✓      | -         | -         |
| `NZ`   | Nat     | ✓     | ✓    | ✓    | ✓     | ✓     | ✓      | ✓      | ✗         | ✗         |

(`LUE` = `LawfulUpwardEnumerable`, `LE`/`LT` = `LawfulUpwardEnumerableLE/LT`, `Inf`/`Lin` =
`Infinitely/LinearlyUpwardEnumerable`, `RxcF`/`RxoF` = `Rxc/Rxo.IsAlwaysFinite`, `LHS` =
`LawfulHasSize`.)
* `NLEg`: `a ≤ b := a ≤ b ∧ ¬(a = 1 ∧ b = 3)` (one pair removed), so `0...=3` stops after `0`.
* `NLEs`: `a ≤ b := a < b` (strict), so `0...=1` is nonempty by `isEmpty` but has no member.
* `NLTg`: `a < b := a < b ∧ ¬(a = 1 ∧ b = 3)`; `NLTx`: `a < b := a < b ∨ (a = 1 ∧ b = 0)`.
* `NJ`: successor `2 ↦ 4`, otherwise `n ↦ n + 1` (not injective: `succ 2 = succ 3`), with the
  lawful `≤`/`<` of that successor (`3` is reachable only from itself).
* `NSw`: `succMany? k n = n + k` (so Nat's `≤`, `<` are lawful), but `succ?` swaps `0` and `1`.
* `Q`: points `x → y → z → w`, `succMany? 1` is the successor, `succMany? n = none` otherwise
  (also for `n = 0`); `≤` = `<` = "is the successor of".
* `U0`: one point without successor (copied from `checks/RangeDepAHand.lean`).
* `NZ`: Nat with `Rxc/Rxo.HasSize` constantly `0`.
* `CM`: the "monad" `CM α := Nat` with `pure _ := 0` and `bind x _ := x + 1` (not lawful). The
  range loops wrap the body as `return ⟨← f a h c, trivial⟩`, which costs one more `bind` than
  the list/array loop, so `forIn'` over `0...=0` with a body `pure (.done c)` is `2` for the range
  and `1` for its `toList`/`toArray`.
The Nat-based models are `def M := Nat` with explicit `UpwardEnumerable` instances (so `simp` can
unfold `succ?`); points are written `M.pt n`. `range_eval` evaluates `toList` of a concrete range.
-/

/-- Nat with one pair removed from `≤`: `¬ 1 ≤ 3`. -/
def NLEg := Nat
def NLEg.pt (n : Nat) : NLEg := n
instance : DecidableEq NLEg := inferInstanceAs (DecidableEq Nat)
instance : UpwardEnumerable NLEg := { succ? := fun (n : Nat) => some (n + 1), succMany? := fun k (n : Nat) => some (n + k) }
instance : LE NLEg := ⟨fun (a b : Nat) => a ≤ b ∧ ¬(a = 1 ∧ b = 3)⟩
instance : DecidableLE NLEg := fun (a b : Nat) => inferInstanceAs (Decidable (a ≤ b ∧ ¬(a = 1 ∧ b = 3)))
instance : LT NLEg := inferInstanceAs (LT Nat)
instance : DecidableLT NLEg := inferInstanceAs (DecidableLT Nat)
instance : LawfulUpwardEnumerable NLEg := inferInstanceAs (LawfulUpwardEnumerable Nat)
instance : LawfulUpwardEnumerableLT NLEg := inferInstanceAs (LawfulUpwardEnumerableLT Nat)
instance : InfinitelyUpwardEnumerable NLEg := inferInstanceAs (InfinitelyUpwardEnumerable Nat)
instance : LinearlyUpwardEnumerable NLEg := inferInstanceAs (LinearlyUpwardEnumerable Nat)
instance : Rxo.IsAlwaysFinite NLEg := inferInstanceAs (Rxo.IsAlwaysFinite Nat)
instance : Rxc.IsAlwaysFinite NLEg :=
  ⟨fun (i hi : Nat) => ⟨hi + 1, show ¬ (i + (hi + 1) ≤ hi ∧ _) by omega⟩⟩
theorem NLEg.not_LLE : ¬ LawfulUpwardEnumerableLE NLEg := fun h => by
  have := (h.le_iff (1 : Nat) (3 : Nat)).2 ⟨2, rfl⟩
  exact this.2 ⟨rfl, rfl⟩

/-- Nat with a strict `≤`: `a ≤ b := a < b`. -/
def NLEs := Nat
def NLEs.pt (n : Nat) : NLEs := n
instance : DecidableEq NLEs := inferInstanceAs (DecidableEq Nat)
instance : UpwardEnumerable NLEs := { succ? := fun (n : Nat) => some (n + 1), succMany? := fun k (n : Nat) => some (n + k) }
instance : LE NLEs := ⟨fun (a b : Nat) => a < b⟩
instance : DecidableLE NLEs := fun (a b : Nat) => Nat.decLt a b
instance : LT NLEs := inferInstanceAs (LT Nat)
instance : DecidableLT NLEs := inferInstanceAs (DecidableLT Nat)
instance : Rxc.HasSize NLEs := ⟨fun (lo hi : Nat) => hi - lo⟩
instance : Rxo.HasSize NLEs := ⟨fun (lo hi : Nat) => hi - lo⟩
instance : LawfulUpwardEnumerable NLEs := inferInstanceAs (LawfulUpwardEnumerable Nat)
instance : LawfulUpwardEnumerableLT NLEs := inferInstanceAs (LawfulUpwardEnumerableLT Nat)
instance : InfinitelyUpwardEnumerable NLEs := inferInstanceAs (InfinitelyUpwardEnumerable Nat)
instance : LinearlyUpwardEnumerable NLEs := inferInstanceAs (LinearlyUpwardEnumerable Nat)
instance : Rxo.IsAlwaysFinite NLEs := inferInstanceAs (Rxo.IsAlwaysFinite Nat)
instance : Rxc.IsAlwaysFinite NLEs :=
  ⟨fun (i hi : Nat) => ⟨hi + 1, show ¬ (i + (hi + 1) < hi) by omega⟩⟩
instance : Rxc.LawfulHasSize NLEs where
  size_eq_zero_of_not_le (lo hi : Nat) h := show hi - lo = 0 by change ¬ lo < hi at h; omega
  size_eq_one_of_succ?_eq_none _ _ _ h := nomatch h
  size_eq_succ_of_succ?_eq_some (lo hi lo' : Nat) h h' := by
    change lo < hi at h; cases h'; show hi - lo = hi - (lo + 1) + 1; omega
instance : Rxo.LawfulHasSize NLEs where
  size_eq_zero_of_not_le (lo hi : Nat) h := show hi - lo = 0 by change ¬ lo < hi at h; omega
  size_eq_one_of_succ?_eq_none _ _ _ h := nomatch h
  size_eq_succ_of_succ?_eq_some (lo hi lo' : Nat) h h' := by
    change lo < hi at h; cases h'; show hi - lo = hi - (lo + 1) + 1; omega
theorem NLEs.not_LLE : ¬ LawfulUpwardEnumerableLE NLEs := fun h => by
  have := (h.le_iff (0 : Nat) (0 : Nat)).2 ⟨0, rfl⟩
  exact Nat.lt_irrefl 0 this

/-- Nat with one pair removed from `<`: `¬ 1 < 3`. -/
def NLTg := Nat
def NLTg.pt (n : Nat) : NLTg := n
instance : DecidableEq NLTg := inferInstanceAs (DecidableEq Nat)
instance : UpwardEnumerable NLTg := { succ? := fun (n : Nat) => some (n + 1), succMany? := fun k (n : Nat) => some (n + k) }
instance : LE NLTg := inferInstanceAs (LE Nat)
instance : DecidableLE NLTg := inferInstanceAs (DecidableLE Nat)
instance : LT NLTg := ⟨fun (a b : Nat) => a < b ∧ ¬(a = 1 ∧ b = 3)⟩
instance : DecidableLT NLTg := fun (a b : Nat) => inferInstanceAs (Decidable (a < b ∧ ¬(a = 1 ∧ b = 3)))
instance : Rxo.HasSize NLTg :=
  ⟨fun (lo hi : Nat) => if hi = 3 ∧ lo = 1 then 0 else if hi = 3 ∧ lo = 0 then 1 else hi - lo⟩
instance : LawfulUpwardEnumerable NLTg := inferInstanceAs (LawfulUpwardEnumerable Nat)
instance : LawfulUpwardEnumerableLE NLTg := inferInstanceAs (LawfulUpwardEnumerableLE Nat)
instance : InfinitelyUpwardEnumerable NLTg := inferInstanceAs (InfinitelyUpwardEnumerable Nat)
instance : LinearlyUpwardEnumerable NLTg := inferInstanceAs (LinearlyUpwardEnumerable Nat)
instance : Rxc.IsAlwaysFinite NLTg := inferInstanceAs (Rxc.IsAlwaysFinite Nat)
instance : Rxo.IsAlwaysFinite NLTg :=
  ⟨fun (i hi : Nat) => ⟨hi + 1, show ¬ (i + (hi + 1) < hi ∧ _) by omega⟩⟩
instance : Rxo.LawfulHasSize NLTg where
  size_eq_zero_of_not_le (lo hi : Nat) h := by
    change ¬ (lo < hi ∧ ¬(lo = 1 ∧ hi = 3)) at h
    show (if hi = 3 ∧ lo = 1 then 0 else if hi = 3 ∧ lo = 0 then 1 else hi - lo) = 0
    split <;> (try split) <;> omega
  size_eq_one_of_succ?_eq_none _ _ _ h := nomatch h
  size_eq_succ_of_succ?_eq_some (lo hi lo' : Nat) h h' := by
    change lo < hi ∧ ¬(lo = 1 ∧ hi = 3) at h; cases h'
    show (if hi = 3 ∧ lo = 1 then 0 else if hi = 3 ∧ lo = 0 then 1 else hi - lo) =
      (if hi = 3 ∧ lo + 1 = 1 then 0 else if hi = 3 ∧ lo + 1 = 0 then 1 else hi - (lo + 1)) + 1
    split <;> (try split) <;> (try split) <;> (try split) <;> omega
theorem NLTg.not_LLT : ¬ LawfulUpwardEnumerableLT NLTg := fun h => by
  have := (h.lt_iff (1 : Nat) (3 : Nat)).2 ⟨1, rfl⟩
  exact this.2 ⟨rfl, rfl⟩

/-- Nat with one pair added to `<`: `1 < 0`. -/
def NLTx := Nat
def NLTx.pt (n : Nat) : NLTx := n
instance : DecidableEq NLTx := inferInstanceAs (DecidableEq Nat)
instance : UpwardEnumerable NLTx := { succ? := fun (n : Nat) => some (n + 1), succMany? := fun k (n : Nat) => some (n + k) }
instance : LE NLTx := inferInstanceAs (LE Nat)
instance : DecidableLE NLTx := inferInstanceAs (DecidableLE Nat)
instance : LT NLTx := ⟨fun (a b : Nat) => a < b ∨ (a = 1 ∧ b = 0)⟩
instance : DecidableLT NLTx := fun (a b : Nat) => inferInstanceAs (Decidable (a < b ∨ (a = 1 ∧ b = 0)))
instance : LawfulUpwardEnumerable NLTx := inferInstanceAs (LawfulUpwardEnumerable Nat)
instance : LawfulUpwardEnumerableLE NLTx := inferInstanceAs (LawfulUpwardEnumerableLE Nat)
instance : Rxo.IsAlwaysFinite NLTx :=
  ⟨fun (i hi : Nat) => ⟨hi + 2, show ¬ (i + (hi + 2) < hi ∨ _) by omega⟩⟩
theorem NLTx.not_LLT : ¬ LawfulUpwardEnumerableLT NLTx := fun h => by
  obtain ⟨n, hn⟩ := (h.lt_iff (1 : Nat) (0 : Nat)).1 (Or.inr ⟨rfl, rfl⟩)
  change some (1 + (n + 1)) = some 0 at hn; simp at hn

/-- Nat with the non-injective successor `2 ↦ 4` (`n ↦ n + 1` otherwise). -/
def NJ := Nat
def NJ.pt (n : Nat) : NJ := n
instance : DecidableEq NJ := inferInstanceAs (DecidableEq Nat)
def NJ.nx (n : Nat) : NJ := (if n = 2 then 4 else n + 1 : Nat)
def NJ.nxk (k n : Nat) : NJ := (if n ≤ 2 ∧ 2 < n + k then n + k + 1 else n + k : Nat)
instance : UpwardEnumerable NJ := { succ? := fun n => some (NJ.nx n), succMany? := fun k n => some (NJ.nxk k n) }
instance : LE NJ := ⟨fun (a b : Nat) => a ≤ b ∧ (b = 3 → a = 3)⟩
instance : DecidableLE NJ := fun (a b : Nat) => inferInstanceAs (Decidable (a ≤ b ∧ (b = 3 → a = 3)))
instance : LT NJ := ⟨fun (a b : Nat) => a < b ∧ b ≠ 3⟩
instance : DecidableLT NJ := fun (a b : Nat) => inferInstanceAs (Decidable (a < b ∧ b ≠ 3))
instance : LawfulUpwardEnumerable NJ where
  ne_of_lt (a b : Nat) := fun ⟨n, hn⟩ => by
    change some (if a ≤ 2 ∧ 2 < a + (n + 1) then a + (n + 1) + 1 else a + (n + 1)) = some b at hn
    simp only [Option.some.injEq] at hn; show (a : Nat) ≠ b; split at hn <;> omega
  succMany?_zero (a : Nat) := by
    show some (if a ≤ 2 ∧ 2 < a + 0 then a + 0 + 1 else a + 0) = some a
    simp only [Option.some.injEq]; split <;> omega
  succMany?_add_one n (a : Nat) := by
    show some (if a ≤ 2 ∧ 2 < a + (n + 1) then a + (n + 1) + 1 else a + (n + 1)) =
      some (if (if a ≤ 2 ∧ 2 < a + n then a + n + 1 else a + n) = 2 then 4
        else (if a ≤ 2 ∧ 2 < a + n then a + n + 1 else a + n) + 1)
    simp only [Option.some.injEq]; split <;> split <;> split <;> omega
instance : LawfulUpwardEnumerableLE NJ where
  le_iff (a b : Nat) := by
    constructor
    · intro ⟨h1, h2⟩
      refine ⟨if a ≤ 2 ∧ 3 < b then b - a - 1 else b - a, ?_⟩
      show some (if a ≤ 2 ∧ 2 < a + _ then _ else _) = some b
      simp only [Option.some.injEq]; split <;> split <;> omega
    · intro ⟨n, hn⟩
      change some (if a ≤ 2 ∧ 2 < a + n then a + n + 1 else a + n) = some b at hn
      simp only [Option.some.injEq] at hn
      show a ≤ b ∧ (b = 3 → a = 3)
      split at hn <;> omega
instance : LawfulUpwardEnumerableLT NJ where
  lt_iff (a b : Nat) := by
    constructor
    · intro ⟨h1, h2⟩
      refine ⟨if a ≤ 2 ∧ 3 < b then b - a - 2 else b - a - 1, ?_⟩
      show some (if a ≤ 2 ∧ 2 < a + (_ + 1) then _ else _) = some b
      simp only [Option.some.injEq]; split <;> split <;> omega
    · intro ⟨n, hn⟩
      change some (if a ≤ 2 ∧ 2 < a + (n + 1) then a + (n + 1) + 1 else a + (n + 1)) = some b at hn
      simp only [Option.some.injEq] at hn
      show a < b ∧ b ≠ 3
      split at hn <;> omega
instance : InfinitelyUpwardEnumerable NJ := ⟨fun _ => rfl⟩
instance : Rxc.IsAlwaysFinite NJ :=
  ⟨fun (i hi : Nat) => ⟨hi + 1, by
    show ¬ ((if i ≤ 2 ∧ 2 < i + (hi + 1) then i + (hi + 1) + 1 else i + (hi + 1)) ≤ hi ∧ _)
    split <;> omega⟩⟩
instance : Rxo.IsAlwaysFinite NJ :=
  ⟨fun (i hi : Nat) => ⟨hi + 1, by
    show ¬ ((if i ≤ 2 ∧ 2 < i + (hi + 1) then i + (hi + 1) + 1 else i + (hi + 1)) < hi ∧ _)
    split <;> omega⟩⟩
theorem NJ.not_Lin : ¬ LinearlyUpwardEnumerable NJ := fun h => by
  have := h.eq_of_succ?_eq (2 : Nat) (3 : Nat) rfl
  exact absurd (show (2 : Nat) = 3 from this) (by decide)

/-- Nat whose `succ?` swaps `0` and `1`, while `succMany? k n = n + k`. -/
def NSw := Nat
def NSw.pt (n : Nat) : NSw := n
instance : DecidableEq NSw := inferInstanceAs (DecidableEq Nat)
instance : UpwardEnumerable NSw :=
  { succ? := fun (n : Nat) => some ((if n = 0 then 1 else if n = 1 then 0 else n + 1 : Nat)),
    succMany? := fun k (n : Nat) => some (n + k) }
instance : LE NSw := inferInstanceAs (LE Nat)
instance : DecidableLE NSw := inferInstanceAs (DecidableLE Nat)
instance : LT NSw := inferInstanceAs (LT Nat)
instance : DecidableLT NSw := inferInstanceAs (DecidableLT Nat)
instance : LawfulUpwardEnumerableLE NSw where
  le_iff (a b : Nat) := ⟨fun h => by
      change a ≤ b at h; exact ⟨b - a, show some (a + (b - a)) = some b by simp; omega⟩,
    fun ⟨n, hn⟩ => by change some (a + n) = some b at hn; simp at hn; show a ≤ b; omega⟩
instance : LawfulUpwardEnumerableLT NSw where
  lt_iff (a b : Nat) := ⟨fun h => by
      change a < b at h; exact ⟨b - a - 1, show some (a + (b - a - 1 + 1)) = some b by simp; omega⟩,
    fun ⟨n, hn⟩ => by change some (a + (n + 1)) = some b at hn; simp at hn; show a < b; omega⟩
instance : InfinitelyUpwardEnumerable NSw := ⟨fun _ => rfl⟩
instance : LinearlyUpwardEnumerable NSw where
  eq_of_succ?_eq (a b : Nat) h := by
    change some (if a = 0 then 1 else if a = 1 then 0 else a + 1) =
      some (if b = 0 then 1 else if b = 1 then 0 else b + 1) at h
    simp only [Option.some.injEq] at h
    show a = b
    split at h <;> split at h <;> (try split at h) <;> (try split at h) <;> omega
instance : Rxc.IsAlwaysFinite NSw :=
  ⟨fun (i hi : Nat) => ⟨hi + 1, show ¬ (i + (hi + 1) ≤ hi) by omega⟩⟩
instance : Rxo.IsAlwaysFinite NSw :=
  ⟨fun (i hi : Nat) => ⟨hi + 1, show ¬ (i + (hi + 1) < hi) by omega⟩⟩
theorem NSw.not_LUE : ¬ LawfulUpwardEnumerable NSw := fun h => by
  have := h.succMany?_add_one 0 (1 : Nat)
  exact absurd (show some (2 : Nat) = some 0 from this) (by decide)

/-- Four points `x → y → z → w`; only `succMany? 1` is defined. -/
inductive Q | x | y | z | w deriving DecidableEq
def Q.nxt : Q → Option Q
  | .x => some .y | .y => some .z | .z => some .w | .w => none
instance : UpwardEnumerable Q := { succ? := Q.nxt, succMany? := fun n a => if n = 1 then a.nxt else none }
instance : LE Q := ⟨fun a b => a.nxt = some b⟩
instance : DecidableLE Q := fun a b => inferInstanceAs (Decidable (a.nxt = some b))
instance : LT Q := ⟨fun a b => a.nxt = some b⟩
instance : DecidableLT Q := fun a b => inferInstanceAs (Decidable (a.nxt = some b))
instance : Rxc.HasSize Q := ⟨fun a b => if a.nxt = some b then 1 else 0⟩
instance : Rxo.HasSize Q := ⟨fun a b => if a.nxt = some b then 1 else 0⟩
instance : LawfulUpwardEnumerableLE Q where
  le_iff a b := ⟨fun h => ⟨1, h⟩, fun ⟨n, hn⟩ => by
    change (if n = 1 then a.nxt else none) = some b at hn
    split at hn
    · exact hn
    · exact nomatch hn⟩
instance : LawfulUpwardEnumerableLT Q where
  lt_iff a b := ⟨fun h => ⟨0, h⟩, fun ⟨n, hn⟩ => by
    change (if n + 1 = 1 then a.nxt else none) = some b at hn
    split at hn
    · exact hn
    · exact nomatch hn⟩
instance : Rxc.IsAlwaysFinite Q := ⟨fun _ _ => ⟨0, trivial⟩⟩
instance : Rxo.IsAlwaysFinite Q := ⟨fun _ _ => ⟨0, trivial⟩⟩
instance : Rxc.LawfulHasSize Q where
  size_eq_zero_of_not_le a b h := by
    show (if a.nxt = some b then 1 else 0) = 0; rw [ite_eq_right_iff]; exact fun h' => absurd h' h
  size_eq_one_of_succ?_eq_none a b h h' := by
    change a.nxt = some b at h; change a.nxt = none at h'; rw [h] at h'; exact nomatch h'
  size_eq_succ_of_succ?_eq_some a b c h h' := by
    change a.nxt = some b at h; change a.nxt = some c at h'
    rw [h] at h'; cases h'
    show (if a.nxt = some b then 1 else 0) = (if b.nxt = some b then 1 else 0) + 1
    cases a <;> cases b <;> simp_all [Q.nxt]
instance : Rxo.LawfulHasSize Q where
  size_eq_zero_of_not_le a b h := by
    show (if a.nxt = some b then 1 else 0) = 0; rw [ite_eq_right_iff]; exact fun h' => absurd h' h
  size_eq_one_of_succ?_eq_none a b h h' := by
    change a.nxt = some b at h; change a.nxt = none at h'; rw [h] at h'; exact nomatch h'
  size_eq_succ_of_succ?_eq_some a b c h h' := by
    change a.nxt = some b at h; change a.nxt = some c at h'
    rw [h] at h'; cases h'
    show (if a.nxt = some b then 1 else 0) = (if b.nxt = some b then 1 else 0) + 1
    cases a <;> cases b <;> simp_all [Q.nxt]
theorem Q.not_LUE : ¬ LawfulUpwardEnumerable Q := fun h => nomatch h.succMany?_zero .x

/-- `U0`: one point without successor; every law except `InfinitelyUpwardEnumerable`. -/
inductive U0 | pt deriving DecidableEq
instance : UpwardEnumerable U0 :=
  { succ? := fun _ => none, succMany? := fun n a => if n = 0 then some a else none }
instance : LE U0 := ⟨fun _ _ => True⟩
instance : LT U0 := ⟨fun _ _ => False⟩
instance : DecidableLE U0 := fun _ _ => isTrue trivial
instance : DecidableLT U0 := fun _ _ => isFalse id
instance : LawfulUpwardEnumerable U0 where
  ne_of_lt _ _ := fun ⟨_, h⟩ => nomatch h
  succMany?_zero _ := rfl
  succMany?_add_one n a := by cases n <;> rfl
instance : LawfulUpwardEnumerableLE U0 := ⟨fun .pt .pt => ⟨fun _ => ⟨0, rfl⟩, fun _ => trivial⟩⟩
instance : LawfulUpwardEnumerableLT U0 := ⟨fun _ _ => ⟨False.elim, fun ⟨_, h⟩ => nomatch h⟩⟩
instance : Rxc.IsAlwaysFinite U0 := ⟨fun _ _ => ⟨1, trivial⟩⟩
instance : Rxo.IsAlwaysFinite U0 := ⟨fun _ _ => ⟨0, id⟩⟩

