/-- `B7`: one point, `succ?`/`succMany?` constantly `none` (not `LawfulUpwardEnumerable`); `≤`, `<` false
(LawfulUpwardEnumerableLE/LT); Rxc size `0`, Rxi size `1` (both lawful). -/
inductive B7 | pt deriving DecidableEq
instance : UpwardEnumerable B7 := { succ? := fun _ => none, succMany? := fun _ _ => none }
instance : LE B7 := ⟨fun _ _ => False⟩
instance : LT B7 := ⟨fun _ _ => False⟩
instance : LawfulUpwardEnumerableLE B7 := ⟨fun _ _ => ⟨False.elim, fun ⟨_, h⟩ => nomatch h⟩⟩
instance : LawfulUpwardEnumerableLT B7 := ⟨fun _ _ => ⟨False.elim, fun ⟨_, h⟩ => nomatch h⟩⟩
instance : Rxc.HasSize B7 := ⟨fun _ _ => 0⟩
instance : Rxc.LawfulHasSize B7 := ⟨fun _ _ _ => rfl, fun _ _ h _ => h.elim, fun _ _ _ h _ => h.elim⟩
instance : Rxi.HasSize B7 := ⟨fun _ => 1⟩
instance : Rxi.LawfulHasSize B7 := ⟨fun _ _ => rfl, fun _ _ h => nomatch h⟩
theorem B7.not_lawful : ¬ LawfulUpwardEnumerable B7 := fun h => nomatch h.succMany?_zero .pt

/-- `B8`: one point without successors (`LawfulUpwardEnumerable`), `≤` false (not
LawfulUpwardEnumerableLE), `<` false (LawfulUpwardEnumerableLT); Rxc size `0`, Rxi size `1` (lawful). -/
inductive B8 | pt deriving DecidableEq
instance : UpwardEnumerable B8 := { succ? := fun _ => none, succMany? := fun n a => match n with | 0 => some a | _ + 1 => none }
instance : LawfulUpwardEnumerable B8 where
  ne_of_lt _ _ h := match h with | ⟨_, h⟩ => nomatch h
