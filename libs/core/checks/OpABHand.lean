theorem Rxi.Iterator.toArray_eq_match.h2 : ¬ drop0% Std.Rxi.Iterator.toArray_eq_match 2 := fun h =>
  no_descent (fun k => (⟨⟨some k⟩⟩ : Iter (α := Rxi.Iterator Nat) Nat).toArray.toList) fun k => by
    have := congrArg Array.size (h (α := Nat) (it := ⟨⟨some k⟩⟩))
    simp at this; simp [this]; omega


