namespace OpABHand
open Std Std.Iterators Std.Iterators.Types

theorem wf_irrefl {α : Sort u} {r : α → α → Prop} (h : WellFounded r) (a : α) : ¬ r a a := by
  have := h.apply a
  induction this with
  | intro x _ ih => exact fun hx => ih x hx hx

theorem not_finite_of_skip {α β : Type} {m : Type → Type} [Iterator α m β]
    (it : IterM (α := α) m β) (h : it.IsPlausibleStep (.skip it)) : ¬ Finite α m :=
  fun hf => wf_irrefl hf.wf it ⟨_, rfl, h⟩

theorem not_productive_of_skip {α β : Type} {m : Type → Type} [Iterator α m β]
    (it : IterM (α := α) m β) (h : it.IsPlausibleStep (.skip it)) : ¬ Productive α m :=
  fun hp => wf_irrefl hp.wf it h

/-! `LP β`: skips to itself (neither finite nor productive). -/
structure LP (β : Type) where u : Unit

instance LP.inst {m : Type → Type} [Pure m] {β : Type} : Iterator (LP β) m β where
  IsPlausibleStep it s := s = .skip it
  step it := pure (.deflate ⟨.skip it, rfl⟩)

def LP.it {m : Type → Type} {β : Type} : IterM (α := LP β) m β := ⟨⟨()⟩⟩

theorem LP.skip {m : Type → Type} [Pure m] {β : Type} (it : IterM (α := LP β) m β) :
    it.IsPlausibleStep (.skip it) := rfl

theorem LP.not_finite {m : Type → Type} [Pure m] {β : Type} : ¬ Finite (LP β) m :=
  not_finite_of_skip LP.it (LP.skip _)

theorem LP.not_productive {m : Type → Type} [Pure m] {β : Type} : ¬ Productive (LP β) m :=
  not_productive_of_skip LP.it (LP.skip _)

/-! `DN β`: always done (finite and productive). -/
structure DN (β : Type) where u : Unit

instance DN.inst {m : Type → Type} [Pure m] {β : Type} : Iterator (DN β) m β where
  IsPlausibleStep _ s := s = .done
  step _ := pure (.deflate ⟨.done, rfl⟩)

instance DN.finite {m : Type → Type} [Pure m] {β : Type} : Finite (DN β) m :=
  ⟨⟨fun a => ⟨a, fun b ⟨s, hs, hp⟩ => by subst hp; cases hs⟩⟩⟩

instance DN.productive {m : Type → Type} [Pure m] {β : Type} : Productive (DN β) m :=
  ⟨⟨fun a => ⟨a, fun b h => by cases h⟩⟩⟩

/-! `ON`: state `true` yields the `LP Nat` iterator and moves to `false`, which is done (finite). -/
structure ON where b : Bool

def ON.stepv {m : Type → Type} : Bool → IterStep (IterM (α := ON) m (IterM (α := LP Nat) m Nat)) (IterM (α := LP Nat) m Nat)
  | true => .yield ⟨⟨false⟩⟩ LP.it
  | false => .done

instance ON.inst {m : Type → Type} [Pure m] : Iterator ON m (IterM (α := LP Nat) m Nat) where
  IsPlausibleStep it s := s = ON.stepv it.internalState.b
  step it := pure (.deflate ⟨ON.stepv it.internalState.b, rfl⟩)

theorem ON.acc_false {m : Type → Type} [Pure m] :
    Acc IterM.IsPlausibleSuccessorOf (⟨⟨false⟩⟩ : IterM (α := ON) m (IterM (α := LP Nat) m Nat)) :=
  ⟨_, fun b ⟨s, hs, hp⟩ => by subst hp; cases hs⟩

instance ON.finite {m : Type → Type} [Pure m] : Finite ON m :=
  ⟨⟨fun ⟨⟨b⟩⟩ => match b with
    | false => ON.acc_false
    | true => ⟨_, fun b' ⟨s, hs, hp⟩ => by
        subst hp; simp only [ON.stepv, IterStep.successor, Option.some.injEq] at hs; subst hs
        exact ON.acc_false⟩⟩⟩

/-! `YL`: yields `0` and stays (productive, not finite). -/
structure YL where u : Unit

instance YL.inst {m : Type → Type} [Pure m] : Iterator YL m Nat where
  IsPlausibleStep it s := s = .yield it 0
  step it := pure (.deflate ⟨.yield it 0, rfl⟩)

theorem YL.step : (⟨⟨()⟩⟩ : Iter (α := YL) Nat).step.val = .yield ⟨⟨()⟩⟩ 0 := by
  simp only [Iter.step, IterM.step, Iterator.step, IterM.Step.toPure, Id.run, pure]
  erw [Shrink.inflate_deflate]; rfl

/-! `Z`: state `true` yields `0` and moves to `false`, which skips to itself. Not finite, not
productive, and no loop over `Z` is well-founded, so every `IteratorLoop` on `Z` is lawful. -/
structure Z where b : Bool

def Z.stepv {m : Type → Type} : Bool → IterStep (IterM (α := Z) m Nat) Nat
  | true => .yield ⟨⟨false⟩⟩ 0
  | false => .skip ⟨⟨false⟩⟩

instance Z.inst {m : Type → Type} [Pure m] : Iterator Z m Nat where
  IsPlausibleStep it s := s = Z.stepv it.internalState.b
  step it := pure (.deflate ⟨Z.stepv it.internalState.b, rfl⟩)

theorem Z.not_finite {m : Type → Type} [Pure m] : ¬ Finite Z m :=
  not_finite_of_skip ⟨⟨false⟩⟩ rfl

theorem Z.not_productive {m : Type → Type} [Pure m] : ¬ Productive Z m :=
  not_productive_of_skip ⟨⟨false⟩⟩ rfl

theorem Z.not_wf {m : Type → Type} [Pure m] {γ : Type} (Pl : Nat → γ → ForInStep γ → Prop) (c : γ) :
    ¬ IteratorLoop.WellFounded Z m Pl :=
  fun wf => wf_irrefl wf (⟨⟨false⟩⟩, c) (Or.inr ⟨rfl, rfl⟩)

theorem Z.out0 {m : Type → Type} [Pure m] :
    (⟨⟨true⟩⟩ : IterM (α := Z) m Nat).IsPlausibleIndirectOutput 0 := .direct ⟨_, rfl⟩

/-- Loop that returns `init` without running the body. -/
@[instance_reducible] def Z.initLoop {m : Type → Type} [Pure m] {n : Type → Type} [Pure n] : IteratorLoop Z m n where
  forIn _ _ _ _ init _ := pure init

/-- Loop that applies the body once, to the output `0` of state `true`. -/
@[instance_reducible] def Z.onceLoop {m : Type → Type} [Pure m] {n : Type → Type} [Monad n] : IteratorLoop Z m n where
  forIn _ γ Pl it init f :=
    match it, f with
    | ⟨⟨true⟩⟩, f => (fun s => s.val.value) <$> f 0 Z.out0 init
    | ⟨⟨false⟩⟩, _ => pure init

theorem Z.initLawful {m n : Type → Type} [Monad m] [Monad n] :
    @LawfulIteratorLoop Nat Z m n _ _ _ Z.initLoop :=
  @LawfulIteratorLoop.mk Nat Z m n _ _ _ Z.initLoop (fun _ _ _ _ init Pl wf _ => absurd wf (Z.not_wf Pl init))

theorem Z.onceLawful {m n : Type → Type} [Monad m] [Monad n] :
    @LawfulIteratorLoop Nat Z m n _ _ _ Z.onceLoop :=
  @LawfulIteratorLoop.mk Nat Z m n _ _ _ Z.onceLoop (fun _ _ _ _ init Pl wf _ => absurd wf (Z.not_wf Pl init))

theorem Z.step : (⟨⟨true⟩⟩ : Iter (α := Z) Nat).step.val = .yield ⟨⟨false⟩⟩ 0 := by
  simp only [Iter.step, IterM.step, Iterator.step, IterM.Step.toPure, Id.run, pure]
  erw [Shrink.inflate_deflate]; rfl

theorem Z.step' : (⟨⟨true⟩⟩ : Iter (α := Z) Nat).step = ⟨.yield ⟨⟨false⟩⟩ 0, rfl⟩ :=
  Subtype.ext Z.step

/-! `ZT`: `Z` over `StateM Nat` whose `step` increments the state. -/
structure ZT where b : Bool

def ZT.stepv : Bool → IterStep (IterM (α := ZT) (StateM Nat) Nat) Nat
  | true => .yield ⟨⟨false⟩⟩ 0
  | false => .skip ⟨⟨false⟩⟩

instance ZT.inst : Iterator ZT (StateM Nat) Nat where
  IsPlausibleStep it s := s = ZT.stepv it.internalState.b
  step it := do modify (· + 1); pure (.deflate ⟨ZT.stepv it.internalState.b, rfl⟩)

theorem ZT.not_wf {γ : Type} (Pl : Nat → γ → ForInStep γ → Prop) (c : γ) :
    ¬ IteratorLoop.WellFounded ZT (StateM Nat) Pl :=
  fun wf => wf_irrefl wf (⟨⟨false⟩⟩, c) (Or.inr ⟨rfl, rfl⟩)

@[instance_reducible] def ZT.initLoop : IteratorLoop ZT (StateM Nat) (StateM Nat) where
  forIn _ _ _ _ init _ := pure init

theorem ZT.initLawful : @LawfulIteratorLoop Nat ZT (StateM Nat) (StateM Nat) _ _ _ ZT.initLoop :=
  @LawfulIteratorLoop.mk Nat ZT _ _ _ _ _ ZT.initLoop (fun _ _ _ _ init Pl wf _ => absurd wf (ZT.not_wf Pl init))


/-! ## Range models -/
section Range
open Std.PRange

/-- `U1`: one point, `succ? = some pt`, `succMany? n = none` for `n > 0`; `≤` is true. -/
inductive U1 | pt deriving DecidableEq
instance : UpwardEnumerable U1 :=
  { succ? := fun a => some a, succMany? := fun n a => if n = 0 then some a else none }
instance U1.instLE : LE U1 := ⟨fun _ _ => True⟩
instance : DecidableLE U1 := fun _ _ => isTrue trivial
theorem U1.le_eq (a b : U1) : (a ≤ b) = True := rfl
theorem U1.succ (a : U1) : succ? a = some a := rfl
instance : LawfulUpwardEnumerableLE U1 := ⟨fun .pt .pt => ⟨fun _ => ⟨0, rfl⟩, fun _ => trivial⟩⟩
instance : Rxc.IsAlwaysFinite U1 := ⟨fun _ _ => ⟨1, trivial⟩⟩
instance : Rxi.IsAlwaysFinite U1 := ⟨fun _ => ⟨1, rfl⟩⟩

/-- `U2`: one point, `succ? = some pt`, `succMany? n = some pt` iff `n ≤ 1`; `<` is true. -/
inductive U2 | pt deriving DecidableEq
instance : UpwardEnumerable U2 :=
  { succ? := fun a => some a, succMany? := fun n a => if n ≤ 1 then some a else none }
instance U2.instLT : LT U2 := ⟨fun _ _ => True⟩
instance : DecidableLT U2 := fun _ _ => isTrue trivial
theorem U2.lt_eq (a b : U2) : (a < b) = True := rfl
theorem U2.succ (a : U2) : succ? a = some a := rfl
instance : LawfulUpwardEnumerableLT U2 := ⟨fun .pt .pt => ⟨fun _ => ⟨0, rfl⟩, fun _ => trivial⟩⟩
instance : Rxo.IsAlwaysFinite U2 := ⟨fun _ _ => ⟨2, trivial⟩⟩

/-- Infinite descent: a family of lists with `length (L k) = length (L (k+1)) + 1` cannot exist. -/
theorem no_descent {β : Type} (L : Nat → List β) (h : ∀ k, (L k).length = (L (k + 1)).length + 1) : False := by
  have : ∀ j k, j ≤ (L k).length := by
    intro j; induction j with
    | zero => intro _; exact Nat.zero_le _
    | succ j ih => intro k; rw [h k]; exact Nat.succ_le_succ (ih (k + 1))
  exact Nat.lt_irrefl _ (this ((L 0).length + 1) 0)

end Range


theorem not_finite_of_yield {α β : Type} {m : Type → Type} [Iterator α m β]
    (it : IterM (α := α) m β) (out : β) (h : it.IsPlausibleStep (.yield it out)) : ¬ Finite α m :=
  fun hf => wf_irrefl hf.wf it ⟨_, rfl, h⟩

theorem not_wf_of_chain {β : Sort _} {r : β → β → Prop} (f : Nat → β) (hf : ∀ n, r (f (n + 1)) (f n)) :
    ¬ WellFounded r := by
  intro wf
  have : ∀ x, Acc r x → ∀ n, f n ≠ x := by
    intro x hx
    induction hx with
    | intro x _ ih => intro n e; subst e; exact ih _ (hf n) (n + 1) rfl
  exact this _ (wf.apply (f 0)) 0 rfl

theorem YL.out_eq (it : Iter (α := YL) Nat) (out : Nat) (h : it.IsPlausibleIndirectOutput out) : out = 0 := by
  induction h with
  | direct h => obtain ⟨it', h⟩ := h; cases h; rfl
  | indirect h _ ih => exact ih

theorem YL.not_out1 (it : Iter (α := YL) Nat) : ¬ it.IsPlausibleIndirectOutput 1 :=
  fun h => nomatch YL.out_eq it 1 h

/-! ## Tactics for the loop rows -/

-- zinit: installs Z.initLoop as the IteratorLoop Z Id Id instance (lawful, since Z is not finite)
set_option hygiene false in
macro "zinit" : tactic => `(tactic| (intro h; letI : IteratorLoop Z Id Id := Z.initLoop; haveI : LawfulIteratorLoop Z Id Id := Z.initLawful))

-- zclose: evaluates both sides of the instantiated equation (step of Z true, loop) and decides
set_option hygiene false in
macro "zclose" : tactic => `(tactic| first
  | (rw [Z.step'] at this; have := congrArg Id.run this; revert this; decide)
  | (rw [Z.step] at this; have := congrArg Id.run this; revert this; decide)
  | (simp only [IterM.step, Iterator.step, liftM, monadLift, pure_bind, Id.run_pure, Shrink.inflate_deflate] at this
     first
     | (have := congrArg Id.run this; revert this; decide)
     | (have := congrArg (fun x => (Id.run x).down) this; revert this; decide))
  | (have := congrArg Id.run this; revert this; decide))


/-! ## Verdicts -/

-- `Std.Iterators.Finite.wf` (hypothesis 4, Std.Iterators.Finite α m): necessary; LP (skips to itself): IsPlausibleSuccessorOf is reflexive at LP.it, not well-founded
theorem Iterators.Finite.wf.h4 : ¬ drop0% Std.Iterators.Finite.wf 4 := fun h =>
  wf_irrefl (h (α := LP Nat) (m := Id)) LP.it ⟨_, rfl, LP.skip _⟩

-- `Std.Iterators.Finite.wf_of_id` (hypothesis 3, Std.Iterators.Finite α Id): necessary; LP (skips to itself): Iter.IsPlausibleSuccessorOf is reflexive, not well-founded
theorem Iterators.Finite.wf_of_id.h3 : ¬ drop0% Std.Iterators.Finite.wf_of_id 3 := fun h =>
  wf_irrefl (h (α := LP Nat)) ⟨⟨()⟩⟩ ⟨_, rfl, LP.skip _⟩

-- `Std.Iterators.Productive.wf` (hypothesis 4, Std.Iterators.Productive α m): necessary; LP (skips to itself): IsPlausibleSkipSuccessorOf is reflexive, not well-founded
theorem Iterators.Productive.wf.h4 : ¬ drop0% Std.Iterators.Productive.wf 4 := fun h =>
  wf_irrefl (h (α := LP Nat) (m := Id)) LP.it (LP.skip _)

-- `Std.Iterators.instProductiveOfFinte` (hypothesis 4, Std.Iterators.Finite α m): necessary; LP (skips to itself) is not Productive
theorem Iterators.instProductiveOfFinte.h4 : ¬ drop0% Std.Iterators.instProductiveOfFinte 4 := fun h =>
  LP.not_productive (h (α := LP Nat) (m := Id))

-- `Std.Iterators.Types.Append.instFinite` (hypothesis 7, Std.Iterators.Finite α₁ m): necessary; α₁ = LP (skips to itself), α₂ = DN (always done, finite and productive): LP.append DN skips to itself (fstSkip), so Append is not Finite
theorem Iterators.Types.Append.instFinite.h7 : ¬ drop0% Std.Iterators.Types.Append.instFinite 7 := fun h =>
  not_finite_of_skip (LP.it.append (⟨⟨()⟩⟩ : IterM (α := DN Nat) Id Nat)) (Append.PlausibleStep.fstSkip (LP.skip _))
    (h (α₁ := LP Nat) (α₂ := DN Nat) (m := Id))

-- `Std.Iterators.Types.Append.instFinite` (hypothesis 8, Std.Iterators.Finite α₂ m): necessary; α₁ = DN (always done), α₂ = LP (skips to itself): appendSnd DN LP skips to itself (sndSkip), so Append is not Finite
theorem Iterators.Types.Append.instFinite.h8 : ¬ drop0% Std.Iterators.Types.Append.instFinite 8 := fun h =>
  not_finite_of_skip (IterM.Intermediate.appendSnd (DN Nat) (LP.it : IterM (α := LP Nat) Id Nat)) (Append.PlausibleStep.sndSkip (LP.skip _))
    (h (α₁ := DN Nat) (α₂ := LP Nat) (m := Id))

-- `Std.Iterators.Types.Attach.instFinite` (hypothesis 5, Std.Iterators.Finite α m): necessary; base LP (skips to itself), P = True: the attached LP skips to itself, so Attach is not Finite
theorem Iterators.Types.Attach.instFinite.h5 : ¬ drop0% Std.Iterators.Types.Attach.instFinite 5 := fun h =>
  not_finite_of_skip (⟨⟨LP.it, fun _ _ => trivial⟩⟩ : IterM (α := Attach (LP Nat) Id (fun _ => True)) Id _)
    (by exact ⟨.skip LP.it (LP.skip _), rfl⟩) (h (α := LP Nat) (m := Id) (P := fun _ => True))

-- `Std.Iterators.Types.ULiftIterator.instFinite` (hypothesis 6, Std.Iterators.Finite α m): necessary; base LP (skips to itself), m = n = Id: the uLift of LP skips to itself, so ULiftIterator is not Finite
theorem Iterators.Types.ULiftIterator.instFinite.h6 : ¬ drop0% Std.Iterators.Types.ULiftIterator.instFinite 6 := fun h =>
  not_finite_of_skip (⟨⟨(LP.it : IterM (α := LP Nat) Id Nat)⟩⟩ :
