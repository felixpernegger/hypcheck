-- `Std.IterM.forM_eq_match_step` (hypothesis 4, Std.Iterators.Finite α m): necessary; Z (state true yields 0 and moves to false, which skips to itself; not Finite, so every loop on Z is lawful) with Z.initLoop (returns init): m = n = StateM Nat, f = modify (+1) at Z true from state 0: LHS leaves state 0, RHS runs f once (state 1)
theorem IterM.forM_eq_match_step.h4 : ¬ drop0% Std.IterM.forM_eq_match_step 4 := by
  intro h; letI : IteratorLoop Z (StateM Nat) (StateM Nat) := Z.initLoop
  haveI : LawfulIteratorLoop Z (StateM Nat) (StateM Nat) := Z.initLawful
  have := congrArg (fun x => (x.run 0).2)
    (h (α := Z) (m := StateM Nat) (n := StateM Nat) (it := ⟨⟨true⟩⟩) (f := fun _ => modify (· + 1)))
  simp only [IterM.step, Iterator.step, liftM, monadLift, pure_bind, Shrink.inflate_deflate] at this
  revert this; decide

-- `Std.IterM.drain_eq_match_step` (hypothesis 4, Std.Iterators.Finite α m): necessary; ZT (Z over StateM Nat whose step increments the state; not Finite) with ZT.initLoop (returns init): at ZT true from state 0, LHS leaves state 0, RHS steps once (state 1)
theorem IterM.drain_eq_match_step.h4 : ¬ drop0% Std.IterM.drain_eq_match_step 4 := by
  intro h; letI := ZT.initLoop; haveI := ZT.initLawful
  have := congrArg (fun x => (x.run 0).2) (h (α := ZT) (m := StateM Nat) (it := ⟨⟨true⟩⟩))
  simp only [IterM.step, Iterator.step, bind_assoc, pure_bind, Shrink.inflate_deflate] at this
  revert this; decide

