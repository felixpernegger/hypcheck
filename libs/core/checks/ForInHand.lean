/-! ### Finiteness from lawfulness (copied from `checks/RangeFiniteHand.lean`) -/

theorem rxc_of_lawful {α : Type u} [UpwardEnumerable α] [LE α] [LawfulUpwardEnumerable α]
    [LawfulUpwardEnumerableLE α] : Rxc.IsAlwaysFinite α where
  finite init hi := by
    by_cases h : init ≤ hi
    · obtain ⟨m, hm⟩ := (LawfulUpwardEnumerableLE.le_iff init hi).1 h
      refine ⟨m + 1, ?_⟩
      rw [LawfulUpwardEnumerable.succMany?_add_one, hm]
      cases hs : UpwardEnumerable.succ? hi with
      | none => simp [hs]
      | some x =>
        simp only [Option.bind_some, hs, Option.elim_some]
        intro hx
        obtain ⟨k, hk⟩ := (LawfulUpwardEnumerableLE.le_iff x hi).1 hx
        apply LawfulUpwardEnumerable.ne_of_lt hi hi _ rfl
        refine ⟨k, ?_⟩
        rw [UpwardEnumerable.succMany?_add_one_eq_succ?_bind_succMany?, hs]; simpa using hk
    · exact ⟨0, by simpa [LawfulUpwardEnumerable.succMany?_zero] using h⟩

theorem rxo_of_lawful {α : Type u} [UpwardEnumerable α] [LT α] [LawfulUpwardEnumerable α]
    [LawfulUpwardEnumerableLT α] : Rxo.IsAlwaysFinite α where
  finite init hi := by
    by_cases h : init < hi
    · obtain ⟨m, hm⟩ := (LawfulUpwardEnumerableLT.lt_iff init hi).1 h
      refine ⟨m + 1, ?_⟩
      rw [hm]
      intro hx
      exact LawfulUpwardEnumerable.ne_of_lt hi hi ((LawfulUpwardEnumerableLT.lt_iff hi hi).1 hx) rfl
    · exact ⟨0, by simpa [LawfulUpwardEnumerable.succMany?_zero] using h⟩

/-! ### `W`: a writer monad whose `bind` counts 1 (not lawful) -/

/-- `W`: writer monad over `Int` (`bind` adds up the counters and adds `1`, `pure` counts `0`).
Not lawful (`pure a >>= f` counts one more than `f a`). -/
structure W (α : Type) where
  c : Int
  v : α
instance W.monad : Monad W where
  pure a := ⟨0, a⟩
  bind x f := ⟨x.c + (f x.v).c + 1, (f x.v).v⟩

@[simp] theorem W.bind_c {α β : Type} (x : W α) (f : α → W β) : (x >>= f).c = x.c + (f x.v).c + 1 := rfl
@[simp] theorem W.bind_v {α β : Type} (x : W α) (f : α → W β) : (x >>= f).v = (f x.v).v := rfl
@[simp] theorem W.pure_c {α : Type} (a : α) : (pure a : W α).c = 0 := rfl
@[simp] theorem W.pure_v {α : Type} (a : α) : (pure a : W α).v = a := rfl
theorem ne2 {x : Int} (h : x < 2) : (2 : Int) ≠ x := by omega
theorem ne3 {x : Int} (h : x < 2) : (3 : Int) ≠ x := by omega

/-- The loop body: stop at the first element. -/
def f0 {α : Type} : α → Unit → W (ForInStep Unit) := fun _ b => pure (.done b)

/-- A `List` loop with `f0` binds at most once. -/
theorem rhs {α : Type} (l : List α) : (forIn l () (f0 (α := α))).c < 2 := by
  cases l with
  | nil => exact (by decide : (0 : Int) < 2)
  | cons a t => exact (by decide : (0 : Int) + 0 + 1 < 2)

theorem rhs' {α : Type} (l : List α) : (forIn' l () (fun a _ b => f0 a b)).c < 2 := by
  cases l with
  | nil => exact (by decide : (0 : Int) < 2)
  | cons a t => exact (by decide : (0 : Int) + 0 + 1 < 2)

/-- Unfolds a range loop once (well-founded by finiteness) and evaluates the counter. -/
