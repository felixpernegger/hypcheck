structure SA where u : Unit
instance : ToIterator (Slice SC) Id CD Nat := ⟨fun _ => cim 1⟩
instance : ToIterator (Slice SA) Id AD Nat := ⟨fun _ => AD.itm⟩
abbrev sc : Slice SC := ⟨⟨()⟩⟩
abbrev sa : Slice SA := ⟨⟨()⟩⟩
