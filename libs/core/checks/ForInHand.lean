  simp only [forIn, ForIn'.forIn', IteratorLoop.forIn, Rcc.Internal.iter, Rco.Internal.iter, Rci.Internal.iter,
    Roc.Internal.iter, Roo.Internal.iter, Roi.Internal.iter, Ric.Internal.iter, Rio.Internal.iter, Rii.Internal.iter,
    Iter.toIterM, UpwardEnumerable.succ?, Least?.least?, Rxc.Iterator.instIteratorLoop.loop,
    Rxo.Iterator.instIteratorLoop.loop, Rxi.Iterator.instIteratorLoop.loop]
  rw [WellFounded.extrinsicFix₃_eq_apply (InvImage.wf _ IteratorLoop.wellFounded_of_finite)]
  rfl))

/-! The range loop over a one-element range binds twice (`return ⟨← f …, trivial⟩` of
`IteratorLoop.finiteForIn'`, then the match on the step), the `List` loop once. -/
theorem lhs_rcc : (forIn (0...=0 : Rcc Nat) () f0).c = 2 := by lhs_eval
theorem lhs_rco : (forIn (0...<1 : Rco Nat) () f0).c = 2 := by lhs_eval
theorem lhs_roc : (forIn (0<...=1 : Roc Nat) () f0).c = 2 := by lhs_eval
theorem lhs_roo : (forIn (0<...<2 : Roo Nat) () f0).c = 2 := by lhs_eval
theorem lhs_ric : (forIn (*...=0 : Ric Nat) () f0).c = 2 := by lhs_eval
theorem lhs_rio : (forIn (*...<1 : Rio Nat) () f0).c = 2 := by lhs_eval
theorem lhs_rci : (forIn ((0 : Fin 1)...* : Rci (Fin 1)) () f0).c = 2 := by lhs_eval
