import Lean

/-!
Hand pass `RangeDepA` (hand8): 404 dependent hypotheses of the bounded Range theorems
(`Std.Rcc/Rco/Roc/Roo/Ric/Rio.*`, `Rxc/Rxo.Iterator.*`). They are instance arguments that
`toList`/`toArray`/`forIn'`/… take (`LawfulUpwardEnumerable`, `LawfulUpwardEnumerableLE/LT/Least?`,
`InfinitelyUpwardEnumerable`, `Rxc/Rxo.IsAlwaysFinite`), plus 6 `hr : r = r'` of the `forIn'_congr`
lemmas. For hypothesis `hᵢ` of `T` each declaration proves `¬ ∀ indep, Hᵢ` (`indep0% T i`: all
binders that don't depend on `hᵢ`, with universes set to `0`): a model satisfies all the other
independent hypotheses (it has instances for them) and violates `Hᵢ` (a `¬` lemma).

404 necessary, 0 removable, 0 independent, 0 opaque.

* `LawfulUpwardEnumerable` (220): `M0` (156; `succMany? 0 a = none`), or `U1` (64; `succMany? 1 a = none`
  although `succ? a = some a`) when `LawfulUpwardEnumerableLeast?` is among the other hypotheses.
* `LawfulUpwardEnumerableLE` (42): `NLE`; `LawfulUpwardEnumerableLT` (44): `NLT`;
  `LawfulUpwardEnumerableLeast?` (52): `NLeast`; `InfinitelyUpwardEnumerable` (28): `U0`;
  `Rxc.IsAlwaysFinite` (6): `NTopC`; `Rxo.IsAlwaysFinite` (6): `NTopO`;
  `r = r'` (6): two different ranges over `Nat`.
* 36 of them have an independent premise about the range's elements (`i < r.toList.length`,
  `r.toArray = pref ++ #[cur] ++ suff`, …); these use ranges whose `toList` is evaluated below
  (`NLE.rcc`, …, by unfolding the iterator, which only needs `LawfulUpwardEnumerable` and finiteness).

The declarations are generated by `runs/hand8/scratch_RangeDepA/gen.py` from the binder lists in
`runs/explore3/sigs.jsonl`. Run with the lean4 repo's stage1 binary: `lean checks/RangeDepAHand.lean`.
-/

set_option linter.unusedVariables false
set_option linter.deprecated false

open Lean Meta Elab Term in
/-- `drop% T i`: `T` with its (non-dependent) Prop binder `i` dropped, read off the library. -/
elab "drop% " T:ident i:num : term => do
  let n ← realizeGlobalConstNoOverloadWithInfo T
  let ci ← getConstInfo n
  let us ← ci.levelParams.mapM fun _ => mkFreshLevelMVar
  forallTelescope (ci.type.instantiateLevelParams ci.levelParams us) fun xs body => do
    let x := xs[i.getNat]!
    unless ← isProp (← inferType x) do throwError "binder {i.getNat} of {n} is not a Prop"
    for j in [i.getNat+1:xs.size] do
      if (← inferType xs[j]!).containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    if body.containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    mkForallFVars (xs.eraseIdx! i.getNat) body

open Lean Meta Elab Term in
/-- `indep% T i`: `∀ indep, Hᵢ` for the dependent Prop binder `i` of `T` (all independent binders). -/
elab "indep% " T:ident i:num : term => do
  let n ← realizeGlobalConstNoOverloadWithInfo T
  let ci ← getConstInfo n
  let us ← ci.levelParams.mapM fun _ => mkFreshLevelMVar
  forallTelescope (ci.type.instantiateLevelParams ci.levelParams us) fun xs body => do
    let x := xs[i.getNat]!
    unless ← isProp (← inferType x) do throwError "binder {i.getNat} of {n} is not a Prop"
    let mut dep := #[x]
    for j in [i.getNat+1:xs.size] do
      let t ← inferType xs[j]!
      if dep.any (fun d => t.containsFVar d.fvarId!) then dep := dep.push xs[j]!
    unless dep.size > 1 || body.containsFVar x.fvarId! do
      throwError "binder {i.getNat} of {n} is not dependent"
    mkForallFVars (xs.filter (fun y => !dep.contains y)) (← inferType x)

open Lean Meta Elab Term in
/-- `indep0% T i`: like `indep% T i`, with all universes set to `0` (for refutations) for the dependent Prop binder `i` of `T` (all independent binders). -/
elab "indep0% " T:ident i:num : term => do
  let n ← realizeGlobalConstNoOverloadWithInfo T
  let ci ← getConstInfo n
  let us := ci.levelParams.map fun _ => levelZero
  forallTelescope (ci.type.instantiateLevelParams ci.levelParams us) fun xs body => do
    let x := xs[i.getNat]!
    unless ← isProp (← inferType x) do throwError "binder {i.getNat} of {n} is not a Prop"
    let mut dep := #[x]
    for j in [i.getNat+1:xs.size] do
      let t ← inferType xs[j]!
      if dep.any (fun d => t.containsFVar d.fvarId!) then dep := dep.push xs[j]!
    unless dep.size > 1 || body.containsFVar x.fvarId! do
      throwError "binder {i.getNat} of {n} is not dependent"
    mkForallFVars (xs.filter (fun y => !dep.contains y)) (← inferType x)

