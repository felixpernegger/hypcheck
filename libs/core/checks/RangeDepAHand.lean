instance : Rxc.IsAlwaysFinite NTopO := inferInstanceAs (Rxc.IsAlwaysFinite Nat)
theorem NTopO.not_RxoF : ¬ Rxo.IsAlwaysFinite NTopO := fun h => by
  obtain ⟨n, hn⟩ := h.finite (0 : Nat) (0 : Nat); exact hn trivial


macro "range_eval" : tactic => `(tactic| (
  repeat (rw [Iter.toList_eq_match_step]; simp +decide only [Rxc.Iterator.step_eq_step, Rxc.Iterator.step, Rxo.Iterator.step_eq_step, Rxo.Iterator.step, UpwardEnumerable.succ?, Least?.least?, ↓reduceIte])
  all_goals rfl))

theorem NLE.rcc : (Rcc.mk (NLE.pt 0) (NLE.pt 0)).toList = [NLE.pt 0, NLE.pt 1] := by
  simp only [Rcc.toList, Rcc.Internal.iter]; range_eval
theorem NLE.roc : (Roc.mk (NLE.pt 0) (NLE.pt 0)).toList = [NLE.pt 1] := by
  simp only [Roc.toList, Roc.Internal.iter]; range_eval
theorem NLE.ric : (Ric.mk (NLE.pt 0)).toList = [NLE.pt 0, NLE.pt 1] := by
  simp only [Ric.toList, Ric.Internal.iter]; range_eval
theorem NLT.rco : (Rco.mk (NLT.pt 0) (NLT.pt 0)).toList = [NLT.pt 0] := by
  simp only [Rco.toList, Rco.Internal.iter]; range_eval
theorem NLT.roo : (Roo.mk (NLT.pt 0) (NLT.pt 1)).toList = [NLT.pt 1] := by
  simp only [Roo.toList, Roo.Internal.iter]; range_eval
theorem NLT.rio : (Rio.mk (NLT.pt 0)).toList = [NLT.pt 0] := by
  simp only [Rio.toList, Rio.Internal.iter]; range_eval
theorem NLeast.ric : (Ric.mk (NLeast.pt 1)).toList = [NLeast.pt 1] := by
  simp only [Ric.toList, Ric.Internal.iter]; range_eval
theorem NLeast.rio : (Rio.mk (NLeast.pt 2)).toList = [NLeast.pt 1] := by
  simp only [Rio.toList, Rio.Internal.iter]; range_eval


