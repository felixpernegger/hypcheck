open Lean Meta Elab Term in
/-- `drop% T i`: `T` with its (non-dependent) Prop binder `i` dropped, read off the library. -/
elab "drop% " T:ident i:num : term => do
  let n ← realizeGlobalConstNoOverloadWithInfo T
  let ci ← getConstInfo n
  let us ← ci.levelParams.mapM fun _ => mkFreshLevelMVar
  forallTelescope (ci.type.instantiateLevelParams ci.levelParams us) fun xs body => do
    let x := xs[i.getNat]!
    unless ← isProp (← inferType x) do throwError "binder {i.getNat} of {n} is not a Prop"
    for j in [i.getNat+1:xs.size] do
      if (← inferType xs[j]!).containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    if body.containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    mkForallFVars (xs.eraseIdx! i.getNat) body

open Lean Meta Elab Term in
/-- `drop0% T i`: `drop% T i` with all universe parameters of `T` set to `0` (for refutations). -/
elab "drop0% " T:ident i:num : term => do
  let n ← realizeGlobalConstNoOverloadWithInfo T
  let ci ← getConstInfo n
  let us := ci.levelParams.map fun _ => Level.zero
  forallTelescope (ci.type.instantiateLevelParams ci.levelParams us) fun xs body => do
    let x := xs[i.getNat]!
    unless ← isProp (← inferType x) do throwError "binder {i.getNat} of {n} is not a Prop"
    for j in [i.getNat+1:xs.size] do
      if (← inferType xs[j]!).containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    if body.containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    mkForallFVars (xs.eraseIdx! i.getNat) body

open Lean Meta Elab Term in
/-- `indep% T i`: `∀ indep, Hᵢ` for the dependent Prop binder `i` of `T` (all independent binders). -/
elab "indep% " T:ident i:num : term => do
  let n ← realizeGlobalConstNoOverloadWithInfo T
  let ci ← getConstInfo n
  let us ← ci.levelParams.mapM fun _ => mkFreshLevelMVar
  forallTelescope (ci.type.instantiateLevelParams ci.levelParams us) fun xs body => do
    let x := xs[i.getNat]!
    unless ← isProp (← inferType x) do throwError "binder {i.getNat} of {n} is not a Prop"
    let mut dep := #[x]
    for j in [i.getNat+1:xs.size] do
      let t ← inferType xs[j]!
      if dep.any (fun d => t.containsFVar d.fvarId!) then dep := dep.push xs[j]!
    unless dep.size > 1 || body.containsFVar x.fvarId! do
      throwError "binder {i.getNat} of {n} is not dependent"
    mkForallFVars (xs.filter (fun y => !dep.contains y)) (← inferType x)

namespace LawfulBHand

/-! ## Models -/

/-- Constant monad on Bool: pure, bind and map all return false (no functor law). -/
def K (_ : Type) : Type := Bool
instance : Monad K where
  pure _ := (false : Bool)
  bind _ _ := (false : Bool)
  map _ _ := (false : Bool)

/-- Lawful functor (α → Empty) → Bool: two elements over Empty, one over Unit. -/
def Cn (α : Type) : Type := (α → Empty) → Bool
instance : Functor Cn where
  map f k := fun h => k (h ∘ f)
instance : LawfulFunctor Cn where
  map_const := rfl
  id_map _ := rfl
  comp_map _ _ _ := rfl

/-- Int counter monad: map and bind add one, attach subtracts one; CanReturn x a := x.v = a.
Lawful MonadAttach (hence weakly lawful), but no monad law. -/
structure AM (α : Type) where
  c : Int
  v : α
instance : Monad AM where
  pure a := ⟨0, a⟩
  bind x f := ⟨x.c + (f x.v).c + 1, (f x.v).v⟩
  map f x := ⟨x.c + 1, f x.v⟩
instance : MonadAttach AM where
  CanReturn x a := x.v = a
  attach x := ⟨x.c - 1, ⟨x.v, rfl⟩⟩
instance : LawfulMonadAttach AM where
  map_attach := by
    intro α x
    show AM.mk (x.c - 1 + 1) x.v = x
    rw [Int.sub_add_cancel]
  canReturn_map_imp := by
    intro α P x a h
    change x.v.val = a at h
    exact h ▸ x.v.property
instance : Nonempty (AM Nat) := ⟨⟨0, 0⟩⟩
theorem AM.bind_c {α β : Type} (x : AM α) (g : α → AM β) : (x >>= g).c = x.c + (g x.v).c + 1 := rfl

/-- Option with the trivial MonadAttach (CanReturn is True): lawful monad, weakly lawful,
not lawful. -/
def TO (α : Type) : Type := Option α
instance : Monad TO := inferInstanceAs (Monad Option)
instance : LawfulMonad TO := inferInstanceAs (LawfulMonad Option)
instance : MonadAttach TO := .trivial
instance : WeaklyLawfulMonadAttach TO where
  map_attach {α x} := by
    cases x <;> rfl

/-- Option whose attach is none (CanReturn is True): lawful monad, not weakly lawful. -/
def NT (α : Type) : Type := Option α
instance : Monad NT := inferInstanceAs (Monad Option)
instance : LawfulMonad NT := inferInstanceAs (LawfulMonad Option)
instance : MonadAttach NT where
  CanReturn _ _ := True
  attach _ := (none : Option _)
def NT.some {α : Type} (a : α) : NT α := Option.some a
theorem NT.bind_some {α β : Type} (a : α) (g : α → NT β) : NT.some a >>= g = g a := rfl

/-- Option whose attach is none and CanReturn is False: lawful monad, not weakly lawful. -/
def NF (α : Type) : Type := Option α
instance : Monad NF := inferInstanceAs (Monad Option)
instance : LawfulMonad NF := inferInstanceAs (LawfulMonad Option)
instance : MonadAttach NF where
  CanReturn _ _ := False
  attach _ := (none : Option _)

/-- The value Classical.choice picks in a nonempty type (none for an empty one). -/
noncomputable def ghost (α : Type) : Option α :=
  open Classical in if h : Nonempty α then some (Classical.choice h) else none

theorem ghost_eq {α : Type} (a : α) : ghost α = some (Classical.choice ⟨a⟩) := by
  unfold ghost; rw [dif_pos ⟨a⟩]

theorem ghost_empty {α : Type} (h : ¬ Nonempty α) : ghost α = none := by
  unfold ghost; rw [dif_neg h]

/-- The Bool that Classical.choice picks. -/
noncomputable def cB : Bool := Classical.choice ⟨true⟩

theorem not_cB : ∀ d : Bool, (!d) = d → False := by decide

/-- none replaced by the ghost value. -/
noncomputable def ghFill {α : Type} : Option α → Option α
  | some a => some a
  | none => ghost α

/-- Ghost Option monad: pure a := some (choice) (independent of a), and none >>= f,
f <$> none continue with the ghost value. MonadAttach as for Option; it is lawful (the ghost
value of a subtype satisfies its predicate). No monad law. -/
def GH (α : Type) : Type := Option α
noncomputable instance : Monad GH where
  pure {α} a := (some (Classical.choice (⟨a⟩ : Nonempty α)) : Option α)
  bind {α β} x f := Option.elim (ghFill (x : Option α)) (none : Option β) f
  map {α β} f x := Option.map f (ghFill (x : Option α))
instance : MonadAttach GH where
  CanReturn x a := (x : Option _) = some a
  attach x := Option.attach (x : Option _)
instance : LawfulMonadAttach GH where
  map_attach {α x} := by
    cases x with
    | some a => rfl
    | none =>
      show Option.map Subtype.val (ghost _) = none
      rw [ghost_empty]
      · rfl
      · rintro ⟨⟨a, h⟩⟩; cases h
  canReturn_map_imp {α P x a} h := by
    change Option.map Subtype.val (ghFill (x : Option _)) = some a at h
    cases x with
    | some b => cases h; exact b.property
    | none =>
      change Option.map Subtype.val (ghost _) = some a at h
      unfold ghost at h
      split at h
      · cases h; exact Subtype.property _
      · cases h

/-- Option (Option α) with a ghost element some none: some none >>= f continues with the
ghost value. CanReturn x a := x = some (some a), map is lawful, MonadAttach is lawful. -/
def G3 (α : Type) : Type := Option (Option α)
noncomputable def G3.bind {α β : Type} : Option (Option α) → (α → Option (Option β)) → Option (Option β)
  | some (some a), f => f a
  | some none, f => Option.elim (ghost α) none f
  | none, _ => none
def G3.attach {α : Type} : (x : Option (Option α)) → Option (Option {a // x = some (some a)})
  | some (some a) => some (some ⟨a, rfl⟩)
  | some none => some none
  | none => none
noncomputable instance : Monad G3 where
  pure a := (some (some a) : Option (Option _))
  bind x f := G3.bind x f
  map f x := Option.map (Option.map f) (x : Option (Option _))
instance : MonadAttach G3 where
  CanReturn x a := (x : Option (Option _)) = some (some a)
  attach x := G3.attach x
instance : LawfulMonadAttach G3 where
  map_attach {α x} := by
    rcases x with _ | _ | a <;> rfl
  canReturn_map_imp {α P x a} h := by
    change Option.map (Option.map Subtype.val) (x : Option (Option _)) = some (some a) at h
    rcases x with _ | _ | b
    · cases h
    · cases h
    · cases h; exact b.property

/-- Lift G3 → Option: the ghost element goes to the ghost value; lawful. -/
noncomputable def G3.lift {α : Type} : Option (Option α) → Option α
  | some (some a) => some a
  | some none => ghost α
  | none => none
noncomputable def liftG3 : MonadLiftT G3 Option := ⟨fun x => G3.lift x⟩
theorem lawG3 : @LawfulMonadLiftT G3 Option _ _ liftG3 := by
  refine @LawfulMonadLiftT.mk G3 Option _ _ liftG3 (fun _ => rfl) ?_
  intro α β x f
  rcases x with _ | _ | a
  · rfl
  · show G3.lift (Option.elim (ghost α) none f) = ghost α >>= fun a => G3.lift (f a)
    unfold ghost
    split <;> rfl
  · rfl

/-- Identity lift NF → Option; lawful. -/
def lNF : MonadLiftT NF Option := ⟨fun x => x⟩
theorem lawNF : @LawfulMonadLiftT NF Option _ _ lNF :=
  @LawfulMonadLiftT.mk NF Option _ _ lNF (fun _ => rfl) (fun _ _ => rfl)

/-- pure : Id → GH is a lawful lift, since GH's pure ignores its argument. -/
theorem lawIdGH : @LawfulMonadLiftT Id GH _ _ Id.instMonadLiftTOfPure :=
  @LawfulMonadLiftT.mk Id GH _ _ Id.instMonadLiftTOfPure (fun _ => rfl) (fun _ _ => rfl)

/-- Lift Id → Option that forgets its argument: some (choice). Not lawful. -/
noncomputable def gl : MonadLiftT Id Option where
  monadLift {α} x := some (Classical.choice (⟨x⟩ : Nonempty α))

/-- Lift Id → Option that is none on subsingleton types and some otherwise. Not lawful; does
not commute with map/seq/seqLeft/seqRight. -/
noncomputable def SL : MonadLiftT Id Option where
  monadLift {α} x := open Classical in if Subsingleton α then none else some x

theorem not_sub_Bool : ¬ Subsingleton Bool := fun h => Bool.noConfusion (h.elim true false)
theorem SL_Unit (x : Unit) : @monadLift Id Option SL Unit x = none := if_pos (inferInstanceAs (Subsingleton Unit))
theorem SL_fun (x : Unit → Bool) : @monadLift Id Option SL (Unit → Bool) x = some x :=
  if_neg fun h => Bool.noConfusion (congrFun (h.elim (fun _ => true) (fun _ => false)) ())
theorem SL_Bool (x : Bool) : @monadLift Id Option SL Bool x = some x := if_neg not_sub_Bool

/-- Lawful Nat writer. -/
structure W (α : Type) where
  c : Nat
  v : α
instance : Monad W where
  pure a := ⟨0, a⟩
  bind x f := ⟨x.c + (f x.v).c, (f x.v).v⟩
theorem W.ext' {α} {x y : W α} (h1 : x.c = y.c) (h2 : x.v = y.v) : x = y := by
  cases x; cases y; simp_all
instance : LawfulMonad W := LawfulMonad.mk'
  (id_map := fun _ => rfl)
  (pure_bind := fun _ _ => W.ext' (Nat.zero_add _) rfl)
  (bind_assoc := fun _ _ _ => W.ext' (Nat.add_assoc _ _ _) rfl)

/-- Lift Id → W that ticks the counter: not lawful. -/
def tick : MonadLift Id W := ⟨fun x => ⟨1, x⟩⟩
def tickT : MonadLiftT Id W := ⟨fun x => ⟨1, x⟩⟩

/-- Nat writer with lawful pure/bind whose map, seq, seqLeft, seqRight add one. -/
structure MB (α : Type) where
  c : Nat
  v : α
instance : Monad MB where
  pure a := ⟨0, a⟩
  bind x f := ⟨x.c + (f x.v).c, (f x.v).v⟩
  map f x := ⟨x.c + 1, f x.v⟩
  seq mf mx := ⟨mf.c + (mx ()).c + 1, mf.v (mx ()).v⟩
  seqLeft x y := ⟨x.c + (y ()).c + 1, x.v⟩
  seqRight x y := ⟨x.c + (y ()).c + 1, (y ()).v⟩

/-- The identity lifts between MB and W; both lawful (same pure and bind). -/
def lMW : MonadLiftT MB W := ⟨fun x => ⟨x.c, x.v⟩⟩
def lWM : MonadLiftT W MB := ⟨fun x => ⟨x.c, x.v⟩⟩
theorem lawMW : @LawfulMonadLiftT MB W _ _ lMW :=
  @LawfulMonadLiftT.mk MB W _ _ lMW (fun _ => rfl) (fun _ _ => rfl)
theorem lawWM : @LawfulMonadLiftT W MB _ _ lWM :=
  @LawfulMonadLiftT.mk W MB _ _ lWM (fun _ => rfl) (fun _ _ => rfl)

/-- An element of ST.Ref Unit Unit. -/
noncomputable def ref0 : ST.Ref Unit Unit := Classical.choice inferInstance

