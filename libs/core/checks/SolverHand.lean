-- `Lean.Grind.CommRing.Poly.denote_cancelVarB_k` (hypothesis 6): removable, as above.
theorem denote_cancelVarB_k_h6 : drop% Lean.Grind.CommRing.Poly.denote_cancelVarB_k 6 := by
