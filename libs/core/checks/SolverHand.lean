/-! Helpers for le_normQ_expr without LawfulOrderLT. The first one is the library's private
lemma denote_sub_of_normQ_cert, copied. -/

theorem denote_sub_of_normQ_cert' {α : Type u} [Field α] [IsCharP α 0] (ctx : Context α) (bal : Bool)
    (invs : InvVars) (hok : invs.ok ctx) (ainvs : InvAtoms) (hoka : ainvs.ok ctx) (lhs rhs lhs' rhs' : Expr)
    (h : normQ_cert bal invs ainvs lhs rhs lhs' rhs') :
    ∃ d : Nat, d ≠ 0 ∧ lhs.denote ctx - rhs.denote ctx = (lhs'.denote ctx - rhs'.denote ctx) * (d : α)⁻¹ := by
  simp only [normQ_cert, Poly.beq'_eq] at h
  refine ⟨(((lhs.sub rhs).toPolyX_k bal).toPolyQX_k bal invs ainvs).den,
    Poly.toPolyQX_k_den_ne_zero bal _ invs ainvs, ?_⟩
  have h₁ := Poly.denote_toPolyQX_k ctx bal ((lhs.sub rhs).toPolyX_k bal) invs ainvs hok hoka
  have h₂ := Expr.denote_toPolyX_k ctx bal (lhs'.sub rhs')
  rw [Expr.denote_toPolyX_k] at h₁
  simp only [PolyQ.denote, h] at h₁
  replace h₁ : ((lhs'.sub rhs').toPolyX_k bal).denote ctx * ((((lhs.sub rhs).toPolyX_k bal).toPolyQX_k bal invs ainvs).den : α)⁻¹
      = lhs.denote ctx - rhs.denote ctx := h₁
  replace h₂ : ((lhs'.sub rhs').toPolyX_k bal).denote ctx = lhs'.denote ctx - rhs'.denote ctx := h₂
  rw [← h₁, h₂]

theorem sub_nonpos_iff' {α : Type u} [Ring α] [LE α] [IsPreorder α] [OrderedAdd α] {a b : α} :
    a - b ≤ 0 ↔ a ≤ b := by
  rw [← OrderedAdd.neg_nonneg_iff, AddCommGroup.neg_sub, OrderedAdd.sub_nonneg_iff]

theorem mul_natCast_nonpos {α : Type u} [Semiring α] [LE α] [IsPreorder α] [OrderedAdd α] {y : α}
    (hy : y ≤ 0) (n : Nat) : y * (n : α) ≤ 0 := by
  induction n with
  | zero => rw [Semiring.natCast_zero, Semiring.mul_zero]; exact IsPreorder.le_refl _
  | succ n ih =>
    rw [Semiring.natCast_succ, Semiring.left_distrib, Semiring.mul_one]
    have := OrderedAdd.add_le_add ih hy; rwa [Semiring.add_zero] at this

theorem mul_natCast_nonneg {α : Type u} [Semiring α] [LE α] [IsPreorder α] [OrderedAdd α] {y : α}
    (hy : 0 ≤ y) (n : Nat) : 0 ≤ y * (n : α) := by
  induction n with
  | zero => rw [Semiring.natCast_zero, Semiring.mul_zero]; exact IsPreorder.le_refl _
  | succ n ih =>
    rw [Semiring.natCast_succ, Semiring.left_distrib, Semiring.mul_one]
    have := OrderedAdd.add_le_add ih hy; rwa [Semiring.add_zero] at this

/-- In a field of characteristic `0` with a translation-invariant linear order, scaling by a
positive integer's inverse preserves the sign, whatever `<` is. -/
theorem mul_inv_nonpos_iff' {α : Type u} [Field α] [IsCharP α 0] [LE α] [IsLinearOrder α] [OrderedAdd α]
    {t : α} {d : Nat} (hd : d ≠ 0) : t * (d : α)⁻¹ ≤ 0 ↔ t ≤ 0 := by
  have hd' : (d : α) ≠ 0 := Field.natCast_ne_zero hd
  have ht : t = t * (d : α)⁻¹ * (d : α) := by
    rw [Semiring.mul_assoc, Field.inv_mul_cancel hd', Semiring.mul_one]
  constructor
  · intro h; rw [ht]; exact mul_natCast_nonpos h d
  · intro h
    rcases IsLinearPreorder.le_total (t * (d : α)⁻¹) 0 with h' | h'
    · exact h'
    · have h0 : t = 0 := IsPartialOrder.le_antisymm _ _ h (by rw [ht]; exact mul_natCast_nonneg h' d)
      rw [h0, Semiring.zero_mul]; exact IsPreorder.le_refl _

