open Lean.Grind CommRing Std
attribute [local instance] Semiring.natCast Ring.intCast

namespace SolverHand

/-- `Int` with `≤` = equality plus `1 ≤ 0`; lawful `<`: a preorder, not translation invariant. -/
def IPle := Int
abbrev IPle.le (a b : Int) : Prop := a = b ∨ (a = 1 ∧ b = 0)
abbrev IPle.lt (a b : Int) : Prop := a = 1 ∧ b = 0
instance : DecidableEq IPle := inferInstanceAs (DecidableEq Int)
instance : CommRing IPle := inferInstanceAs (CommRing Int)
instance : IsCharP IPle 0 := inferInstanceAs (IsCharP Int 0)
instance : LE IPle := ⟨IPle.le⟩
instance : LT IPle := ⟨IPle.lt⟩
instance : DecidableLE IPle := fun (a b : Int) => inferInstanceAs (Decidable (IPle.le a b))
instance : DecidableLT IPle := fun (a b : Int) => inferInstanceAs (Decidable (IPle.lt a b))
instance : IsPreorder IPle where
  le_refl a := Or.inl rfl
  le_trans a b c (h₁ : IPle.le a b) (h₂ : IPle.le b c) := (by unfold IPle.le at *; omega : IPle.le a c)
instance : LawfulOrderLT IPle where
  lt_iff a b := (by unfold IPle.lt IPle.le; omega : IPle.lt a b ↔ IPle.le a b ∧ ¬ IPle.le b a)

/-- `Int` with `≤` = equality and the usual `<`: ordered ring, but `0 ≤ 1` fails. -/
def ILEeq := Int
abbrev ILEeq.le (a b : Int) : Prop := a = b
abbrev ILEeq.lt (a b : Int) : Prop := a < b
instance : DecidableEq ILEeq := inferInstanceAs (DecidableEq Int)
instance : CommRing ILEeq := inferInstanceAs (CommRing Int)
instance : IsCharP ILEeq 0 := inferInstanceAs (IsCharP Int 0)
instance : LE ILEeq := ⟨ILEeq.le⟩
instance : LT ILEeq := ⟨ILEeq.lt⟩
instance : DecidableLE ILEeq := fun (a b : Int) => inferInstanceAs (Decidable (ILEeq.le a b))
instance : DecidableLT ILEeq := fun (a b : Int) => inferInstanceAs (Decidable (ILEeq.lt a b))
instance : IsPreorder ILEeq where
  le_refl a := (rfl : ILEeq.le a a)
  le_trans a b c (h₁ : ILEeq.le a b) (h₂ : ILEeq.le b c) := (h₁.trans h₂ : ILEeq.le a c)
instance : OrderedRing ILEeq where
  add_le_left_iff {a b} c := (by unfold ILEeq.le; omega : ILEeq.le a b ↔ ILEeq.le (a + c : Int) (b + c))
  zero_lt_one := (by decide : ILEeq.lt 0 1)
  mul_lt_mul_of_pos_left {a b c} (h : ILEeq.lt a b) (hc : ILEeq.lt 0 c) :=
    (Int.mul_lt_mul_of_pos_left h hc : ILEeq.lt ((c : Int) * a) (c * b))
  mul_lt_mul_of_pos_right {a b c} (h : ILEeq.lt a b) (hc : ILEeq.lt 0 c) :=
    (Int.mul_lt_mul_of_pos_right h hc : ILEeq.lt ((a : Int) * c) (b * c))

/-- `Int` with the usual `≤` and `a < b := a < b ∧ 0 < b`: ordered ring, `<` not lawful. -/
def ILTpos := Int
abbrev ILTpos.lt (a b : Int) : Prop := a < b ∧ 0 < b
instance : DecidableEq ILTpos := inferInstanceAs (DecidableEq Int)
instance : CommRing ILTpos := inferInstanceAs (CommRing Int)
instance : IsCharP ILTpos 0 := inferInstanceAs (IsCharP Int 0)
instance : LE ILTpos := inferInstanceAs (LE Int)
instance : LT ILTpos := ⟨ILTpos.lt⟩
instance : DecidableLE ILTpos := inferInstanceAs (DecidableLE Int)
instance : DecidableLT ILTpos := fun (a b : Int) => inferInstanceAs (Decidable (ILTpos.lt a b))
instance : IsLinearOrder ILTpos := inferInstanceAs (IsLinearOrder Int)
instance : OrderedAdd ILTpos := inferInstanceAs (OrderedAdd Int)
instance : OrderedRing ILTpos where
  zero_lt_one := (by decide : ILTpos.lt 0 1)
  mul_lt_mul_of_pos_left {a b c} (h : ILTpos.lt a b) (hc : ILTpos.lt 0 c) :=
    (⟨Int.mul_lt_mul_of_pos_left h.1 hc.1, Int.mul_pos hc.1 h.2⟩ : ILTpos.lt ((c : Int) * a) (c * b))
  mul_lt_mul_of_pos_right {a b c} (h : ILTpos.lt a b) (hc : ILTpos.lt 0 c) :=
    (⟨Int.mul_lt_mul_of_pos_right h.1 hc.1, Int.mul_pos h.2 hc.1⟩ : ILTpos.lt ((a : Int) * c) (b * c))

/-- `Int` with the usual `≤` and `a < b := a < b ∧ b - a odd`: ordered ring, `<` not lawful. -/
def ILTodd := Int
abbrev ILTodd.lt (a b : Int) : Prop := a < b ∧ (b - a) % 2 = 1
instance : DecidableEq ILTodd := inferInstanceAs (DecidableEq Int)
instance : CommRing ILTodd := inferInstanceAs (CommRing Int)
instance : IsCharP ILTodd 0 := inferInstanceAs (IsCharP Int 0)
instance : LE ILTodd := inferInstanceAs (LE Int)
instance : LT ILTodd := ⟨ILTodd.lt⟩
instance : DecidableLE ILTodd := inferInstanceAs (DecidableLE Int)
instance : DecidableLT ILTodd := fun (a b : Int) => inferInstanceAs (Decidable (ILTodd.lt a b))
instance : IsLinearOrder ILTodd := inferInstanceAs (IsLinearOrder Int)
instance : OrderedAdd ILTodd := inferInstanceAs (OrderedAdd Int)
theorem ILTodd.odd_mul {c d : Int} (hc : c % 2 = 1) (hd : d % 2 = 1) : (c * d) % 2 = 1 := by
  rw [Int.mul_emod, hc, hd]; rfl
theorem ILTodd.mul_left {a b c : Int} (h : ILTodd.lt a b) (hc : ILTodd.lt 0 c) : ILTodd.lt (c * a) (c * b) :=
  ⟨Int.mul_lt_mul_of_pos_left h.1 hc.1,
    by rw [← Int.mul_sub]; exact ILTodd.odd_mul (by have := hc.2; rwa [Int.sub_zero] at this) h.2⟩
theorem ILTodd.mul_right {a b c : Int} (h : ILTodd.lt a b) (hc : ILTodd.lt 0 c) : ILTodd.lt (a * c) (b * c) :=
  ⟨Int.mul_lt_mul_of_pos_right h.1 hc.1,
    by rw [← Int.sub_mul]; exact ILTodd.odd_mul h.2 (by have := hc.2; rwa [Int.sub_zero] at this)⟩
instance : OrderedRing ILTodd where
  zero_lt_one := (by decide : ILTodd.lt 0 1)
  mul_lt_mul_of_pos_left := ILTodd.mul_left
  mul_lt_mul_of_pos_right := ILTodd.mul_right

/-- `Int` with the usual `≤` and `a < b := True`: ordered ring, `<` not lawful. -/
def ILTall := Int
instance : DecidableEq ILTall := inferInstanceAs (DecidableEq Int)
instance : CommRing ILTall := inferInstanceAs (CommRing Int)
instance : IsCharP ILTall 0 := inferInstanceAs (IsCharP Int 0)
instance : LE ILTall := inferInstanceAs (LE Int)
instance : LT ILTall := ⟨fun _ _ => True⟩
instance : DecidableLE ILTall := inferInstanceAs (DecidableLE Int)
instance : DecidableLT ILTall := fun _ _ => instDecidableTrue
instance : IsLinearOrder ILTall := inferInstanceAs (IsLinearOrder Int)
instance : OrderedAdd ILTall := inferInstanceAs (OrderedAdd Int)
instance : OrderedRing ILTall where
  zero_lt_one := trivial
  mul_lt_mul_of_pos_left _ _ := trivial
  mul_lt_mul_of_pos_right _ _ := trivial

/-- `Int` with `≤` and `<` both the strict order: `<` lawful, `≤` not reflexive. -/
def IStrict := Int
instance : DecidableEq IStrict := inferInstanceAs (DecidableEq Int)
instance : CommRing IStrict := inferInstanceAs (CommRing Int)
instance : LE IStrict := ⟨fun (a b : Int) => a < b⟩
instance : LT IStrict := inferInstanceAs (LT Int)
instance : DecidableLE IStrict := inferInstanceAs (DecidableLT Int)
instance : DecidableLT IStrict := inferInstanceAs (DecidableLT Int)
instance : LawfulOrderLT IStrict where
  lt_iff := fun (a b : Int) => (by omega : a < b ↔ a < b ∧ ¬ b < a)
theorem IStrict.not_preorder : ¬ IsPreorder IStrict := fun h => Int.lt_irrefl (0 : Int) (h.le_refl (0 : Int))

/-- `Rat` with the usual `≤` and `a < b := a < b ∧ 0 < b`: ordered field, `<` not lawful. -/
def RLTpos := Rat
abbrev RLTpos.lt (a b : Rat) : Prop := a < b ∧ 0 < b
instance : DecidableEq RLTpos := inferInstanceAs (DecidableEq Rat)
instance : Field RLTpos := inferInstanceAs (Field Rat)
instance : IsCharP RLTpos 0 := inferInstanceAs (IsCharP Rat 0)
instance : LE RLTpos := inferInstanceAs (LE Rat)
instance : LT RLTpos := ⟨RLTpos.lt⟩
instance : DecidableLE RLTpos := inferInstanceAs (DecidableLE Rat)
instance : DecidableLT RLTpos := fun (a b : Rat) => inferInstanceAs (Decidable (RLTpos.lt a b))
instance : IsLinearOrder RLTpos := inferInstanceAs (IsLinearOrder Rat)
instance : OrderedAdd RLTpos := inferInstanceAs (OrderedAdd Rat)
instance : OrderedRing RLTpos where
  zero_lt_one := (by decide : RLTpos.lt 0 1)
  mul_lt_mul_of_pos_left {a b c} (h : RLTpos.lt a b) (hc : RLTpos.lt 0 c) :=
    (⟨Rat.mul_lt_mul_of_pos_left h.1 hc.1, Rat.mul_pos hc.1 h.2⟩ : RLTpos.lt ((c : Rat) * a) (c * b))
  mul_lt_mul_of_pos_right {a b c} (h : RLTpos.lt a b) (hc : RLTpos.lt 0 c) :=
    (⟨Rat.mul_lt_mul_of_pos_right h.1 hc.1, Rat.mul_pos h.2 hc.1⟩ : RLTpos.lt ((a : Rat) * c) (b * c))

/-- `Rat` with the usual order except that `1` is the least element; lawful `<`: a linear order,
not translation invariant. -/
def R1 := Rat
abbrev R1.le (a b : Rat) : Prop := a = 1 ∨ (b ≠ 1 ∧ a ≤ b)
abbrev R1.lt (a b : Rat) : Prop := R1.le a b ∧ ¬ R1.le b a
instance : DecidableEq R1 := inferInstanceAs (DecidableEq Rat)
instance : Field R1 := inferInstanceAs (Field Rat)
instance : IsCharP R1 0 := inferInstanceAs (IsCharP Rat 0)
instance : LE R1 := ⟨R1.le⟩
instance : LT R1 := ⟨R1.lt⟩
instance : DecidableLE R1 := fun (a b : Rat) => inferInstanceAs (Decidable (R1.le a b))
instance : DecidableLT R1 := fun (a b : Rat) => inferInstanceAs (Decidable (R1.lt a b))
instance : IsLinearOrder R1 where
  le_refl a := by
    show R1.le a a
    by_cases h : (a : Rat) = 1
    · exact Or.inl h
    · exact Or.inr ⟨h, Rat.le_refl⟩
  le_trans a b c (h₁ : R1.le a b) (h₂ : R1.le b c) := by
    show R1.le a c
    rcases h₁ with h₁ | ⟨h₁, h₁'⟩
    · exact Or.inl h₁
    · rcases h₂ with h₂ | ⟨h₂, h₂'⟩
      · exact absurd h₂ h₁
      · by_cases ha : (a : Rat) = 1
        · exact Or.inl ha
        · exact Or.inr ⟨h₂, Rat.le_trans h₁' h₂'⟩
  le_antisymm a b (h₁ : R1.le a b) (h₂ : R1.le b a) := by
    show (a : Rat) = b
    rcases h₁ with h₁ | ⟨h₁, h₁'⟩ <;> rcases h₂ with h₂ | ⟨h₂, h₂'⟩
    · exact h₁.trans h₂.symm
    · exact absurd h₁ h₂
    · exact absurd h₂ h₁
    · exact Rat.le_antisymm h₁' h₂'
  le_total a b := by
    show R1.le a b ∨ R1.le b a
    by_cases ha : (a : Rat) = 1
    · exact Or.inl (Or.inl ha)
    · by_cases hb : (b : Rat) = 1
      · exact Or.inr (Or.inl hb)
      · rcases Rat.le_total (a := (a : Rat)) (b := b) with h | h
        · exact Or.inl (Or.inr ⟨hb, h⟩)
        · exact Or.inr (Or.inr ⟨ha, h⟩)
instance : LawfulOrderLT R1 where
  lt_iff _ _ := Iff.rfl

/-- The field with two elements (`inv := id`), of characteristic `2`, not `0`. -/
instance F2field : Field (Fin 2) where
  inv := id
  div := (· * ·)
  zpow := ⟨fun a n => a ^ n.natAbs⟩
  div_eq_mul_inv := by decide
  zero_ne_one := by decide
  inv_zero := by decide
  mul_inv_cancel := by decide
  zpow_zero a := Semiring.pow_zero a
  zpow_succ a n := Semiring.pow_succ a n
  zpow_neg a n := by show a ^ (-n).natAbs = a ^ n.natAbs; rw [Int.natAbs_neg]

instance decInvVarsOk {α : Type} [Field α] [DecidableEq α] (ctx : Context α) (invs : InvVars) :
    Decidable (invs.ok ctx) :=
  inferInstanceAs (Decidable (invs.denoteVars ctx = invs.denoteInvs))

noncomputable instance decInvAtomsOk {α : Type} [Ring α] [DecidableEq α] (ctx : Context α) (l : InvAtoms) :
    Decidable (InvAtoms.ok ctx l) :=
  List.rec (motive := fun l => Decidable (InvAtoms.ok ctx l)) (isTrue trivial)
    (fun yx _ ih => @instDecidableAnd (yx.2.denote ctx * yx.1.denote ctx = 1) _ inferInstance ih) l

theorem prop_ne {A B : Prop} [Decidable A] [Decidable B] (h : A = B) (hd : (decide A != decide B) = true) :
    False := by subst h; simp at hd


/-! ## Removable verdicts -/


theorem eq_of_zero_eq_one {α : Type u} [Semiring α] (h : (0 : α) = 1) (a b : α) : a = b := by
  rw [← Semiring.mul_one a, ← Semiring.mul_one b, ← h, Semiring.mul_zero, Semiring.mul_zero]

theorem zero_eq_one_of {α : Type u} [Ring α] {x : α} (h : ((0 : Int) : α) * x = 1) : (0 : α) = 1 := by
  rwa [Ring.intCast_zero, Semiring.zero_mul] at h

-- `Lean.Grind.CommRing.Poly.denote_cancelVar'` (hypothesis 7): removable. If c = 0, then c * x = 1 makes 0 = 1,
-- so the ring is trivial and the conclusion holds.
theorem denote_cancelVar'_h7 : drop% Lean.Grind.CommRing.Poly.denote_cancelVar' 7 := by
  intro α _ ctx p c x acc h₂
  by_cases hc : c = 0
  · subst hc; exact eq_of_zero_eq_one (zero_eq_one_of h₂) _ _
  · exact Poly.denote_cancelVar' ctx p c x acc hc h₂

-- `Lean.Grind.CommRing.Poly.denote_cancelVar` (hypothesis 6): removable, as above (c = 0 forces 0 = 1).
theorem denote_cancelVar_h6 : drop% Lean.Grind.CommRing.Poly.denote_cancelVar 6 := by
  intro α _ ctx p c x h₂
  by_cases hc : c = 0
  · subst hc; exact eq_of_zero_eq_one (zero_eq_one_of h₂) _ _
  · exact Poly.denote_cancelVar ctx p c x hc h₂

-- `Lean.Grind.CommRing.Poly.denoteList_cancelTerms_k` (hypothesis 6): removable, as above.
theorem denoteList_cancelTerms_k_h6 : drop% Lean.Grind.CommRing.Poly.denoteList_cancelTerms_k 6 := by
