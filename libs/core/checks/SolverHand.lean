-- order, and lhs - rhs = (lhs' - rhs') * d⁻¹ with d a positive numeral; in characteristic 0 a
-- translation-invariant linear order is preserved by that scaling (d • y and y have the same sign),
-- whatever the strict order is.
theorem le_normQ_expr_h5 : drop% Lean.Grind.CommRing.le_normQ_expr 5 := by
  intro α _ _ _ _ _ _ ctx bal invs hok ainvs hoka lhs rhs lhs' rhs' h
  obtain ⟨d, hd, h⟩ := denote_sub_of_normQ_cert' ctx bal invs hok ainvs hoka lhs rhs lhs' rhs' h
  apply propext
  rw [← sub_nonpos_iff', ← sub_nonpos_iff' (a := lhs'.denote ctx), h, mul_inv_nonpos_iff' hd]


