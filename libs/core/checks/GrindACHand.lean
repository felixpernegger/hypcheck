import Lean

/-!
Hand pass `GrindAC` (hand13): the 111 unresolved hypotheses of `Init.Grind.AC` (grind's AC
normalization certificates): `Std.Associative ctx.op`, `Std.Commutative ctx.op`,
`Std.LawfulIdentity ctx.op (Var.denote ctx 0)`, certificate premises and `Seq.denote` premises.

103 necessary, 8 removable, 0 independent.

Reusable models (contexts over `Nat`, `cx op vs` with variable `i` denoting `vs[i]`; all
certificates and denotations evaluate with `decide +kernel`):
* `opC a b = 2a+2b`: commutative (`opC_comm`), not associative.
* `opL a b = if a = 0 then b else a`: associative (`opL_assoc`), idempotent (`opL_idem`), identity 0
  (`opL_id`, needs `vs = 0 :: _`), not commutative (on nonzero values it is the left projection).
* `opI a b = if a = b then a else a+b+1`: commutative (`opI_comm`), idempotent (`opI_idem`), not
  associative (`0*(0*1) = 3 ≠ 0*1 = 2`).
* `opE a b = if a = 0 then b else if b = 0 then a else 2a+2b`: commutative (`opE_comm`), identity 0
  (`opE_id`), not associative.
* `opM = max`: associative, commutative, idempotent, identity 0 (`opM_*`); with `vs[0] ≠ 0` it has no
  identity at variable 0. Used for all certificate/premise drops.

Removable (8): associativity in the four `*_simp_*_suffix` lemmas (`head ++ s` denotes a function of
`s`'s denotation, `concat_congr`), in `Seq.denote_concat_of_endsWithVar` (only the innermost `x` is
duplicated), and in `eq_erase0`, `diseq_erase0`, `eq_erase0_rhs` (`Seq.denote_erase0` needs only
the identity law).

Necessary declarations are generated by `runs/hand13/scratch_GrindAC/gen.py`. `drop1%` sets all
universes to 1 (the carrier `α : Sort u` must be a type, so `drop0%` cannot be used).
Run with the lean4 repo's stage1 binary: `runs/hand13/lean.sh checks/GrindACHand.lean`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

open Lean Meta Elab Term in
/-- `drop% T i`: `T` with its (non-dependent) Prop binder `i` dropped, read off the library. -/
elab "drop% " T:ident i:num : term => do
  let n ← realizeGlobalConstNoOverloadWithInfo T
  let ci ← getConstInfo n
  let us ← ci.levelParams.mapM fun _ => mkFreshLevelMVar
  forallTelescope (ci.type.instantiateLevelParams ci.levelParams us) fun xs body => do
    let x := xs[i.getNat]!
    unless ← isProp (← inferType x) do throwError "binder {i.getNat} of {n} is not a Prop"
    for j in [i.getNat+1:xs.size] do
      if (← inferType xs[j]!).containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    if body.containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    mkForallFVars (xs.eraseIdx! i.getNat) body

open Lean Meta Elab Term in
/-- `drop1% T i`: like `drop% T i`, with all universes set to `1` (for refutations). -/
elab "drop1% " T:ident i:num : term => do
  let n ← realizeGlobalConstNoOverloadWithInfo T
  let ci ← getConstInfo n
  let us := ci.levelParams.map fun _ => Level.one
  forallTelescope (ci.type.instantiateLevelParams ci.levelParams us) fun xs body => do
    let x := xs[i.getNat]!
    unless ← isProp (← inferType x) do throwError "binder {i.getNat} of {n} is not a Prop"
    for j in [i.getNat+1:xs.size] do
      if (← inferType xs[j]!).containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    if body.containsFVar x.fvarId! then throwError "binder {i.getNat} of {n} is dependent"
    mkForallFVars (xs.eraseIdx! i.getNat) body

open Lean.Grind.AC

namespace GrindACHand

/-! ## Models -/

def mkVars : Nat → List Nat → Lean.RArray (PLift Nat)
  | _, [] => .leaf ⟨0⟩
  | k, a :: as => .branch (k+1) (.leaf ⟨a⟩) (mkVars (k+1) as)

/-- AC context over `Nat` with operation `op`; variable `i` denotes `vs[i]` (and `0` beyond). -/
def cx (op : Nat → Nat → Nat) (vs : List Nat) : Context Nat := ⟨mkVars 0 vs, op⟩

theorem cx_var0 (op : Nat → Nat → Nat) (vs : List Nat) : Var.denote (cx op (0 :: vs)) 0 = 0 := rfl

def opC (a b : Nat) : Nat := 2*a + 2*b
theorem opC_comm (vs) : Std.Commutative (cx opC vs).op := ⟨fun a b => by simp only [cx, opC]; omega⟩

def opL (a b : Nat) : Nat := if a = 0 then b else a
theorem opL_assoc (vs) : Std.Associative (cx opL vs).op :=
  ⟨fun a b c => by simp only [cx, opL]; split <;> simp_all⟩
theorem opL_idem (vs) : Std.IdempotentOp (cx opL vs).op :=
  ⟨fun a => by simp only [cx, opL]; split <;> simp_all⟩
theorem opL_id (vs) : Std.LawfulIdentity (cx opL (0 :: vs)).op (Var.denote (cx opL (0 :: vs)) 0) where
  left_id a := by rw [cx_var0]; simp [cx, opL]
  right_id a := by rw [cx_var0]; simp only [cx, opL]; split <;> simp_all

def opI (a b : Nat) : Nat := if a = b then a else a + b + 1
theorem opI_comm (vs) : Std.Commutative (cx opI vs).op :=
  ⟨fun a b => by simp only [cx, opI]; split <;> split <;> omega⟩
theorem opI_idem (vs) : Std.IdempotentOp (cx opI vs).op := ⟨fun a => by simp [cx, opI]⟩

def opE (a b : Nat) : Nat := if a = 0 then b else if b = 0 then a else 2*a + 2*b
theorem opE_comm (vs) : Std.Commutative (cx opE vs).op :=
  ⟨fun a b => by simp only [cx, opE]; split <;> split <;> (try split) <;> (try split) <;> omega⟩
theorem opE_id (vs) : Std.LawfulIdentity (cx opE (0 :: vs)).op (Var.denote (cx opE (0 :: vs)) 0) where
  left_id a := by rw [cx_var0]; simp [cx, opE]
  right_id a := by rw [cx_var0]; simp only [cx, opE]; split <;> simp_all

def opM (a b : Nat) : Nat := max a b
theorem opM_assoc (vs) : Std.Associative (cx opM vs).op := ⟨fun a b c => by simp only [cx, opM]; omega⟩
theorem opM_comm (vs) : Std.Commutative (cx opM vs).op := ⟨fun a b => by simp only [cx, opM]; omega⟩
theorem opM_idem (vs) : Std.IdempotentOp (cx opM vs).op := ⟨fun a => by simp only [cx, opM]; omega⟩
theorem opM_id (vs) : Std.LawfulIdentity (cx opM (0 :: vs)).op (Var.denote (cx opM (0 :: vs)) 0) where
  left_id a := by rw [cx_var0]; simp only [cx, opM]; omega
  right_id a := by rw [cx_var0]; simp only [cx, opM]; omega

/-! ## Removable -/

-- Helper: concatenating a fixed head preserves equal denotations (no associativity).
theorem concat_congr {α : Sort u} (ctx : Context α) (head : Seq) {s₁ s₂ : Seq}
    (h : s₁.denote ctx = s₂.denote ctx) : (head.concat_k s₁).denote ctx = (head.concat_k s₂).denote ctx := by
  induction head with
  | var x => exact congrArg (ctx.op (x.denote ctx)) h
  | cons x s ih => exact congrArg (ctx.op (x.denote ctx)) ih

-- Helper: reading off the suffix certificate.
theorem suffix_cert_eq {lhs rhs head s s' : Seq} (h : simp_suffix_cert lhs rhs head s s' = true) :
    s = head.concat_k lhs ∧ s' = head.concat_k rhs := by
  simpa [simp_suffix_cert, Seq.beq'_eq] using h

-- `Lean.Grind.AC.eq_simp_lhs_suffix`: without hypothesis 2 (associativity). Removable: the denotation of head ++ s is a function of the denotation of s (right-nested product), so lhs₁ = rhs₁ transfers without associativity.
theorem eq_simp_lhs_suffix_h2 : drop% Lean.Grind.AC.eq_simp_lhs_suffix 2 := by
  intro α ctx lhs₁ rhs₁ head lhs₂ rhs₂ lhs₂' hc h1 h2
  obtain ⟨rfl, rfl⟩ := suffix_cert_eq hc
  rw [← h2]; exact (concat_congr ctx head h1).symm

-- `Lean.Grind.AC.eq_simp_rhs_suffix`: without hypothesis 2 (associativity). Removable: same argument as for the lhs version.
theorem eq_simp_rhs_suffix_h2 : drop% Lean.Grind.AC.eq_simp_rhs_suffix 2 := by
  intro α ctx lhs₁ rhs₁ head lhs₂ rhs₂ rhs₂' hc h1 h2
  obtain ⟨rfl, rfl⟩ := suffix_cert_eq hc
  rw [h2]; exact concat_congr ctx head h1

-- `Lean.Grind.AC.diseq_simp_lhs_suffix`: without hypothesis 2 (associativity). Removable: same argument as for the eq version.
theorem diseq_simp_lhs_suffix_h2 : drop% Lean.Grind.AC.diseq_simp_lhs_suffix 2 := by
  intro α ctx lhs₁ rhs₁ head lhs₂ rhs₂ lhs₂' hc h1 h2
  obtain ⟨rfl, rfl⟩ := suffix_cert_eq hc
  rwa [← concat_congr ctx head h1]

-- `Lean.Grind.AC.diseq_simp_rhs_suffix`: without hypothesis 2 (associativity). Removable: same argument as for the eq version.
theorem diseq_simp_rhs_suffix_h2 : drop% Lean.Grind.AC.diseq_simp_rhs_suffix 2 := by
  intro α ctx lhs₁ rhs₁ head lhs₂ rhs₂ rhs₂' hc h1 h2
  obtain ⟨rfl, rfl⟩ := suffix_cert_eq hc
  rwa [← concat_congr ctx head h1]

-- `Lean.Grind.AC.Seq.denote_concat_of_endsWithVar`: without hypothesis 2 (associativity). Removable: appending x to a sequence ending in x only turns the innermost x into x*x = x.
theorem denote_concat_of_endsWithVar_h2 : drop% Lean.Grind.AC.Seq.denote_concat_of_endsWithVar 2 := by
  intro α ctx inst s x h
  induction s with
  | var y =>
    have : x = y := by simpa [Seq.endsWithVar_k] using h
    subst this; exact Std.IdempotentOp.idempotent _
  | cons y s ih => exact congrArg (ctx.op (y.denote ctx)) (ih h)

-- Helper: reading off the erase0 certificate.
theorem erase0_cert_eq {lhs rhs s s' : Seq} (h : eq_erase0_cert lhs rhs s s' = true) :
    lhs.erase0 = s ∧ rhs.erase0 = s' := by
  simp only [eq_erase0_cert, Bool.and_eq_true, Seq.beq'_eq, decide_eq_true_eq] at h; exact h

-- `Lean.Grind.AC.eq_erase0`: without hypothesis 2 (associativity). Removable: denote_erase0 needs only the identity law, not associativity.
theorem eq_erase0_h2 : drop% Lean.Grind.AC.eq_erase0 2 := by
  intro α ctx inst lhs rhs lhs' rhs' hc h
  obtain ⟨rfl, rfl⟩ := erase0_cert_eq hc
  rwa [Seq.denote_erase0, Seq.denote_erase0]

-- `Lean.Grind.AC.diseq_erase0`: without hypothesis 2 (associativity). Removable: denote_erase0 needs only the identity law, not associativity.
theorem diseq_erase0_h2 : drop% Lean.Grind.AC.diseq_erase0 2 := by
  intro α ctx inst lhs rhs lhs' rhs' hc h
  obtain ⟨rfl, rfl⟩ := erase0_cert_eq hc
  rwa [Seq.denote_erase0, Seq.denote_erase0]

-- `Lean.Grind.AC.eq_erase0_rhs`: without hypothesis 2 (associativity). Removable: denote_erase0 needs only the identity law, not associativity.
theorem eq_erase0_rhs_h2 : drop% Lean.Grind.AC.eq_erase0_rhs 2 := by
  intro α ctx inst lhs rhs rhs' hc h
  simp only [Seq.beq'_eq, decide_eq_true_eq] at hc
  subst hc; rwa [Seq.denote_erase0]

/-! ## Necessary -/

-- `Lean.Grind.AC.Seq.denote_sort`: without hypothesis 2 (Std.Associative ctx.op). opC = 2a+2b (commutative, not associative), x = 1,0,0: s = x2*(x1*x0) = 4, sorted x0*(x1*x2) = 2.
theorem Seq_denote_sort_h2 : ¬ (drop1% Lean.Grind.AC.Seq.denote_sort 2) := fun h =>
  absurd (@h Nat (cx opC [1,0,0]) (opC_comm _) (.cons 2 (.cons 1 (.var 0)))) (by decide +kernel)

-- `Lean.Grind.AC.Seq.denote_eraseDup`: without hypothesis 2 (Std.Associative ctx.op). opI a b = if a = b then a else a+b+1 (commutative, idempotent, not associative), x = 0,1: s = x0*(x0*x1) = 3, eraseDup s = x0*x1 = 2.
theorem Seq_denote_eraseDup_h2 : ¬ (drop1% Lean.Grind.AC.Seq.denote_eraseDup 2) := fun h =>
  absurd (@h Nat (cx opI [0,1]) (opI_idem _) (.cons 0 (.cons 0 (.var 1)))) (by decide +kernel)

-- `Lean.Grind.AC.eq_simp_lhs_prefix`: without hypothesis 2 (Std.Associative ctx.op). opC = 2a+2b (commutative, not associative): lhs₁ = [x0,x1], rhs₁ = x2 := x0*x1, tail = x3; the certificate's lhs₁++tail denotes x0*(x1*x3) but rhs₁++tail denotes (x0*x1)*x3.
theorem eq_simp_lhs_prefix_h2 : ¬ (drop1% Lean.Grind.AC.eq_simp_lhs_prefix 2) := fun h =>
  absurd (@h Nat (cx opC [0,0,0,1]) (.cons 0 (.var 1)) (.var 2) (.var 3) (.cons 0 (.cons 1 (.var 3))) (.cons 0 (.cons 1 (.var 3))) (.cons 2 (.var 3)) (by decide +kernel) (by decide +kernel) (by decide +kernel)) (by decide +kernel)

-- `Lean.Grind.AC.eq_simp_lhs_prefix`: without hypothesis 10 (Lean.Grind.AC.Seq.denote ctx lhs₁ = Lean.Grind.AC.Seq.denote ctx rhs₁). max on Nat with x0 = 0, x1 = 1: lhs₁ = x0, rhs₁ = x1 denote differently, so replacing lhs₁ by rhs₁ changes the value.
