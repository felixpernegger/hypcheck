/-- `NEq`: `Nat` with `succ? n = n + 1`, `succMany? k n = n + k` (lawful, infinite, injective);
`≤`, `<` are equality (neither `LawfulUpwardEnumerableLE` nor `…LT`). -/
structure NEq where
  n : Nat
deriving DecidableEq
instance : UpwardEnumerable NEq :=
  { succ? := fun a => some ⟨a.n + 1⟩, succMany? := fun k a => some ⟨a.n + k⟩ }
instance : LawfulUpwardEnumerable NEq where
  ne_of_lt a b := fun ⟨k, h⟩ e => by
    subst e; cases a; change some (NEq.mk _) = some (NEq.mk _) at h; simp only [Option.some.injEq, NEq.mk.injEq] at h; omega
  succMany?_zero _ := rfl
  succMany?_add_one n a := by
    change some (NEq.mk _) = some (NEq.mk _); simp only [Option.some.injEq, NEq.mk.injEq]; omega
instance : InfinitelyUpwardEnumerable NEq := ⟨fun _ => rfl⟩
instance : LinearlyUpwardEnumerable NEq := ⟨fun a b h => by
  cases a; cases b; simp only [succ?, Option.some.injEq, NEq.mk.injEq] at h ⊢; omega⟩
theorem NEq.ueLE_iff {a b : NEq} : UpwardEnumerable.LE a b ↔ a.n ≤ b.n := by
  constructor
  · rintro ⟨k, h⟩; change some (NEq.mk _) = some b at h; cases h; dsimp only; omega
  · intro h; refine ⟨b.n - a.n, ?_⟩; change some (NEq.mk _) = some b
    congr; cases b; dsimp only at h ⊢; congr 1; omega
theorem NEq.ueLT_iff {a b : NEq} : UpwardEnumerable.LT a b ↔ a.n < b.n := by
  constructor
  · rintro ⟨k, h⟩; change some (NEq.mk _) = some b at h; cases h; dsimp only; omega
  · intro h; refine ⟨b.n - a.n - 1, ?_⟩; change some (NEq.mk _) = some b
    congr; cases b; dsimp only at h ⊢; congr 1; omega
instance : LE NEq := ⟨fun a b => a.n = b.n⟩
instance : LT NEq := ⟨fun a b => a.n = b.n⟩
instance : DecidableLE NEq := fun a b => inferInstanceAs (Decidable (a.n = b.n))
instance : DecidableLT NEq := fun a b => inferInstanceAs (Decidable (a.n = b.n))

