/-! ### Non-lawful models for the instance lemmas -/

/-- `NM`: `Nat`, `succ? n = n + 1`, `succMany?` constantly `none` (so every `IsAlwaysFinite`
holds at step `0`); `≤`, `<` always true. The range iterators never end. -/
structure NM where
  n : Nat
deriving DecidableEq
instance : UpwardEnumerable NM := { succ? := fun a => some ⟨a.n + 1⟩, succMany? := fun _ _ => none }
instance : LE NM := ⟨fun _ _ => True⟩
instance : LT NM := ⟨fun _ _ => True⟩
instance : DecidableLE NM := fun _ _ => instDecidableTrue
instance : DecidableLT NM := fun _ _ => instDecidableTrue
instance : Rxc.IsAlwaysFinite NM := ⟨fun _ _ => ⟨0, trivial⟩⟩
instance : Rxo.IsAlwaysFinite NM := ⟨fun _ _ => ⟨0, trivial⟩⟩
instance : Rxi.IsAlwaysFinite NM := ⟨fun _ => ⟨0, rfl⟩⟩

/-- `NSh`: `Nat`, `succ? n = n + 1`, but `succMany? k n = n + k + 1` (shifted, `succMany? 0 a ≠ a`);
`a ≤ b` is `a < b` and `a < b` is `a + 2 ≤ b`, so `LawfulUpwardEnumerableLE/LT` hold. -/
structure NSh where
  n : Nat
deriving DecidableEq
instance : UpwardEnumerable NSh :=
  { succ? := fun a => some ⟨a.n + 1⟩, succMany? := fun k a => some ⟨a.n + k + 1⟩ }
instance : LE NSh := ⟨fun a b => a.n < b.n⟩
instance : LT NSh := ⟨fun a b => a.n + 2 ≤ b.n⟩
instance : DecidableLE NSh := fun a b => inferInstanceAs (Decidable (a.n < b.n))
instance : DecidableLT NSh := fun a b => inferInstanceAs (Decidable (a.n + 2 ≤ b.n))
instance : LawfulUpwardEnumerableLE NSh where
  le_iff a b := by
    constructor
    · intro h; refine ⟨b.n - a.n - 1, ?_⟩; change some (NSh.mk _) = some b
      cases b; change a.n < _ at h; dsimp only at h ⊢; congr 2; omega
    · rintro ⟨k, h⟩; change some (NSh.mk _) = some b at h; cases h; show a.n < _; dsimp only; omega
instance : LawfulUpwardEnumerableLT NSh where
  lt_iff a b := by
    constructor
    · intro h; refine ⟨b.n - a.n - 2, ?_⟩; change some (NSh.mk _) = some b
      cases b; change a.n + 2 ≤ _ at h; dsimp only at h ⊢; congr 2; omega
    · rintro ⟨k, h⟩; change some (NSh.mk _) = some b at h; cases h; show a.n + 2 ≤ _; dsimp only; omega
theorem NSh.not_eq (k : Nat) (a : NSh) : succMany? k a ≠ some a := fun h => by
  change some (NSh.mk _) = some a at h; cases a; simp only [Option.some.injEq, NSh.mk.injEq] at h; omega

/-- `Stuck`: one point, `succ? = none`, but `succMany?` constantly `some pt`; `≤`, `<` always true,
all sizes `1` (lawful), but no range is finite. -/
inductive Stuck | pt deriving DecidableEq
instance : UpwardEnumerable Stuck := { succ? := fun _ => none, succMany? := fun _ a => some a }
instance : LE Stuck := ⟨fun _ _ => True⟩
instance : LT Stuck := ⟨fun _ _ => True⟩
instance : Rxc.HasSize Stuck := ⟨fun _ _ => 1⟩
instance : Rxo.HasSize Stuck := ⟨fun _ _ => 1⟩
instance : Rxi.HasSize Stuck := ⟨fun _ => 1⟩
instance : Rxc.LawfulHasSize Stuck := ⟨fun _ _ h => (h trivial).elim, fun _ _ _ _ => rfl, fun _ _ _ _ h => nomatch h⟩
instance : Rxo.LawfulHasSize Stuck := ⟨fun _ _ h => (h trivial).elim, fun _ _ _ _ => rfl, fun _ _ _ _ h => nomatch h⟩
instance : Rxi.LawfulHasSize Stuck := ⟨fun _ _ => rfl, fun _ _ h => nomatch h⟩
theorem Stuck.not_rxc : ¬ Rxc.IsAlwaysFinite Stuck := fun h => by
  obtain ⟨n, hn⟩ := h.finite .pt .pt; exact hn trivial
theorem Stuck.not_rxo : ¬ Rxo.IsAlwaysFinite Stuck := fun h => by
  obtain ⟨n, hn⟩ := h.finite .pt .pt; exact hn trivial
theorem Stuck.not_rxi : ¬ Rxi.IsAlwaysFinite Stuck := fun h => by
  obtain ⟨n, hn⟩ := h.finite .pt; cases hn

/-- `Jump`: two points `p ≤ q` without successors, but `succMany? 1 p = some q` (not lawful);
`≤` is reachability (`LawfulUpwardEnumerableLE`), a partial order, `<` strict; `Rxc` size
`1` if `lo ≤ hi`, else `0` (lawful). -/
inductive Jump | p | q deriving DecidableEq
instance : UpwardEnumerable Jump :=
  { succ? := fun _ => none,
    succMany? := fun n x => if n = 0 then some x else if n = 1 ∧ x = .p then some .q else none }
def Jump.le : Jump → Jump → Bool | .q, .p => false | _, _ => true
instance : LE Jump := ⟨fun a b => a.le b⟩
instance : LT Jump := ⟨fun a b => a.le b ∧ ¬ b.le a⟩
instance : DecidableLE Jump := fun a b => inferInstanceAs (Decidable (a.le b = true))
instance : DecidableLT Jump := fun a b => inferInstanceAs (Decidable (a.le b ∧ ¬ b.le a))
instance : LawfulOrderLT Jump := ⟨fun _ _ => Iff.rfl⟩
instance : IsPartialOrder Jump where
  le_refl a := by cases a <;> decide
  le_trans a b c := by cases a <;> cases b <;> cases c <;> decide
  le_antisymm a b := by cases a <;> cases b <;> decide
instance : LawfulUpwardEnumerableLE Jump where
  le_iff a b := by
    constructor
    · intro h; cases a <;> cases b
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
      · exact absurd h (by decide)
      · exact ⟨0, rfl⟩
    · rintro ⟨n, h⟩
      change (if n = 0 then some a else if n = 1 ∧ a = .p then some .q else none) = some b at h
      split at h
      · cases h; cases a <;> decide
      · split at h
        · cases h; rename_i h2; rw [h2.2]; decide
        · cases h
instance : Rxc.HasSize Jump := ⟨fun lo hi => if lo.le hi then 1 else 0⟩
instance : Rxc.LawfulHasSize Jump where
  size_eq_zero_of_not_le lo hi h := by
    show (if lo.le hi then 1 else 0) = 0; exact if_neg h
  size_eq_one_of_succ?_eq_none lo hi h _ := by
    show (if lo.le hi then 1 else 0) = 1; exact if_pos h
  size_eq_succ_of_succ?_eq_some _ _ _ _ h := nomatch h

/-- `Two0`: two points `p ≤ q` without successors (lawful), but `p ≤ q` is not reachability;
`<` strict, partial order, `Rxc` size `1` if `lo ≤ hi`, else `0` (lawful). -/
inductive Two0 | p | q deriving DecidableEq
instance : UpwardEnumerable Two0 :=
  { succ? := fun _ => none, succMany? := fun n x => if n = 0 then some x else none }
instance : LawfulUpwardEnumerable Two0 where
  ne_of_lt _ _ := fun ⟨_, h⟩ => nomatch h
  succMany?_zero _ := rfl
  succMany?_add_one n a := by cases n <;> rfl
def Two0.le : Two0 → Two0 → Bool | .q, .p => false | _, _ => true
instance : LE Two0 := ⟨fun a b => a.le b⟩
instance : LT Two0 := ⟨fun a b => a.le b ∧ ¬ b.le a⟩
instance : DecidableLE Two0 := fun a b => inferInstanceAs (Decidable (a.le b = true))
instance : DecidableLT Two0 := fun a b => inferInstanceAs (Decidable (a.le b ∧ ¬ b.le a))
instance : LawfulOrderLT Two0 := ⟨fun _ _ => Iff.rfl⟩
instance : IsPartialOrder Two0 where
  le_refl a := by cases a <;> decide
  le_trans a b c := by cases a <;> cases b <;> cases c <;> decide
  le_antisymm a b := by cases a <;> cases b <;> decide
instance : Rxc.HasSize Two0 := ⟨fun lo hi => if lo.le hi then 1 else 0⟩
instance : Rxc.LawfulHasSize Two0 where
  size_eq_zero_of_not_le lo hi h := by
    show (if lo.le hi then 1 else 0) = 0; exact if_neg h
  size_eq_one_of_succ?_eq_none lo hi h _ := by
    show (if lo.le hi then 1 else 0) = 1; exact if_pos h
  size_eq_succ_of_succ?_eq_some _ _ _ _ h := nomatch h

/-! ### Explicit instances on `Unit` (passed with `@`) -/

set_option warn.classDefReducibility false

def ueN : UpwardEnumerable Unit := ⟨fun _ => none, fun n a => if n = 0 then some a else none⟩
def ueS : UpwardEnumerable Unit := ⟨fun a => some a, fun _ a => some a⟩
def leT : LE Unit := ⟨fun _ _ => True⟩
def leF : LE Unit := ⟨fun _ _ => False⟩
def ltT : LT Unit := ⟨fun _ _ => True⟩
def ltF : LT Unit := ⟨fun _ _ => False⟩
def rxcSz (k : Nat) : Rxc.HasSize Unit := ⟨fun _ _ => k⟩
def rxoSz (k : Nat) : Rxo.HasSize Unit := ⟨fun _ _ => k⟩
def rxiSz (k : Nat) : Rxi.HasSize Unit := ⟨fun _ => k⟩
def lsS : Least? Unit := ⟨some ()⟩
def lsN : Least? Unit := ⟨none⟩

/-- The identity `UpwardEnumerable.Map`. -/
def idMap (α : Type) [UpwardEnumerable α] : UpwardEnumerable.Map α α :=
  ⟨id, fun _ _ h => h, fun _ => Option.map_id'.symm, fun _ _ => Option.map_id'.symm⟩

theorem not_wf_of_chain {β : Sort _} {r : β → β → Prop} (f : Nat → β) (hf : ∀ n, r (f (n + 1)) (f n)) :
    ¬ WellFounded r := by
  intro wf
  have : ∀ x, Acc r x → ∀ n, f n ≠ x := by
    intro x hx
    induction hx with
    | intro x _ ih => intro n e; subst e; exact ih _ (hf n) (n + 1) rfl
  exact this _ (wf.apply (f 0)) 0 rfl

-- `IsPartialOrder` follows from `LawfulUpwardEnumerable` + `LawfulUpwardEnumerableLE`.
theorem partialOrder_of_lawful {α : Type u} [LE α] [UpwardEnumerable α] [LawfulUpwardEnumerable α]
    [LawfulUpwardEnumerableLE α] : IsPartialOrder α where
  le_refl a := UpwardEnumerable.le_iff.2 (UpwardEnumerable.le_refl a)
  le_trans a b c h1 h2 := UpwardEnumerable.le_iff.2
    (UpwardEnumerable.le_trans (UpwardEnumerable.le_iff.1 h1) (UpwardEnumerable.le_iff.1 h2))
  le_antisymm a b h1 h2 := by
    rcases UpwardEnumerable.le_iff_lt_or_eq.1 (UpwardEnumerable.le_iff.1 h1) with h | h
    · exact absurd (UpwardEnumerable.lt_of_lt_of_le h (UpwardEnumerable.le_iff.1 h2))
        UpwardEnumerable.lt_irrefl
    · exact h

def ltF' : LT Cyc1 := ⟨fun _ _ => False⟩
def leTV : LE V := ⟨fun _ _ => True⟩
def ueB : UpwardEnumerable Bool := ⟨fun _ => none, fun n a => if n = 0 then some a else none⟩
def leB : LE Bool := ⟨fun a b => (!a || b) = true⟩
def ltB : LT Bool := ⟨fun a b => (!a && b) = true⟩
def leTB : LE Bool := ⟨fun _ _ => True⟩
def ltFB : LT Bool := ⟨fun _ _ => False⟩
-- Lawfulness proofs for the explicit instances (built with `@…mk`, since anonymous constructors
-- would synthesize the class arguments instead).
theorem lolB : @LawfulOrderLT Bool ltB leB := @LawfulOrderLT.mk Bool ltB leB fun a b => by
  show ((!a && b) = true) ↔ ((!a || b) = true ∧ ¬ (!b || a) = true); cases a <;> cases b <;> decide
theorem lolBF : @LawfulOrderLT Bool ltFB leTB :=
  @LawfulOrderLT.mk Bool ltFB leTB fun _ _ => ⟨False.elim, fun h => h.2 trivial⟩
theorem lolUF : @LawfulOrderLT Unit ltF leT :=
  @LawfulOrderLT.mk Unit ltF leT fun _ _ => ⟨False.elim, fun h => h.2 trivial⟩
theorem lolCyc : @LawfulOrderLT Cyc1 ltF' Cyc1.instLE :=
  @LawfulOrderLT.mk Cyc1 ltF' Cyc1.instLE fun _ _ => ⟨False.elim, fun h => h.2 trivial⟩
theorem totV : @Std.Total V (fun a b => @LE.le V leTV a b) := ⟨fun _ _ => Or.inl trivial⟩
theorem presLE (α : Type) (ue : UpwardEnumerable α) (le : LE α) :
    @UpwardEnumerable.Map.PreservesLE α α ue ue le le (@idMap α ue) :=
  @UpwardEnumerable.Map.PreservesLE.mk α α ue ue le le _ Iff.rfl
theorem presLT (α : Type) (ue : UpwardEnumerable α) (lt : LT α) :
    @UpwardEnumerable.Map.PreservesLT α α ue ue lt lt (@idMap α ue) :=
  @UpwardEnumerable.Map.PreservesLT.mk α α ue ue lt lt _ Iff.rfl
theorem presRxc (k : Nat) : @UpwardEnumerable.Map.PreservesRxcSize Unit Unit ueN ueN (rxcSz k) (rxcSz k) (@idMap Unit ueN) :=
  @UpwardEnumerable.Map.PreservesRxcSize.mk Unit Unit ueN ueN (rxcSz k) (rxcSz k) _ rfl
theorem presRxo (k : Nat) : @UpwardEnumerable.Map.PreservesRxoSize Unit Unit ueN ueN (rxoSz k) (rxoSz k) (@idMap Unit ueN) :=
  @UpwardEnumerable.Map.PreservesRxoSize.mk Unit Unit ueN ueN (rxoSz k) (rxoSz k) _ rfl
theorem presRxi (k : Nat) : @UpwardEnumerable.Map.PreservesRxiSize Unit Unit ueN ueN (rxiSz k) (rxiSz k) (@idMap Unit ueN) :=
  @UpwardEnumerable.Map.PreservesRxiSize.mk Unit Unit ueN ueN (rxiSz k) (rxiSz k) _ rfl
theorem presLeastN : @UpwardEnumerable.Map.PreservesLeast? Unit Unit ueN ueN lsN lsN (@idMap Unit ueN) :=
  @UpwardEnumerable.Map.PreservesLeast?.mk Unit Unit ueN ueN lsN lsN _ rfl
theorem lleUT : @LawfulUpwardEnumerableLE Unit ueN leT :=
  @LawfulUpwardEnumerableLE.mk Unit ueN leT fun _ _ => ⟨fun _ => ⟨0, rfl⟩, fun _ => trivial⟩
theorem lltUT : @LawfulUpwardEnumerableLT Unit ueS ltT :=
  @LawfulUpwardEnumerableLT.mk Unit ueS ltT fun _ _ => ⟨fun _ => ⟨0, rfl⟩, fun _ => trivial⟩
theorem llsU : @LawfulUpwardEnumerableLeast? Unit ueN lsS :=
