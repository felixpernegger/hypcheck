theorem rxcL1 : @Rxc.LawfulHasSize Unit leT ueN (rxcSz 1) :=
  @Rxc.LawfulHasSize.mk Unit leT ueN (rxcSz 1) (fun _ _ h => (h trivial).elim) (fun _ _ _ _ => rfl)
    (fun _ _ _ _ h => nomatch h)
