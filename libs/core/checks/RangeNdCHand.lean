section Chain
variable {α : Type u} [UpwardEnumerable α] [LawfulUpwardEnumerable α]

theorem rxc_toList_eq_match [LE α] [DecidableLE α] [Rxc.IsAlwaysFinite α]
    {it : Iter (α := Rxc.Iterator α) α} :
    it.toList = match it.internalState.next with
      | none => []
      | some a => if a ≤ it.internalState.upperBound then
          a :: (⟨⟨UpwardEnumerable.succ? a, it.internalState.upperBound⟩⟩ : Iter (α := Rxc.Iterator α) α).toList
        else [] := by
  apply Eq.symm
  rw [Iter.toList_eq_match_step, Rxc.Iterator.step_eq_step]
  simp only [Rxc.Iterator.step]
  split <;> rename_i heq
  · simp [*]
  · split <;> rename_i heq' <;> simp [*]

theorem rxo_toList_eq_match [LT α] [DecidableLT α] [Rxo.IsAlwaysFinite α]
    {it : Iter (α := Rxo.Iterator α) α} :
    it.toList = match it.internalState.next with
      | none => []
      | some a => if a < it.internalState.upperBound then
          a :: (⟨⟨UpwardEnumerable.succ? a, it.internalState.upperBound⟩⟩ : Iter (α := Rxo.Iterator α) α).toList
        else [] := by
  apply Eq.symm
  simp only [Iter.toList_eq_match_step (it := it), Rxo.Iterator.step_eq_step, Rxo.Iterator.step]
  split <;> rename_i heq
  · simp [*]
  · split <;> rename_i heq' <;> simp [*]

theorem rxc_chain [LE α] [DecidableLE α] [Rxc.IsAlwaysFinite α]
    (it : Iter (α := Rxc.Iterator α) α) :
    ∀ i x, it.toList[i]? = some x → it.internalState.next.bind (succMany? i ·) = some x := by
  induction it using Iter.inductSteps with | step it ihy ihs
  intro i x hx
  rw [rxc_toList_eq_match] at hx
  split at hx
  · simp at hx
  · rename_i a ha
    split at hx
    · cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at hx
        subst hx; simp [ha, UpwardEnumerable.succMany?_zero]
      | succ k =>
        simp only [List.getElem?_cons_succ] at hx
        have := ihy (it' := ⟨⟨succ? a, it.internalState.upperBound⟩⟩) (out := a)
          (by simp_all [Rxc.Iterator.isPlausibleStep_iff, Rxc.Iterator.step]) k x hx
        rw [ha, Option.bind_some, UpwardEnumerable.succMany?_add_one_eq_succ?_bind_succMany?]
        exact this
    · simp at hx

theorem rxo_chain [LT α] [DecidableLT α] [Rxo.IsAlwaysFinite α]
    (it : Iter (α := Rxo.Iterator α) α) :
    ∀ i x, it.toList[i]? = some x → it.internalState.next.bind (succMany? i ·) = some x := by
  induction it using Iter.inductSteps with | step it ihy ihs
  intro i x hx
  rw [rxo_toList_eq_match] at hx
  split at hx
  · simp at hx
  · rename_i a ha
    split at hx
    · cases i with
      | zero =>
        simp only [List.getElem?_cons_zero, Option.some.injEq] at hx
        subst hx; simp [ha, UpwardEnumerable.succMany?_zero]
      | succ k =>
        simp only [List.getElem?_cons_succ] at hx
        have := ihy (it' := ⟨⟨succ? a, it.internalState.upperBound⟩⟩) (out := a)
          (by simp_all [Rxo.Iterator.isPlausibleStep_iff, Rxo.Iterator.step]) k x hx
        rw [ha, Option.bind_some, UpwardEnumerable.succMany?_add_one_eq_succ?_bind_succMany?]
        exact this
    · simp at hx

theorem chain_pairwise {l : List α} {s : Option α}
    (h : ∀ i x, l[i]? = some x → s.bind (succMany? i ·) = some x) :
    l.Pairwise (fun a b => UpwardEnumerable.LT a b) := by
  rw [List.pairwise_iff_getElem]
  intro i j hi hj hij
  have h1 := h i _ (List.getElem?_eq_getElem hi)
  have h2 := h j _ (List.getElem?_eq_getElem hj)
  cases s with
  | none => simp at h1
  | some s0 =>
    simp only [Option.bind_some] at h1 h2
    refine ⟨j - i - 1, ?_⟩
    have e : succMany? (i + (j - i - 1 + 1)) s0 = some l[j] := by
      rw [show i + (j - i - 1 + 1) = j by omega]; exact h2
    rw [UpwardEnumerable.succMany?_add, h1, Option.bind_some] at e
    exact e

omit [LawfulUpwardEnumerable α] in
theorem chain_isSome {l : List α} {s : Option α}
    (h : ∀ i x, l[i]? = some x → s.bind (succMany? i ·) = some x) {i : Nat} (hi : i < l.length) :
    (s.bind (succMany? i ·)).isSome := by
  rw [h i _ (List.getElem?_eq_getElem hi)]; rfl

end Chain

/-! ### Unfolding `toList` from `Finite` alone (no `LawfulUpwardEnumerable`)

The library's proofs of `Rxc/Rxo/Rxi.Iterator.toList_eq_match` with the `Finite` instance taken as
an argument; used to evaluate ranges of non-lawful models whose iterator is finite. -/

theorem rxc_tl {α : Type u} [UpwardEnumerable α] [LE α] [DecidableLE α]
    [Iterators.Finite (Rxc.Iterator α) Id] {it : Iter (α := Rxc.Iterator α) α} :
    it.toList = match it.internalState.next with
      | none => []
      | some a => if a ≤ it.internalState.upperBound then
          a :: (⟨⟨UpwardEnumerable.succ? a, it.internalState.upperBound⟩⟩ : Iter (α := Rxc.Iterator α) α).toList
        else [] := by
  apply Eq.symm
  rw [Iter.toList_eq_match_step, Rxc.Iterator.step_eq_step]
  simp only [Rxc.Iterator.step]
  split <;> rename_i heq
  · simp [*]
  · split <;> rename_i heq' <;> simp [*]

theorem rxo_tl {α : Type u} [UpwardEnumerable α] [LT α] [DecidableLT α]
    [Iterators.Finite (Rxo.Iterator α) Id] {it : Iter (α := Rxo.Iterator α) α} :
    it.toList = match it.internalState.next with
      | none => []
      | some a => if a < it.internalState.upperBound then
          a :: (⟨⟨UpwardEnumerable.succ? a, it.internalState.upperBound⟩⟩ : Iter (α := Rxo.Iterator α) α).toList
        else [] := by
  apply Eq.symm
  simp only [Iter.toList_eq_match_step (it := it), Rxo.Iterator.step_eq_step, Rxo.Iterator.step]
  split <;> rename_i heq
  · simp [*]
  · split <;> rename_i heq' <;> simp [*]

theorem rxi_tl {α : Type u} [UpwardEnumerable α]
    [Iterators.Finite (Rxi.Iterator α) Id] {it : Iter (α := Rxi.Iterator α) α} :
    it.toList = match it.internalState.next with
      | none => []
      | some a => a :: (⟨⟨UpwardEnumerable.succ? a⟩⟩ : Iter (α := Rxi.Iterator α) α).toList := by
  apply Eq.symm
  simp only [Iter.toList_eq_match_step (it := it), Rxi.Iterator.step_eq_step, Rxi.Iterator.step]
  split <;> rename_i heq <;> simp [*]

/-! ### Models whose range iterators are finite although they are not lawful

Their `succ?` agrees with a lawful twin instance (`succMany?` = iterated `succ?`), and the
iterators only use `succ?` and `≤`/`<`, so `Finite` is the library's `instFinite` for the twin. -/

def PF.f (n : Nat) : Nat := if n < 2 then 2 else n + 3

/-- `PF`: `Nat`, `succ? n = n + 1`, `succMany? k n = some (f n)` for `k ≤ 1` (`f 0 = f 1 = 2`,
`f n = n + 3` above), `none` for `k ≥ 2`; `a ≤ b` and `a < b` are both `b = f a`
(`LawfulUpwardEnumerableLE/LT`, `Rxc/Rxo.IsAlwaysFinite`). Not lawful: `LT 0 1` fails. -/
structure PF where
  n : Nat
deriving DecidableEq
def PF.next (a : PF) : Option PF := some ⟨a.n + 1⟩
instance : UpwardEnumerable PF :=
  { succ? := PF.next, succMany? := fun k a => if k ≤ 1 then some ⟨PF.f a.n⟩ else none }
instance : LE PF := ⟨fun a b => b.n = PF.f a.n⟩
instance : LT PF := ⟨fun a b => b.n = PF.f a.n⟩
instance : DecidableLE PF := fun a b => inferInstanceAs (Decidable (b.n = PF.f a.n))
instance : DecidableLT PF := fun a b => inferInstanceAs (Decidable (b.n = PF.f a.n))
instance : LawfulUpwardEnumerableLE PF where
  le_iff a b := by
    constructor
    · intro h; refine ⟨0, ?_⟩; obtain ⟨m⟩ := b; change m = PF.f a.n at h; subst h; rfl
    · rintro ⟨k, h⟩; change (if k ≤ 1 then some (PF.mk _) else none) = some b at h
      split at h
      · cases h; rfl
      · cases h
instance : LawfulUpwardEnumerableLT PF where
  lt_iff a b := by
    constructor
    · intro h; refine ⟨0, ?_⟩; obtain ⟨m⟩ := b; change m = PF.f a.n at h; subst h; rfl
    · rintro ⟨k, h⟩; change (if k + 1 ≤ 1 then some (PF.mk _) else none) = some b at h
      split at h
      · cases h; rfl
      · cases h
instance : Rxc.IsAlwaysFinite PF := ⟨fun _ _ => ⟨2, trivial⟩⟩
instance : Rxo.IsAlwaysFinite PF := ⟨fun _ _ => ⟨2, trivial⟩⟩
theorem PF.not_lt01 : ¬ UpwardEnumerable.LT (PF.mk 0) (PF.mk 1) := fun ⟨k, h⟩ => by
  change (if k + 1 ≤ 1 then some (PF.mk _) else none) = some _ at h
  split at h
  · simp [PF.f] at h
  · cases h
/-- The lawful twin of `PF`'s successor. -/
def PF.ueL : UpwardEnumerable PF := { succ? := PF.next, succMany? := fun k a => some ⟨a.n + k⟩ }
theorem PF.lawL : @LawfulUpwardEnumerable PF PF.ueL :=
  @LawfulUpwardEnumerable.mk PF PF.ueL
    (fun a b ⟨k, h⟩ e => by
      subst e; cases a; change some (PF.mk _) = some (PF.mk _) at h
      simp only [Option.some.injEq, PF.mk.injEq] at h; omega)
    (fun _ => rfl)
    (fun n a => by
      change some (PF.mk _) = some (PF.mk _); simp only [Option.some.injEq, PF.mk.injEq]; omega)
instance PF.finC : Iterators.Finite (Rxc.Iterator PF) Id :=
  @Rxc.Iterator.instFinite PF PF.ueL _ _ PF.lawL
    (@Rxc.IsAlwaysFinite.mk PF PF.ueL _ fun i hi => ⟨hi.n + 2, by
      change ¬ (hi.n = PF.f (i.n + (hi.n + 2))); unfold PF.f; split <;> omega⟩)
instance PF.finO : Iterators.Finite (Rxo.Iterator PF) Id :=
  @Rxo.Iterator.instFinite PF PF.ueL _ _ PF.lawL
    (@Rxo.IsAlwaysFinite.mk PF PF.ueL _ fun i hi => ⟨hi.n + 2, by
      change ¬ (hi.n = PF.f (i.n + (hi.n + 2))); unfold PF.f; split <;> omega⟩)

/-- `T2b`: two elements `false → true` as `T2`, but `succMany?` constantly `none` (not lawful,
`Rxi.IsAlwaysFinite` at step `0`); its `Rxi` iterator is finite (lawful twin `T2`-style). -/
structure T2b where
  b : Bool
deriving DecidableEq
def T2b.next (a : T2b) : Option T2b := if a.b then none else some ⟨true⟩
instance : UpwardEnumerable T2b := { succ? := T2b.next, succMany? := fun _ _ => none }
instance : Rxi.IsAlwaysFinite T2b := ⟨fun _ => ⟨0, rfl⟩⟩
def T2b.ueL : UpwardEnumerable T2b := { succ? := T2b.next }
theorem T2b.succMany?_add_two (n : Nat) (a : T2b) : @succMany? T2b T2b.ueL (n + 2) a = none := by
  induction n with
  | zero => obtain ⟨_ | _⟩ := a <;> rfl
  | succ n ih => show (@succMany? T2b T2b.ueL (n + 2) a).bind T2b.next = none; rw [ih]; rfl
theorem T2b.lawL : @LawfulUpwardEnumerable T2b T2b.ueL :=
  @LawfulUpwardEnumerable.mk T2b T2b.ueL
    (fun a b ⟨k, h⟩ e => by
      subst e
      rcases k with _ | k
      · obtain ⟨_ | _⟩ := a <;> cases h
      · rw [T2b.succMany?_add_two] at h; cases h)
    (fun _ => rfl) (fun _ _ => rfl)
instance T2b.finI : Iterators.Finite (Rxi.Iterator T2b) Id :=
  @Rxi.Iterator.instFinite T2b T2b.ueL T2b.lawL
    (@Rxi.IsAlwaysFinite.mk T2b T2b.ueL fun a => ⟨2, T2b.succMany?_add_two 0 a⟩)

/-- `NSh2`: `Nat`, `succ? n = n + 1` (infinite, injective), `succMany? 0 n = n`,
`succMany? (k+1) n = n + k + 2` (not lawful); `a ≤ b` is `b = a ∨ a + 2 ≤ b`, `a < b` is
`a + 2 ≤ b` (`LawfulUpwardEnumerableLE/LT`, `Rxc/Rxo.IsAlwaysFinite`); iterators finite by the
lawful twin. -/
structure NSh2 where
  n : Nat
deriving DecidableEq
def NSh2.next (a : NSh2) : Option NSh2 := some ⟨a.n + 1⟩
def NSh2.many (k : Nat) (a : NSh2) : Option NSh2 := some ⟨if k = 0 then a.n else a.n + k + 1⟩
instance : UpwardEnumerable NSh2 := { succ? := NSh2.next, succMany? := NSh2.many }
instance : InfinitelyUpwardEnumerable NSh2 := ⟨fun _ => rfl⟩
instance : LinearlyUpwardEnumerable NSh2 := ⟨fun a b h => by
  cases a; cases b; simp only [succ?, NSh2.next, Option.some.injEq, NSh2.mk.injEq] at h ⊢; omega⟩
instance : LE NSh2 := ⟨fun a b => b.n = a.n ∨ a.n + 2 ≤ b.n⟩
instance : LT NSh2 := ⟨fun a b => a.n + 2 ≤ b.n⟩
instance : DecidableLE NSh2 := fun a b => inferInstanceAs (Decidable (b.n = a.n ∨ a.n + 2 ≤ b.n))
instance : DecidableLT NSh2 := fun a b => inferInstanceAs (Decidable (a.n + 2 ≤ b.n))
instance : LawfulUpwardEnumerableLE NSh2 where
  le_iff a b := by
    obtain ⟨p⟩ := a; obtain ⟨m⟩ := b
    show (m = p ∨ p + 2 ≤ m) ↔ ∃ k, some (NSh2.mk (if k = 0 then p else p + k + 1)) = some ⟨m⟩
    simp only [Option.some.injEq, NSh2.mk.injEq]
    constructor
    · rintro (h | h)
      · exact ⟨0, by simp [h]⟩
      · exact ⟨m - p - 1, by rw [if_neg (by omega)]; omega⟩
    · rintro ⟨k, hk⟩; split at hk <;> omega
instance : LawfulUpwardEnumerableLT NSh2 where
  lt_iff a b := by
    obtain ⟨p⟩ := a; obtain ⟨m⟩ := b
    show p + 2 ≤ m ↔ ∃ k, some (NSh2.mk (if k + 1 = 0 then p else p + (k + 1) + 1)) = some ⟨m⟩
    simp only [Option.some.injEq, NSh2.mk.injEq, Nat.add_one_ne_zero, if_false]
    constructor
    · intro h; exact ⟨m - p - 2, by omega⟩
    · rintro ⟨k, hk⟩; omega
instance : Rxc.IsAlwaysFinite NSh2 := ⟨fun i hi => ⟨hi.n + 1, by
  obtain ⟨p⟩ := i; obtain ⟨m⟩ := hi
  show ¬ (m = (if m + 1 = 0 then p else p + (m + 1) + 1) ∨ (if m + 1 = 0 then p else p + (m + 1) + 1) + 2 ≤ m)
  rw [if_neg (by omega)]; omega⟩⟩
instance : Rxo.IsAlwaysFinite NSh2 := ⟨fun i hi => ⟨hi.n + 1, by
  obtain ⟨p⟩ := i; obtain ⟨m⟩ := hi
  show ¬ ((if m + 1 = 0 then p else p + (m + 1) + 1) + 2 ≤ m)
  rw [if_neg (by omega)]; omega⟩⟩
def NSh2.ueL : UpwardEnumerable NSh2 := { succ? := NSh2.next, succMany? := fun k a => some ⟨a.n + k⟩ }
theorem NSh2.lawL : @LawfulUpwardEnumerable NSh2 NSh2.ueL :=
  @LawfulUpwardEnumerable.mk NSh2 NSh2.ueL
    (fun a b ⟨k, h⟩ e => by
      subst e; cases a; change some (NSh2.mk _) = some (NSh2.mk _) at h
      simp only [Option.some.injEq, NSh2.mk.injEq] at h; omega)
    (fun _ => rfl)
    (fun n a => by
      change some (NSh2.mk _) = some (NSh2.mk _); simp only [Option.some.injEq, NSh2.mk.injEq]; omega)
instance NSh2.finC : Iterators.Finite (Rxc.Iterator NSh2) Id :=
  @Rxc.Iterator.instFinite NSh2 NSh2.ueL _ _ NSh2.lawL
    (@Rxc.IsAlwaysFinite.mk NSh2 NSh2.ueL _ fun i hi => ⟨hi.n + 2, by show ¬ (_ ∨ _); dsimp only; omega⟩)
instance NSh2.finO : Iterators.Finite (Rxo.Iterator NSh2) Id :=
  @Rxo.Iterator.instFinite NSh2 NSh2.ueL _ _ NSh2.lawL
    (@Rxo.IsAlwaysFinite.mk NSh2 NSh2.ueL _ fun i hi => ⟨hi.n + 2, by show ¬ (_ + 2 ≤ _); dsimp only; omega⟩)

/-- `NW2`: like `NW` (`succ? 0 = 3`, `succ? n = n + 1` otherwise; lawful, infinite, not
injective), with `≤`/`<` the reachability relations (`LawfulUpwardEnumerableLE/LT`,
`Rxc/Rxo.IsAlwaysFinite`). -/
structure NW2 where
  n : Nat
deriving DecidableEq
def NW2.nx (n : Nat) : Nat := if n = 0 then 3 else n + 1
def NW2.next (a : NW2) : Option NW2 := some ⟨NW2.nx a.n⟩
def NW2.reach (k n : Nat) : Nat := if k = 0 then n else if n = 0 then k + 2 else n + k
instance : UpwardEnumerable NW2 := { succ? := NW2.next }
theorem NW2.nx_reach (k n : Nat) : NW2.nx (NW2.reach k n) = NW2.reach (k + 1) n := by
  unfold NW2.nx NW2.reach
  by_cases hk : k = 0 <;> by_cases hn : n = 0 <;> simp [hk, hn] <;> omega
theorem NW2.succMany?_eq (k : Nat) (a : NW2) : succMany? k a = some ⟨NW2.reach k a.n⟩ := by
  induction k with
  | zero => rfl
  | succ k ih =>
    show (succMany? k a).bind NW2.next = _
    rw [ih]; show some (NW2.mk (NW2.nx _)) = _; rw [NW2.nx_reach]
theorem NW2.reach_ge (k n : Nat) (hk : k ≠ 0) : n < NW2.reach k n := by
  unfold NW2.reach; rw [if_neg hk]; split <;> omega
instance : LawfulUpwardEnumerable NW2 where
  ne_of_lt a b := fun ⟨k, h⟩ e => by
    subst e; obtain ⟨p⟩ := a; rw [NW2.succMany?_eq] at h
    have := NW2.reach_ge (k + 1) p (by omega)
    simp only [Option.some.injEq, NW2.mk.injEq] at h; omega
  succMany?_zero _ := rfl
  succMany?_add_one _ _ := rfl
instance : InfinitelyUpwardEnumerable NW2 := ⟨fun _ => rfl⟩
def NW2.R (p m : Nat) : Prop := (p = 0 ∧ 3 ≤ m) ∨ (0 < p ∧ p < m)
instance : LE NW2 := ⟨fun a b => b.n = a.n ∨ NW2.R a.n b.n⟩
instance : LT NW2 := ⟨fun a b => NW2.R a.n b.n⟩
instance : DecidableLE NW2 := fun a b =>
  inferInstanceAs (Decidable (b.n = a.n ∨ (a.n = 0 ∧ 3 ≤ b.n) ∨ (0 < a.n ∧ a.n < b.n)))
instance : DecidableLT NW2 := fun a b =>
  inferInstanceAs (Decidable ((a.n = 0 ∧ 3 ≤ b.n) ∨ (0 < a.n ∧ a.n < b.n)))
theorem NW2.reach_iff (p m : Nat) : (∃ k, NW2.reach (k + 1) p = m) ↔ NW2.R p m := by
  unfold NW2.reach NW2.R
  constructor
  · rintro ⟨k, hk⟩; simp only [Nat.add_one_ne_zero, if_false] at hk; split at hk <;> omega
  · intro h
    by_cases hp : p = 0
    · exact ⟨m - 3, by simp only [Nat.add_one_ne_zero, if_false, hp, if_true]; omega⟩
    · exact ⟨m - p - 1, by simp only [Nat.add_one_ne_zero, if_false, hp]; omega⟩
instance : LawfulUpwardEnumerableLT NW2 where
  lt_iff a b := by
    obtain ⟨p⟩ := a; obtain ⟨m⟩ := b
    show NW2.R p m ↔ ∃ k, succMany? (k + 1) (NW2.mk p) = some ⟨m⟩
    simp only [NW2.succMany?_eq, Option.some.injEq, NW2.mk.injEq]
    exact (NW2.reach_iff p m).symm
instance : LawfulUpwardEnumerableLE NW2 where
  le_iff a b := by
    obtain ⟨p⟩ := a; obtain ⟨m⟩ := b
    show (m = p ∨ NW2.R p m) ↔ ∃ k, succMany? k (NW2.mk p) = some ⟨m⟩
    simp only [NW2.succMany?_eq, Option.some.injEq, NW2.mk.injEq]
    rw [← NW2.reach_iff]
    constructor
    · rintro (h | ⟨k, hk⟩)
      · exact ⟨0, h.symm⟩
      · exact ⟨k + 1, hk⟩
    · rintro ⟨_ | k, hk⟩
      · exact Or.inl hk.symm
      · exact Or.inr ⟨k, hk⟩
theorem NW2.reach_ge_k (k n : Nat) (hk : k ≠ 0) : k ≤ NW2.reach k n := by
  unfold NW2.reach; rw [if_neg hk]; split <;> omega
instance : Rxc.IsAlwaysFinite NW2 := ⟨fun i hi => ⟨hi.n + 3, by
  obtain ⟨p⟩ := i; obtain ⟨m⟩ := hi
  rw [NW2.succMany?_eq]; show ¬ (m = NW2.reach (m + 3) p ∨ NW2.R (NW2.reach (m + 3) p) m)
  have := NW2.reach_ge_k (m + 3) p (by omega)
  generalize NW2.reach (m + 3) p = x at *; unfold NW2.R; omega⟩⟩
instance : Rxo.IsAlwaysFinite NW2 := ⟨fun i hi => ⟨hi.n + 3, by
  obtain ⟨p⟩ := i; obtain ⟨m⟩ := hi
  rw [NW2.succMany?_eq]; show ¬ NW2.R (NW2.reach (m + 3) p) m
  have := NW2.reach_ge_k (m + 3) p (by omega)
  generalize NW2.reach (m + 3) p = x at *; unfold NW2.R; omega⟩⟩


/-! ## Verdicts -/

-- `Std.PRange.UpwardEnumerable.ext` (hypothesis 3): necessary, two UpwardEnumerable Unit instances with the same succMany? (some a) and different succ? (none vs some).
theorem v0 : ¬ drop0% Std.PRange.UpwardEnumerable.ext 3 := fun h => by
  have := congrArg (fun u => @succ? Unit u ()) (@h Unit ⟨fun _ => none, fun _ a => some a⟩ ⟨fun a => some a, fun _ a => some a⟩ rfl)
  simp at this

-- `Std.PRange.UpwardEnumerable.ext` (hypothesis 4): necessary, two UpwardEnumerable Unit instances with the same succ? (none) and different succMany? (none vs some a).
theorem v1 : ¬ drop0% Std.PRange.UpwardEnumerable.ext 4 := fun h => by
  have := congrArg (fun u => @succMany? Unit u 0 ()) (@h Unit ⟨fun _ => none, fun _ _ => none⟩ ⟨fun _ => none, fun _ a => some a⟩ rfl)
  simp at this

-- `Std.PRange.UpwardEnumerable.le_of_lt` (hypothesis 4): necessary, T2 (false → true): ¬ LE true false.
