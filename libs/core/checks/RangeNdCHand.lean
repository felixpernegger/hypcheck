/-! ### Nat-like models with a lawful successor and various `≤`/`<` -/

/-- `NS`: `Nat` with `succ? n = n + 1`, `succMany? k n = n + k` (lawful, infinite, injective);
`≤`, `<` are Nat's (all laws). -/
structure NS where
  n : Nat
deriving DecidableEq
instance : UpwardEnumerable NS :=
  { succ? := fun a => some ⟨a.n + 1⟩, succMany? := fun k a => some ⟨a.n + k⟩ }
instance : LawfulUpwardEnumerable NS where
  ne_of_lt a b := fun ⟨k, h⟩ e => by
    subst e; cases a; change some (NS.mk _) = some (NS.mk _) at h; simp only [Option.some.injEq, NS.mk.injEq] at h; omega
  succMany?_zero _ := rfl
  succMany?_add_one n a := by
    change some (NS.mk _) = some (NS.mk _); simp only [Option.some.injEq, NS.mk.injEq]; omega
instance : InfinitelyUpwardEnumerable NS := ⟨fun _ => rfl⟩
instance : LinearlyUpwardEnumerable NS := ⟨fun a b h => by
  cases a; cases b; simp only [succ?, Option.some.injEq, NS.mk.injEq] at h ⊢; omega⟩
theorem NS.ueLE_iff {a b : NS} : UpwardEnumerable.LE a b ↔ a.n ≤ b.n := by
  constructor
  · rintro ⟨k, h⟩; change some (NS.mk _) = some b at h; cases h; dsimp only; omega
  · intro h; refine ⟨b.n - a.n, ?_⟩; change some (NS.mk _) = some b
    congr; cases b; dsimp only at h ⊢; congr 1; omega
theorem NS.ueLT_iff {a b : NS} : UpwardEnumerable.LT a b ↔ a.n < b.n := by
  constructor
  · rintro ⟨k, h⟩; change some (NS.mk _) = some b at h; cases h; dsimp only; omega
  · intro h; refine ⟨b.n - a.n - 1, ?_⟩; change some (NS.mk _) = some b
    congr; cases b; dsimp only at h ⊢; congr 1; omega
instance : LE NS := ⟨fun a b => a.n ≤ b.n⟩
instance : LT NS := ⟨fun a b => a.n < b.n⟩
instance : DecidableLE NS := fun a b => inferInstanceAs (Decidable (a.n ≤ b.n))
instance : DecidableLT NS := fun a b => inferInstanceAs (Decidable (a.n < b.n))

instance : LawfulUpwardEnumerableLE NS := ⟨fun _ _ => NS.ueLE_iff.symm⟩
instance : LawfulUpwardEnumerableLT NS := ⟨fun _ _ => NS.ueLT_iff.symm⟩
instance : LawfulOrderLT NS := ⟨fun a b => by show a.n < b.n ↔ a.n ≤ b.n ∧ ¬ b.n ≤ a.n; omega⟩
instance : IsPartialOrder NS where
  le_refl a := Nat.le_refl a.n
  le_trans _ _ _ h1 h2 := Nat.le_trans h1 h2
  le_antisymm a b h1 h2 := by cases a; cases b; show _ = _; congr; exact Nat.le_antisymm h1 h2

