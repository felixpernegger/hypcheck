theorem rxcLF0 : @Rxc.LawfulHasSize Unit leF ueN (rxcSz 0) :=
  @Rxc.LawfulHasSize.mk Unit leF ueN (rxcSz 0) (fun _ _ _ => rfl) (fun _ _ h _ => h.elim)
    (fun _ _ _ h _ => h.elim)
