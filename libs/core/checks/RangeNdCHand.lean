-- Rxc finiteness from Rxi finiteness (copied from RangeDepBHand).
theorem rxc_of_rxi {α : Type u} [UpwardEnumerable α] [LE α] [Rxi.IsAlwaysFinite α] :
    Rxc.IsAlwaysFinite α where
  finite init hi := by
    obtain ⟨n, hn⟩ := Rxi.IsAlwaysFinite.finite init; exact ⟨n, by simp [hn]⟩

-- Rxo finiteness from Rxi finiteness.
theorem rxo_of_rxi {α : Type u} [UpwardEnumerable α] [LT α] [Rxi.IsAlwaysFinite α] :
    Rxo.IsAlwaysFinite α where
  finite init hi := by
    obtain ⟨n, hn⟩ := Rxi.IsAlwaysFinite.finite init; exact ⟨n, by simp [hn]⟩

/-! ## Models

One-point models (`succ?` always `some pt`, broken `succMany?`): -/

/-- `M0`: `succMany?` constantly `none`, so `UpwardEnumerable.LE`/`LT` never hold. -/
inductive M0 | pt deriving DecidableEq
instance : UpwardEnumerable M0 := { succ? := fun a => some a, succMany? := fun _ _ => none }
instance : InfinitelyUpwardEnumerable M0 := ⟨fun _ => rfl⟩
instance : LinearlyUpwardEnumerable M0 := ⟨fun .pt .pt _ => rfl⟩
theorem M0.not_le {a b : M0} : ¬ UpwardEnumerable.LE a b := fun ⟨_, h⟩ => nomatch h
theorem M0.not_lt {a b : M0} : ¬ UpwardEnumerable.LT a b := fun ⟨_, h⟩ => nomatch h

/-- `U1`: `succMany? n = none` for `n > 0` although `succ? = some`. -/
inductive U1 | pt deriving DecidableEq
instance : UpwardEnumerable U1 :=
  { succ? := fun a => some a, succMany? := fun n a => if n = 0 then some a else none }

/-- `U2`: `succMany? n = some` for `n ≤ 1`, `none` above (not additive). -/
inductive U2 | pt deriving DecidableEq
instance : UpwardEnumerable U2 :=
  { succ? := fun a => some a, succMany? := fun n a => if n ≤ 1 then some a else none }

/-- `Cyc1`: `succMany?` constantly `some pt` (satisfies the `succMany?` laws, but `pt < pt`). -/
inductive Cyc1 | pt deriving DecidableEq
instance : UpwardEnumerable Cyc1 := { succ? := fun a => some a, succMany? := fun _ a => some a }
theorem Cyc1.le {a b : Cyc1} : UpwardEnumerable.LE a b := by cases a; cases b; exact ⟨0, rfl⟩
theorem Cyc1.lt {a b : Cyc1} : UpwardEnumerable.LT a b := by cases a; cases b; exact ⟨0, rfl⟩
instance Cyc1.instLE : LE Cyc1 := ⟨fun _ _ => True⟩
instance Cyc1.instLT : LT Cyc1 := ⟨fun _ _ => True⟩
instance : LawfulUpwardEnumerableLE Cyc1 := ⟨fun _ _ => ⟨fun _ => Cyc1.le, fun _ => trivial⟩⟩
instance : LawfulUpwardEnumerableLT Cyc1 := ⟨fun _ _ => ⟨fun _ => Cyc1.lt, fun _ => trivial⟩⟩
theorem Cyc1.not_lue : ¬ LawfulUpwardEnumerable Cyc1 := fun h => h.ne_of_lt .pt .pt Cyc1.lt rfl

/-- `Tri`: `succMany? 1` maps `a ↦ b ↦ c`, everything else is `none` (not transitive). -/
inductive Tri | a | b | c deriving DecidableEq
def Tri.next : Tri → Option Tri | .a => some .b | .b => some .c | .c => none
instance : UpwardEnumerable Tri :=
  { succ? := fun _ => none, succMany? := fun n x => if n = 1 then x.next else none }
theorem Tri.le_ab : UpwardEnumerable.LE Tri.a Tri.b := ⟨1, rfl⟩
theorem Tri.le_bc : UpwardEnumerable.LE Tri.b Tri.c := ⟨1, rfl⟩
theorem Tri.lt_ab : UpwardEnumerable.LT Tri.a Tri.b := ⟨0, rfl⟩
theorem Tri.lt_bc : UpwardEnumerable.LT Tri.b Tri.c := ⟨0, rfl⟩
theorem Tri.not_le_ac : ¬ UpwardEnumerable.LE Tri.a Tri.c := fun ⟨n, h⟩ => by
  change (if n = 1 then some Tri.b else none) = some Tri.c at h; split at h <;> simp at h
theorem Tri.not_lt_ac : ¬ UpwardEnumerable.LT Tri.a Tri.c := fun ⟨n, h⟩ => Tri.not_le_ac ⟨_, h⟩

/-- `Swap`: two points, `succMany? 0` swaps them, `succMany? (n+1) = none`. -/
inductive Swap | p | q deriving DecidableEq
def Swap.other : Swap → Swap | .p => .q | .q => .p
instance : UpwardEnumerable Swap :=
  { succ? := fun _ => none, succMany? := fun n x => if n = 0 then some x.other else none }
theorem Swap.le_pq : UpwardEnumerable.LE Swap.p Swap.q := ⟨0, rfl⟩
theorem Swap.not_lt {x y : Swap} : ¬ UpwardEnumerable.LT x y := fun ⟨_, h⟩ => nomatch h

/-- `BConst`: `Bool` with `succ? _ = some true`: infinite, not injective. -/
structure BConst where
  b : Bool
deriving DecidableEq
instance : UpwardEnumerable BConst := { succ? := fun _ => some ⟨true⟩ }
instance : InfinitelyUpwardEnumerable BConst := ⟨fun _ => rfl⟩

/-- `Rho`: two points, `succ? _ = some p`, `succMany? (n+1) _ = some p`; `≤`: `a = b ∨ b = p`.
Total and `LawfulUpwardEnumerableLE`, not injective, not lawful (`p < p`). -/
inductive Rho | p | q deriving DecidableEq
instance : UpwardEnumerable Rho :=
  { succ? := fun _ => some .p, succMany? := fun n x => if n = 0 then some x else some .p }
instance : LE Rho := ⟨fun a b => a = b ∨ b = .p⟩
instance : Std.Total (α := Rho) (· ≤ ·) := ⟨fun a b => by cases a <;> cases b <;> simp [LE.le]⟩
instance : LawfulUpwardEnumerableLE Rho where
  le_iff a b := by
    constructor
    · rintro (h | h)
      · exact ⟨0, by rw [h]; rfl⟩
      · exact ⟨1, by rw [h]; rfl⟩
    · rintro ⟨n, h⟩
      change (if n = 0 then some a else some Rho.p) = some b at h
      split at h <;> simp at h <;> simp [h, LE.le]

/-- `V`: three points, `l ↦ top`, `r ↦ top`, `top ↦ none` (default `succMany?`): lawful, not
injective; `≤` is reachability. -/
inductive V | l | r | top deriving DecidableEq
instance : UpwardEnumerable V where
  succ? x := match x with | .l => some .top | .r => some .top | .top => none
theorem V.succMany?_add_two (n : Nat) (a : V) : succMany? (n + 2) a = none := by
  induction n with
  | zero => cases a <;> rfl
  | succ n ih => show (succMany? (n + 2) a).bind succ? = none; rw [ih]; rfl
theorem V.ueLE_iff {a b : V} : UpwardEnumerable.LE a b ↔ (a = b ∨ succ? a = some b) := by
  constructor
  · rintro ⟨_ | _ | n, h⟩
    · exact Or.inl (Option.some.inj h)
    · exact Or.inr h
    · rw [V.succMany?_add_two] at h; cases h
  · rintro (h | h)
    · exact ⟨0, by rw [h]; rfl⟩
    · exact ⟨1, h⟩
theorem V.ueLT_iff {a b : V} : UpwardEnumerable.LT a b ↔ succ? a = some b := by
  constructor
  · rintro ⟨_ | n, h⟩
    · exact h
    · rw [V.succMany?_add_two] at h; cases h
  · intro h; exact ⟨0, h⟩
instance : LawfulUpwardEnumerable V where
  ne_of_lt a b h := by rw [V.ueLT_iff] at h; intro e; subst e; cases a <;> cases h
  succMany?_zero _ := rfl
  succMany?_add_one _ _ := rfl
instance : LE V := ⟨fun a b => a = b ∨ succ? a = some b⟩
instance : LawfulUpwardEnumerableLE V := ⟨fun _ _ => V.ueLE_iff.symm⟩
theorem V.not_lin : ¬ LinearlyUpwardEnumerable V := fun h =>
  nomatch h.eq_of_succ?_eq V.l V.r rfl

/-- `NB`: `Nat`, `succ? n = n + 1` (infinite, injective), but `succMany? k n = some k` only for
`n = 0`, `k > 0`. -/
structure NB where
  n : Nat
deriving DecidableEq
instance : UpwardEnumerable NB :=
  { succ? := fun a => some ⟨a.n + 1⟩,
    succMany? := fun k a => if a.n = 0 ∧ 0 < k then some ⟨k⟩ else none }
instance : InfinitelyUpwardEnumerable NB := ⟨fun _ => rfl⟩
instance : LinearlyUpwardEnumerable NB := ⟨fun a b h => by
  cases a; cases b; simp only [succ?, Option.some.injEq, NB.mk.injEq] at h ⊢; omega⟩
theorem NB.le_iff {a b : NB} : UpwardEnumerable.LE a b ↔ (a.n = 0 ∧ 0 < b.n) := by
  constructor
  · rintro ⟨k, h⟩
    change (if a.n = 0 ∧ 0 < k then some (NB.mk k) else none) = some b at h
    split at h
    · cases h; assumption
    · cases h
  · rintro ⟨h1, h2⟩
    exact ⟨b.n, by change (if a.n = 0 ∧ 0 < b.n then some (NB.mk b.n) else none) = some b; simp [h1, h2]⟩
theorem NB.lt_iff {a b : NB} : UpwardEnumerable.LT a b ↔ (a.n = 0 ∧ 0 < b.n) := by
  constructor
  · rintro ⟨k, h⟩; exact NB.le_iff.1 ⟨_, h⟩
  · rintro ⟨h1, h2⟩
    refine ⟨b.n - 1, ?_⟩
    change (if a.n = 0 ∧ 0 < b.n - 1 + 1 then some (NB.mk (b.n - 1 + 1)) else none) = some b
    rw [if_pos ⟨h1, by omega⟩, Nat.sub_add_cancel h2]
theorem NB.succ_eq (a : NB) : succ a = ⟨a.n + 1⟩ := rfl

/-- `NZ`: `Nat`, `succ? n = n + 1`, `succMany? k n = some (n + k)` except `none` from `0`. -/
structure NZ where
  n : Nat
deriving DecidableEq
instance : UpwardEnumerable NZ :=
  { succ? := fun a => some ⟨a.n + 1⟩,
    succMany? := fun k a => if a.n = 0 then none else some ⟨a.n + k⟩ }
instance : InfinitelyUpwardEnumerable NZ := ⟨fun _ => rfl⟩
theorem NZ.not_le0 {b : NZ} : ¬ UpwardEnumerable.LE ⟨0⟩ b := fun ⟨_, h⟩ => nomatch h
theorem NZ.not_lt0 {b : NZ} : ¬ UpwardEnumerable.LT ⟨0⟩ b := fun ⟨_, h⟩ => nomatch h

/-- `NW`: `Nat`, `succ? 0 = 3`, `succ? n = n + 1` otherwise (default `succMany?`): lawful,
infinite, not injective (`0` and `2` both go to `3`). -/
structure NW where
  n : Nat
deriving DecidableEq
instance : UpwardEnumerable NW where
  succ? a := some ⟨if a.n = 0 then 3 else a.n + 1⟩
theorem NW.succMany?_mono : ∀ (k : Nat) (a b : NW), succMany? k a = some b → a.n + k ≤ b.n
  | 0, a, b, h => by cases h; simp
  | k + 1, a, b, h => by
    change (succMany? k a).bind succ? = some b at h
    cases hk : succMany? k a with
    | none => rw [hk] at h; cases h
    | some c =>
      rw [hk] at h
      have := NW.succMany?_mono k a c hk
      change some (NW.mk _) = some b at h; cases h; dsimp only; split <;> omega
instance : LawfulUpwardEnumerable NW where
  ne_of_lt a b := fun ⟨k, h⟩ e => by have := NW.succMany?_mono _ _ _ h; subst e; omega
  succMany?_zero _ := rfl
  succMany?_add_one _ _ := rfl
instance : InfinitelyUpwardEnumerable NW := ⟨fun _ => rfl⟩
theorem NW.not_le {a b : NW} (h : b.n < a.n) : ¬ UpwardEnumerable.LE a b := fun ⟨k, hk⟩ => by
  have := NW.succMany?_mono _ _ _ hk; omega
theorem NW.not_lt {a b : NW} (h : b.n < a.n) : ¬ UpwardEnumerable.LT a b := fun ⟨k, hk⟩ => by
  have := NW.succMany?_mono _ _ _ hk; omega
theorem NW.le23 : UpwardEnumerable.LE (NW.mk 2) (NW.mk 3) := ⟨1, rfl⟩
theorem NW.lt23 : UpwardEnumerable.LT (NW.mk 2) (NW.mk 3) := ⟨0, rfl⟩

/-- `NoLeast`: one point with `least? = none`. -/
inductive NoLeast | pt deriving DecidableEq
instance : UpwardEnumerable NoLeast := { succ? := fun _ => none }
instance : Least? NoLeast := ⟨none⟩

/-- `EmptyM`: an empty type with `least? = none` (all laws hold vacuously). -/
structure EmptyM where
  e : Empty
instance : UpwardEnumerable EmptyM := ⟨fun a => a.e.elim, fun _ a => a.e.elim⟩
instance : Least? EmptyM := ⟨none⟩
instance : LawfulUpwardEnumerableLeast? EmptyM := ⟨fun a => a.e.elim⟩


/-! ### `T2`: two elements `⟨false⟩ → ⟨true⟩`, all lawful except `InfinitelyUpwardEnumerable` -/

structure T2 where
  b : Bool
deriving DecidableEq

instance : UpwardEnumerable T2 where
  succ? a := if a.b then none else some ⟨true⟩

theorem T2.succMany?_add_two (n : Nat) (a : T2) : succMany? (n + 2) a = none := by
  induction n with
  | zero => obtain ⟨_ | _⟩ := a <;> rfl
  | succ n ih => show (succMany? (n + 2) a).bind succ? = none; rw [ih]; rfl

theorem T2.ueLE_iff' {a b : T2} : UpwardEnumerable.LE a b ↔ (a = b ∨ succ? a = some b) := by
  constructor
  · rintro ⟨_ | _ | n, h⟩
    · exact Or.inl (Option.some.inj h)
    · exact Or.inr h
    · rw [T2.succMany?_add_two] at h; cases h
  · rintro (h | h)
    · exact ⟨0, by rw [h]; rfl⟩
    · exact ⟨1, h⟩

theorem T2.ueLE_iff {a b : T2} : UpwardEnumerable.LE a b ↔ (a.b = false ∨ b.b = true) := by
  rw [T2.ueLE_iff']; obtain ⟨_ | _⟩ := a <;> obtain ⟨_ | _⟩ := b <;> decide

theorem T2.ueLT_iff' {a b : T2} : UpwardEnumerable.LT a b ↔ succ? a = some b := by
  constructor
  · rintro ⟨_ | n, h⟩
    · exact h
    · rw [T2.succMany?_add_two] at h; cases h
  · intro h; exact ⟨0, h⟩

theorem T2.ueLT_iff {a b : T2} : UpwardEnumerable.LT a b ↔ (a.b = false ∧ b.b = true) := by
  rw [T2.ueLT_iff']; obtain ⟨_ | _⟩ := a <;> obtain ⟨_ | _⟩ := b <;> decide

instance : LawfulUpwardEnumerable T2 where
  ne_of_lt a b h := by rw [T2.ueLT_iff] at h; intro e; subst e; simp_all
  succMany?_zero _ := rfl
  succMany?_add_one _ _ := rfl

instance : Rxi.IsAlwaysFinite T2 := ⟨fun a => ⟨2, T2.succMany?_add_two 0 a⟩⟩

instance : LinearlyUpwardEnumerable T2 where
  eq_of_succ?_eq a b h := by
    obtain ⟨_ | _⟩ := a <;> obtain ⟨_ | _⟩ := b <;> first | rfl | cases h

instance : Rxi.HasSize T2 := ⟨fun a => if a.b then 1 else 2⟩

instance : Rxi.LawfulHasSize T2 where
  size_eq_one_of_succ?_eq_none lo h := by obtain ⟨_ | _⟩ := lo <;> first | rfl | cases h
  size_eq_succ_of_succ?_eq_some lo lo' h := by
    obtain ⟨_ | _⟩ := lo <;> cases h <;> rfl

theorem T2.not_inf : ¬ InfinitelyUpwardEnumerable T2 := fun h => by
  have := h.isSome_succ? ⟨true⟩; cases this

instance : LE T2 := ⟨fun a b => a.b = false ∨ b.b = true⟩
instance : LT T2 := ⟨fun a b => a.b = false ∧ b.b = true⟩
instance : DecidableLE T2 := fun a b => inferInstanceAs (Decidable (a.b = false ∨ b.b = true))
instance : DecidableLT T2 := fun a b => inferInstanceAs (Decidable (a.b = false ∧ b.b = true))
instance : Least? T2 := ⟨some ⟨false⟩⟩
instance : Rxc.IsAlwaysFinite T2 := rxc_of_rxi
instance : Rxo.IsAlwaysFinite T2 := rxo_of_rxi

instance : LawfulUpwardEnumerableLE T2 := ⟨fun a b => T2.ueLE_iff.symm⟩

instance : LawfulUpwardEnumerableLT T2 := ⟨fun a b => T2.ueLT_iff.symm⟩

instance : LawfulUpwardEnumerableLeast? T2 := ⟨fun a => ⟨⟨false⟩, rfl, T2.ueLE_iff.2 (Or.inl rfl)⟩⟩

/-! ### `T2lt`: as `T2`, but `<` is always false (not `LawfulUpwardEnumerableLT`) -/

structure T2lt where
