-- ℤ-valued maps for the semiconjugacy row: zf n = n for n < 0, else 0; zb m = m + 1 for m < -1, else 0.
-- Then zf (n + 1) = zb (zf n), (· + 1) is bijective, but zb 0 = zb (-1) on range zf.
def zf (n : ℤ) : ℤ := if 0 ≤ n then 0 else n
def zb (m : ℤ) : ℤ := if m < -1 then m + 1 else 0
-- Bool ≃ {x : Bool // True}, for the extendDomain rows.
def bF : Bool ≃ {x : Bool // True} := (Equiv.subtypeUnivEquiv (fun _ => trivial)).symm

