import Lean
import Iris
/-!
Verdicts that follow from another theorem's stored verdict. Generated by `scripts/chain_proofs.py`;
do not edit by hand.

* `hc_nec_trans B j A i` adds `HypCheckChain.A.h<i> : A' → B'` (`A'` is `A` without binder `i`,
  at the universe levels that `B`'s proof uses; `B'` is `B` without binder `j`). The proof is the
  library's proof term of `B` with every call `A … h_j …` replaced by `hA …` (binder `i` dropped);
  it fails if `h_j` still occurs afterwards. Together with `B`'s stored `¬B'` this proves `¬A'`
  (a counterexample at one universe level refutes the universe-polymorphic `A'`).
  `hc_nec_trans B j A i (R k)…` also replaces the calls to removable targets `R` (binder `k` fed
  by `h_j`) by premises `R'`, giving `A' → R' → … → B'`; `R`'s stored proof of `R'` discharges them.
* `hc_twin T S i` adds `HypCheckChain.T.h<i> : T' ↔ S'` for theorems whose statements are equal up
  to binder and universe names, so `T`'s verdict at `i` is `S`'s.

The kernel checks each added declaration (`addDecl`).
-/

open Lean Elab Command Meta

/-- `n` without binder `i` (instantiated at `us`); fails for dependent binders. -/
def hcDropType (n : Name) (i : Nat) (us : List Level) : MetaM Expr := do
  let ci ← getConstInfo n
  forallTelescope (ci.type.instantiateLevelParams ci.levelParams us) fun xs body => do
    let some x := xs[i]? | throwError "{n} has no binder {i}"
    if body.containsFVar x.fvarId! then throwError "{n}: the statement depends on binder {i}"
    for y in xs.extract (i+1) xs.size do
      if (← inferType y).containsFVar x.fvarId! then throwError "{n}: binder {i} is dependent"
    mkForallFVars (xs.eraseIdxIfInBounds i) body

def hcAdd (name : Name) (lps : List Name) (ty pf : Expr) : MetaM Unit := do
  let ty ← instantiateMVars ty
  let pf ← instantiateMVars pf
  if or ty.hasMVar pf.hasMVar then throwError "metavariables left"
  addDecl (.thmDecl { name, levelParams := lps, type := ty, value := pf })

/-- Replace every call `C … y …` (argument `k` = `y`) in `pb` by `h …` (argument `k` dropped). -/
def hcReplaceCalls (pb : Expr) (C : Name) (k : Nat) (y h : Expr) (ls : List Level) : MetaM Expr :=
  Meta.transform pb (post := fun e => do
    if e.isAppOf C then
      let args := e.getAppArgs
      if hk : k < args.size then
        if args[k] == y then
          let .const _ ls' := e.getAppFn | return .continue
          unless ls' == ls do throwError "{C} is used at several universe levels"
          return .done (mkAppN h (args.eraseIdxIfInBounds k))
    return .continue)

/-- Universe levels at which `C` occurs in `pb`. -/
def hcLevels (pb : Expr) (C : Name) : MetaM (List Level) := do
  let some (.const _ ls) := pb.find? (·.isConstOf C)
    | throwError "{C} does not occur in the proof"
  return ls

/-- `hc_nec_trans B j A i (R k)*`: `A' → R₁' → … → B'`. The calls to the removable targets `R`
(their binder `k` fed by `h_j`) become premises `R'`, discharged by `R`'s stored proof of `R'`. -/
syntax hcRem := "(" ident num ")"

elab "hc_nec_trans " b:ident j:num a:ident i:num rs:hcRem* : command =>
    liftTermElabM do
  let B := b.getId; let A := a.getId; let j := j.getNat; let i := i.getNat
  let rems : Array (Name × Nat) := rs.map fun r => (r.raw[1].getId, r.raw[2].toNat)
  let ci ← getConstInfo B
  let some v := ci.value? (allowOpaque := true) | throwError "{B} has no proof term"
  forallTelescope ci.type fun xs body => lambdaBoundedTelescope v xs.size fun ys pb => do
    unless ys.size == xs.size do throwError "{B}: fewer lambdas than binders"
    let some y := ys[j]? | throwError "{B} has no binder {j}"
    let ls ← hcLevels pb A
    let tA ← hcDropType A i ls
    let remTys ← rems.mapM fun (R, k) => do hcDropType R k (← hcLevels pb R)
    withLocalDeclD `hA tA fun hA => do
    withLocalDeclsDND (remTys.mapIdx fun n t => (Name.mkSimple s!"hR{n}", t)) fun hRs => do
      let mut pb' ← hcReplaceCalls pb A i y hA ls
      for (R, k) in rems, hR in hRs do
        pb' ← hcReplaceCalls pb' R k y hR (← hcLevels pb R)
      if pb'.containsFVar y.fvarId! then throwError "binder {j} of {B} is still used"
      let rest := ys.eraseIdxIfInBounds j
      let tyB ← mkForallFVars rest (body.replaceFVars xs ys)
      let pf ← mkLambdaFVars (#[hA] ++ hRs) (← mkLambdaFVars rest pb')
      let ty ← mkForallFVars (#[hA] ++ hRs) tyB
      unless ← isDefEq (← inferType pf) ty do throwError "type mismatch"
      hcAdd ((`HypCheckChain ++ A).str s!"h{i}") ci.levelParams ty pf

elab "hc_twin " t:ident s:ident i:num : command => liftTermElabM do
  let T := t.getId; let S := s.getId; let i := i.getNat
  let ct ← getConstInfo T
  let cs ← getConstInfo S
  unless ct.levelParams.length == cs.levelParams.length do throwError "universe counts differ"
  let us := ct.levelParams.map mkLevelParam
  let tT ← hcDropType T i us
  let tS ← hcDropType S i us
  unless ← isDefEq tT tS do throwError "{T}' and {S}' differ"
  hcAdd ((`HypCheckChain ++ T).str s!"h{i}") ct.levelParams (mkApp2 (mkConst ``Iff) tT tS)
    (mkApp (mkConst ``Iff.refl) tT)


