# Claude Code session state
.claude/

# Build output
.lake/
*.olean
*.ilean
*.ir.sig
*.ir
__pycache__/
*.pyc

# Machine-specific caches, regenerated by scripts/hclean (kit workspaces) or the workspace's own wrapper
.leanpath
.leanbin

# Run outputs and logs: tools write to runs/; the core keeps nothing there
libs/core/runs/
# Rebuilt by scripts/recheck.py in the published workspaces
libs/*/runs/recheck/
libs/*/runs/remtrans/
libs/*/tools/hcrepair/
*.log

# Certificate build output, regenerated by libs/core/scripts/swapcheck.sh
libs/core/certs/.olean/

# Not part of the published repository; workspaces/ holds your own tool/hypcheck runs
workspaces/
bench/
