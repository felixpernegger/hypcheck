# hypcheck workspace configuration. Sourced by the shell scripts, parsed by scripts/hcconf.py.
# Plain KEY=VALUE lines only (no spaces around '=', no shell expansions).
# Name of the analysed library (used in docs and the memory slice name).
HC_NAME=@NAME@
# Lake project root of the analysed library (read-only for this work).
HC_LIBDIR=@LIBDIR@
# Root module(s) to import in tools, hand files and checks, comma-separated (e.g. Cslib or Mathlib).
HC_ROOT=@ROOT@
# Module prefixes in scope, comma-separated (e.g. Mathlib.Order,Mathlib.Data.Nat). Rows outside are dropped.
HC_MODULES=@MODULES@
# systemd slice shared by all agent/check Lean calls; the main session caps it.
HC_SLICE=hc-@NAME@.slice
# Kit commit this workspace was created from.
HC_KIT=@KIT@
